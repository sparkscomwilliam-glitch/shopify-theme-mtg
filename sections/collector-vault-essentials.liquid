{{ 'collector-vault-sections.css' | asset_url | stylesheet_tag }}

<section
  class="cv-section cv-product-section"
  style="--cv-bg: {{ section.settings.background }}; --cv-surface: {{ section.settings.surface }}; --cv-accent: {{ section.settings.accent }}; --cv-violet: {{ section.settings.secondary }}; --cv-hot: {{ section.settings.hot }};"
  aria-labelledby="CollectorVaultHeading-{{ section.id }}"
>
  <div class="cv-inner">
    {% render 'collector-vault-section-header',
      section_id: section.id,
      kicker: section.settings.kicker,
      title: section.settings.heading,
      description: section.settings.description,
      show_action: section.settings.show_action,
      action_label: section.settings.action_label,
      action_link: section.settings.action_link
    %}

    <div class="cv-product-grid">
      {% for block in section.blocks limit: 4 %}
        {% render 'collector-vault-product-card',
          product: block.settings.product,
          fallback_title: block.settings.fallback_title,
          fallback_price: block.settings.fallback_price,
          eyebrow: block.settings.eyebrow,
          chip_1: block.settings.chip_1,
          chip_2: block.settings.chip_2,
          highlight: block.settings.highlight,
          button_label: block.settings.button_label,
          section_id: section.id,
          card_index: forloop.index,
          block_attributes: block.shopify_attributes
        %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Vault — Essentiels",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Sur-titre", "default": "BEST SELLERS / CETTE SEMAINE" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Les choix de la communauté." },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Des essentiels souvent ajoutés au panier, du booster à la protection longue durée." },
    { "type": "checkbox", "id": "show_action", "label": "Afficher le bouton", "default": true },
    { "type": "text", "id": "action_label", "label": "Texte du bouton", "default": "Voir tous les produits" },
    { "type": "url", "id": "action_link", "label": "Lien du bouton" },
    { "type": "header", "content": "Couleurs" },
    { "type": "color", "id": "background", "label": "Fond", "default": "#0b0f14" },
    { "type": "color", "id": "surface", "label": "Surface des cartes", "default": "#151c24" },
    { "type": "color", "id": "accent", "label": "Accent principal", "default": "#26e6c5" },
    { "type": "color", "id": "secondary", "label": "Accent secondaire", "default": "#8b7cff" },
    { "type": "color", "id": "hot", "label": "Accent chaud", "default": "#ff6b4a" }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Produit",
      "limit": 4,
      "settings": [
        { "type": "product", "id": "product", "label": "Produit Shopify" },
        { "type": "text", "id": "fallback_title", "label": "Titre de secours", "default": "Stellar Load Booster" },
        { "type": "text", "id": "fallback_price", "label": "Prix de secours", "default": "CHF 7.90" },
        { "type": "text", "id": "eyebrow", "label": "Étiquette", "default": "BOOSTER / EN" },
        { "type": "text", "id": "chip_1", "label": "Badge 1", "default": "63 × 88 MM" },
        { "type": "text", "id": "chip_2", "label": "Badge 2", "default": "SLEEVED" },
        { "type": "checkbox", "id": "highlight", "label": "Mettre en évidence", "default": false },
        { "type": "text", "id": "button_label", "label": "Bouton", "default": "Ajouter au panier" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Vault — Essentiels",
      "blocks": [
        { "type": "product", "settings": { "fallback_title": "Stellar Load Booster", "fallback_price": "CHF 7.90", "eyebrow": "BOOSTER / EN" } },
        { "type": "product", "settings": { "fallback_title": "Eclipse Binder 480", "fallback_price": "CHF 59.90", "eyebrow": "BINDER / 480", "highlight": true } },
        { "type": "product", "settings": { "fallback_title": "Magnetic Holder", "fallback_price": "CHF 4.90", "eyebrow": "DISPLAY / 35PT" } },
        { "type": "product", "settings": { "fallback_title": "Deck Vault 100+", "fallback_price": "CHF 18.90", "eyebrow": "STORAGE / 100+" } }
      ]
    }
  ]
}
{% endschema %}
