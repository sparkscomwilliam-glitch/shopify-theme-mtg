          {%- else -%}
            <span class="ag-hero-zero__zone ag-hero-zero__zone--1">{{ d_zone1 }}</span>
          {%- endif -%}
        {%- endif -%}

        {%- if d_between != blank -%}
          {%- if d_zone1 != blank or d_before != blank %} {% endif -%}
          <span class="ag-hero-zero__title-part">{{ d_between }}</span>
        {%- endif -%}

        {%- if d_zone2 != blank -%}
          {%- if d_between != blank or d_zone1 != blank or d_before != blank %} {% endif -%}
          {%- if section.settings.z2_bg_enabled -%}
            <span class="ag-hero-zero__zone-bg ag-hero-zero__zone-bg--2"><span class="ag-hero-zero__zone-text ag-hero-zero__zone-text--2">{{ d_zone2 }}</span></span>
          {%- else -%}
            <span class="ag-hero-zero__zone ag-hero-zero__zone--2">{{ d_zone2 }}</span>
          {%- endif -%}
        {%- endif -%}

        {%- if d_after != blank -%}
          {%- if d_zone2 != blank or d_between != blank or d_zone1 != blank or d_before != blank %} {% endif -%}
          <span class="ag-hero-zero__title-part">{{ d_after }}</span>
        {%- endif -%}
