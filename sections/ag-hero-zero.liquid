{%- style -%}
  {{ section.settings.z1_font | font_face: font_display: 'swap' }}
  {{ section.settings.z2_font | font_face: font_display: 'swap' }}
  {{ section.settings.subtitle_font | font_face: font_display: 'swap' }}

  .ag-hero-zero-{{ section.id }} {
    /* ─── Layout ─── */
    --height-desktop:           {{ section.settings.height_desktop }}px;
    --height-mobile:            {{ section.settings.height_mobile }}px;
    --content-max-w:            {{ section.settings.content_max_width }}px;
    --content-align-h:          {{ section.settings.content_align_h }};
    --content-align-v:          {{ section.settings.content_align_v }};
    --content-align-v-mobile:   {{ section.settings.content_align_v_mobile }};
    --content-text-align:       {{ section.settings.content_text_align }};

    /* ─── PROMO Background ─── */
    --promo-bg-image-pos:  {{ section.settings.promo_bg_image_position }};
    --promo-bg-c1:         {{ section.settings.promo_bg_color_1 }};
    --promo-bg-c2:         {{ section.settings.promo_bg_color_2 }};
    --promo-bg-grad-dir:   {{ section.settings.promo_bg_gradient_dir }};

    /* ─── DEFAULT Background ─── */
    --default-bg-image-pos: {{ section.settings.default_bg_image_position }};
    --default-bg-c1:        {{ section.settings.default_bg_color_1 }};
    --default-bg-c2:        {{ section.settings.default_bg_color_2 }};
    --default-bg-grad-dir:  {{ section.settings.default_bg_gradient_dir }};

    /* ─── Overlay partagé ─── */
    --overlay-color:   {{ section.settings.overlay_color }};
    --overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};

    /* ─── Zone 1 ─── */
    --z1-font:           {{ section.settings.z1_font.family }}, {{ section.settings.z1_font.fallback_families }};
    --z1-font-weight:    {{ section.settings.z1_font.weight | default: 700 }};
    --z1-text-transform: {{ section.settings.z1_text_transform }};
    --z1-font-style:     {{ section.settings.z1_font_style }};
    --z1-fs-desktop:     {{ section.settings.z1_font_size_desktop }}px;
    --z1-fs-mobile:      {{ section.settings.z1_font_size_mobile }}px;
    --z1-tc1:            {{ section.settings.z1_text_color_1 }};
    --z1-tc2:            {{ section.settings.z1_text_color_2 }};
    --z1-tgrad-dir:      {{ section.settings.z1_text_gradient_dir }};
    --z1-bc1:            {{ section.settings.z1_bg_color_1 }};
    --z1-bc2:            {{ section.settings.z1_bg_color_2 }};
    --z1-bgrad-dir:      {{ section.settings.z1_bg_gradient_dir }};
    --z1-bpx:            {{ section.settings.z1_bg_padding_x }}px;
    --z1-bpy:            {{ section.settings.z1_bg_padding_y }}px;
    --z1-br:             {{ section.settings.z1_bg_radius }}px;

    /* ─── Zone 2 ─── */
    --z2-font:           {{ section.settings.z2_font.family }}, {{ section.settings.z2_font.fallback_families }};
    --z2-font-weight:    {{ section.settings.z2_font.weight | default: 700 }};
    --z2-text-transform: {{ section.settings.z2_text_transform }};
    --z2-font-style:     {{ section.settings.z2_font_style }};
    --z2-fs-desktop:     {{ section.settings.z2_font_size_desktop }}px;
    --z2-fs-mobile:      {{ section.settings.z2_font_size_mobile }}px;
    --z2-tc1:            {{ section.settings.z2_text_color_1 }};
    --z2-tc2:            {{ section.settings.z2_text_color_2 }};
    --z2-tgrad-dir:      {{ section.settings.z2_text_gradient_dir }};
    --z2-bc1:            {{ section.settings.z2_bg_color_1 }};
    --z2-bc2:            {{ section.settings.z2_bg_color_2 }};
    --z2-bgrad-dir:      {{ section.settings.z2_bg_gradient_dir }};
    --z2-bpx:            {{ section.settings.z2_bg_padding_x }}px;
    --z2-bpy:            {{ section.settings.z2_bg_padding_y }}px;
    --z2-br:             {{ section.settings.z2_bg_radius }}px;

    /* ─── Stars ─── */
    --stars-color:      {{ section.settings.stars_color }};
    --stars-text-color: {{ section.settings.stars_text_color }};

    /* ─── Subtitle ─── */
    --subtitle-font:       {{ section.settings.subtitle_font.family }}, {{ section.settings.subtitle_font.fallback_families }};
    --subtitle-color:      {{ section.settings.subtitle_color }};
    --subtitle-fs-desktop: {{ section.settings.subtitle_size_desktop }}px;
    --subtitle-fs-mobile:  {{ section.settings.subtitle_size_mobile }}px;

    /* ─── CTA ─── */
    --cta-bg:        {{ section.settings.cta_bg_color }};
    --cta-text:      {{ section.settings.cta_text_color }};
    --cta-hover-bg:  {{ section.settings.cta_hover_bg }};
    --cta-hover-text:{{ section.settings.cta_hover_text }};
    --badge-color:   {{ section.settings.badge_color }};
  }

  /* ════════════════════════════════════════
     Section wrapper
     ════════════════════════════════════════ */
  .ag-hero-zero-{{ section.id }} {
    position: relative;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    min-height: var(--height-mobile);
    box-sizing: border-box;
    background: #1a1a1a;
  }

  @media (min-width: 768px) {
    .ag-hero-zero-{{ section.id }} { min-height: var(--height-desktop); }
  }

  /* ════════════════════════════════════════
     Content slot (=positioning context pour le bg interne)
     ════════════════════════════════════════ */
  .ag-hero-zero-{{ section.id }} .ag-hero-zero__content {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: var(--content-align-h, center);
    justify-content: var(--content-align-v-mobile, flex-end);
    min-height: var(--height-mobile);
    box-sizing: border-box;
  }

  .ag-hero-zero-{{ section.id }} .ag-hero-zero__content[hidden] {
    display: none;
  }

  @media (min-width: 768px) {
    .ag-hero-zero-{{ section.id }} .ag-hero-zero__content {
      justify-content: var(--content-align-v);
      min-height: var(--height-desktop);
    }
  }

  /* ════════════════════════════════════════
     Background layer (à l'intérieur de chaque slot)
     ════════════════════════════════════════ */
  .ag-hero-zero-{{ section.id }} .ag-hero-zero__bg {
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: hidden;
  }

  .ag-hero-zero-{{ section.id }} .ag-hero-zero__bg-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ag-hero-zero-{{ section.id }} .ag-hero-zero__bg--promo .ag-hero-zero__bg-img {
    object-position: var(--promo-bg-image-pos);
  }

  .ag-hero-zero-{{ section.id }} .ag-hero-zero__bg--default .ag-hero-zero__bg-img {
    object-position: var(--default-bg-image-pos);
  }

  .ag-hero-zero-{{ section.id }} .ag-hero-zero__bg-img--desktop { display: none; }
  .ag-hero-zero-{{ section.id }} .ag-hero-zero__bg-img--mobile  { display: block; }

  @media (min-width: 768px) {
    .ag-hero-zero-{{ section.id }} .ag-hero-zero__bg-img--desktop { display: block; }
    .ag-hero-zero-{{ section.id }} .ag-hero-zero__bg-img--mobile  { display: none; }
  }

  .ag-hero-zero-{{ section.id }} .ag-hero-zero__bg-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: none;
  }

  @media (min-width: 768px) {
    .ag-hero-zero-{{ section.id }} .ag-hero-zero__bg-video { display: block; }
  }

  .ag-hero-zero-{{ section.id }} .ag-hero-zero__bg--promo .ag-hero-zero__bg-color {
    position: absolute;
    inset: 0;
    background: linear-gradient(var(--promo-bg-grad-dir), var(--promo-bg-c1), var(--promo-bg-c2));
  }

  .ag-hero-zero-{{ section.id }} .ag-hero-zero__bg--default .ag-hero-zero__bg-color {
    position: absolute;
    inset: 0;
    background: linear-gradient(var(--default-bg-grad-dir), var(--default-bg-c1), var(--default-bg-c2));
  }

  /* ════════════════════════════════════════
     Overlay (dans chaque slot, partagé visuellement)
     ════════════════════════════════════════ */
  .ag-hero-zero-{{ section.id }} .ag-hero-zero__overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: var(--overlay-color);
    opacity: var(--overlay-opacity);
    pointer-events: none;
  }

  /* ════════════════════════════════════════
     Inner content (au-dessus de bg + overlay)
     ════════════════════════════════════════ */
  .ag-hero-zero-{{ section.id }} .ag-hero-zero__inner {
    position: relative;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--ag-gap-md, 16px);
    text-align: var(--content-text-align);
    width: 100%;
    max-width: var(--content-max-w);
    padding: clamp(40px, 8vh, 80px) var(--ag-section-px, clamp(20px, 5vw, 40px));
    box-sizing: border-box;
  }

  /* ════════════════════════════════════════
     Stars Bar
     ════════════════════════════════════════ */
  .ag-hero-zero-{{ section.id }} .ag-hero-zero__stars {
    display: flex;
    align-items: center;
    gap: var(--ag-gap-sm, 8px);
  }

  .ag-hero-zero-{{ section.id }} .ag-hero-zero__stars-icons {
    display: inline-flex;
    gap: 2px;
  }

  .ag-hero-zero-{{ section.id }} .ag-hero-zero__stars-icons svg {
    width: 16px;
    height: 16px;
    fill: var(--stars-color);
  }

  .ag-hero-zero-{{ section.id }} .ag-hero-zero__stars-text {
    font-size: var(--ag-fs-eyebrow, 13px);
    color: var(--stars-text-color);
    font-weight: 600;
    letter-spacing: 0.5px;
  }

  /* ════════════════════════════════════════
     Title
     ════════════════════════════════════════ */
  .ag-hero-zero-{{ section.id }} .ag-hero-zero__title {
    margin: 0;
    padding: 0;
    color: #ffffff;
    line-height: var(--ag-lh-tight, 1.05);
    font-size: var(--ag-fs-display, clamp(38px, 5.5vw, 60px));
    font-weight: 700;
  }

  .ag-hero-zero-{{ section.id }} .ag-hero-zero__title-part {
    color: inherit;
  }

  /* ════════════════════════════════════════
     Subtitle
     ════════════════════════════════════════ */
  .ag-hero-zero-{{ section.id }} .ag-hero-zero__subtitle {
    margin: 0;
    padding: 0;
    font-family: var(--subtitle-font);
    color: var(--subtitle-color);
    font-size: var(--subtitle-fs-mobile);
    line-height: var(--ag-lh-normal, 1.5);
    max-width: 600px;
  }

  @media (min-width: 768px) {
    .ag-hero-zero-{{ section.id }} .ag-hero-zero__subtitle {
      font-size: var(--subtitle-fs-desktop);
    }
  }

  /* ════════════════════════════════════════
     CTA Button
     ════════════════════════════════════════ */
  .ag-hero-zero-{{ section.id }} .ag-hero-zero__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--cta-bg);
    color: var(--cta-text);
    text-decoration: none;
    font-weight: 700;
    letter-spacing: 0.5px;
    transition: background 0.2s ease, color 0.2s ease, transform 0.15s ease;
    cursor: pointer;
    height: var(--ag-btn-h-lg, 60px);
    padding: 0 var(--ag-btn-px-lg, 40px);
    font-size: var(--ag-fs-cta-lg, 18px);
    border-radius: var(--ag-btn-radius, 8px);
    border: none;
  }

  .ag-hero-zero-{{ section.id }} .ag-hero-zero__cta:hover {
    background: var(--cta-hover-bg);
    color: var(--cta-hover-text);
    transform: translateY(-1px);
  }

  {%- if section.settings.cta_size == 'sm' -%}
  .ag-hero-zero-{{ section.id }} .ag-hero-zero__cta {
    height: var(--ag-btn-h-sm, 40px);
    padding: 0 var(--ag-btn-px-sm, 20px);
    font-size: var(--ag-fs-cta-sm, 14px);
  }
  {%- elsif section.settings.cta_size == 'md' -%}
  .ag-hero-zero-{{ section.id }} .ag-hero-zero__cta {
    height: var(--ag-btn-h, 52px);
    padding: 0 var(--ag-btn-px, 28px);
    font-size: var(--ag-fs-cta, 16px);
  }
  {%- endif -%}

  {%- if section.settings.cta_radius_preset == 'sharp' -%}
  .ag-hero-zero-{{ section.id }} .ag-hero-zero__cta { border-radius: 0; }
  {%- elsif section.settings.cta_radius_preset == 'pill' -%}
  .ag-hero-zero-{{ section.id }} .ag-hero-zero__cta { border-radius: var(--ag-btn-radius-pill, 999px); }
  {%- endif -%}

  /* ════════════════════════════════════════
     Badge
     ════════════════════════════════════════ */
  .ag-hero-zero-{{ section.id }} .ag-hero-zero__badge {
    margin: 0;
    padding: 0;
    color: var(--badge-color);
    font-size: var(--ag-fs-small, 14px);
    line-height: var(--ag-lh-normal, 1.5);
    opacity: 0.85;
  }

  /* ════════════════════════════════════════
     ZONE 1 — sans fond
     ════════════════════════════════════════ */
  .ag-hero-zero-{{ section.id }} .ag-hero-zero__zone--1 {
    font-family: var(--z1-font);
    font-weight: var(--z1-font-weight);
    font-size: var(--z1-fs-mobile);
    font-style: var(--z1-font-style);
    text-transform: var(--z1-text-transform);
    display: inline-block;
    {%- if section.settings.z1_text_color_1 == section.settings.z1_text_color_2 -%}
    color: var(--z1-tc1);
    {%- else -%}
    background: linear-gradient(var(--z1-tgrad-dir), var(--z1-tc1), var(--z1-tc2));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    color: transparent;
    {%- endif -%}
  }

  @media (min-width: 768px) {
    .ag-hero-zero-{{ section.id }} .ag-hero-zero__zone--1 { font-size: var(--z1-fs-desktop); }
  }

  /* ════════════════════════════════════════
     ZONE 1 — avec fond highlight
     ════════════════════════════════════════ */
  .ag-hero-zero-{{ section.id }} .ag-hero-zero__zone-bg--1 {
    display: inline-block;
    padding: var(--z1-bpy) var(--z1-bpx);
    border-radius: var(--z1-br);
    line-height: 1;
    {%- if section.settings.z1_bg_color_1 == section.settings.z1_bg_color_2 -%}
    background: var(--z1-bc1);
    {%- else -%}
    background: linear-gradient(var(--z1-bgrad-dir), var(--z1-bc1), var(--z1-bc2));
    {%- endif -%}
  }

  .ag-hero-zero-{{ section.id }} .ag-hero-zero__zone-text--1 {
    font-family: var(--z1-font);
    font-weight: var(--z1-font-weight);
    font-size: var(--z1-fs-mobile);
    font-style: var(--z1-font-style);
    text-transform: var(--z1-text-transform);
    display: inline-block;
    {%- if section.settings.z1_text_color_1 == section.settings.z1_text_color_2 -%}
    color: var(--z1-tc1);
    {%- else -%}
    background: linear-gradient(var(--z1-tgrad-dir), var(--z1-tc1), var(--z1-tc2));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    color: transparent;
    {%- endif -%}
  }

  @media (min-width: 768px) {
    .ag-hero-zero-{{ section.id }} .ag-hero-zero__zone-text--1 { font-size: var(--z1-fs-desktop); }
  }

  /* ════════════════════════════════════════
     ZONE 2 — sans fond
     ════════════════════════════════════════ */
  .ag-hero-zero-{{ section.id }} .ag-hero-zero__zone--2 {
    font-family: var(--z2-font);
    font-weight: var(--z2-font-weight);
    font-size: var(--z2-fs-mobile);
    font-style: var(--z2-font-style);
    text-transform: var(--z2-text-transform);
    display: inline-block;
    {%- if section.settings.z2_text_color_1 == section.settings.z2_text_color_2 -%}
    color: var(--z2-tc1);
    {%- else -%}
    background: linear-gradient(var(--z2-tgrad-dir), var(--z2-tc1), var(--z2-tc2));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    color: transparent;
    {%- endif -%}
  }

  @media (min-width: 768px) {
    .ag-hero-zero-{{ section.id }} .ag-hero-zero__zone--2 { font-size: var(--z2-fs-desktop); }
  }

  /* ════════════════════════════════════════
     ZONE 2 — avec fond highlight
     ════════════════════════════════════════ */
  .ag-hero-zero-{{ section.id }} .ag-hero-zero__zone-bg--2 {
    display: inline-block;
    padding: var(--z2-bpy) var(--z2-bpx);
    border-radius: var(--z2-br);
    line-height: 1;
    {%- if section.settings.z2_bg_color_1 == section.settings.z2_bg_color_2 -%}
    background: var(--z2-bc1);
    {%- else -%}
    background: linear-gradient(var(--z2-bgrad-dir), var(--z2-bc1), var(--z2-bc2));
    {%- endif -%}
  }

  .ag-hero-zero-{{ section.id }} .ag-hero-zero__zone-text--2 {
    font-family: var(--z2-font);
    font-weight: var(--z2-font-weight);
    font-size: var(--z2-fs-mobile);
    font-style: var(--z2-font-style);
    text-transform: var(--z2-text-transform);
    display: inline-block;
    {%- if section.settings.z2_text_color_1 == section.settings.z2_text_color_2 -%}
    color: var(--z2-tc1);
    {%- else -%}
    background: linear-gradient(var(--z2-tgrad-dir), var(--z2-tc1), var(--z2-tc2));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    color: transparent;
    {%- endif -%}
  }

  @media (min-width: 768px) {
    .ag-hero-zero-{{ section.id }} .ag-hero-zero__zone-text--2 { font-size: var(--z2-fs-desktop); }
  }
{%- endstyle -%}

{%- comment -%} Pré-calcul du SVG étoiles (partagé entre les deux slots) {%- endcomment -%}
{%- capture stars_svg -%}
  {%- for i in (1..5) -%}
    {%- if i <= section.settings.stars_count -%}
      <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M10 1.5l2.6 5.6 6.2.5-4.7 4.1 1.4 6L10 14.6 4.5 17.7l1.4-6L1.2 7.6l6.2-.5z"/></svg>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

<section id="ag-hero-zero-{{ section.id }}"
         class="ag-hero-zero ag-hero-zero-{{ section.id }}"
         data-schedule-start="{{ section.settings.schedule_start | escape }}"
         data-schedule-end="{{ section.settings.schedule_end | escape }}">

  {%- comment -%} ══════════════════════════════════════
    SLOT PROMO — background + contenu PROMO
  ══════════════════════════════════════ {%- endcomment -%}
  <div class="ag-hero-zero__content ag-hero-zero__content--promo"
       data-slot="promo"
       hidden>

    {%- comment -%} Background PROMO {%- endcomment -%}
    <div class="ag-hero-zero__bg ag-hero-zero__bg--promo">
      {%- case section.settings.promo_bg_type -%}
        {%- when 'image' -%}
          {%- if section.settings.promo_bg_image_mobile != blank -%}
            <img class="ag-hero-zero__bg-img ag-hero-zero__bg-img--mobile"
                 src="{{ section.settings.promo_bg_image_mobile | image_url: width: 1200 }}"
                 alt="{{ section.settings.promo_bg_image_mobile.alt | escape }}"
                 loading="eager"
                 width="{{ section.settings.promo_bg_image_mobile.width }}"
                 height="{{ section.settings.promo_bg_image_mobile.height }}">
          {%- endif -%}
          {%- if section.settings.promo_bg_image_desktop != blank -%}
            <img class="ag-hero-zero__bg-img ag-hero-zero__bg-img--desktop"
                 src="{{ section.settings.promo_bg_image_desktop | image_url: width: 2400 }}"
                 alt="{{ section.settings.promo_bg_image_desktop.alt | escape }}"
                 loading="eager"
                 width="{{ section.settings.promo_bg_image_desktop.width }}"
                 height="{{ section.settings.promo_bg_image_desktop.height }}">
          {%- endif -%}
        {%- when 'video' -%}
          {%- if section.settings.promo_bg_video_mp4 != blank -%}
            <video class="ag-hero-zero__bg-video"
                   autoplay muted loop playsinline preload="metadata"
                   {%- if section.settings.promo_bg_video_poster != blank %} poster="{{ section.settings.promo_bg_video_poster | image_url: width: 2400 }}"{%- endif %}>
              <source src="{{ section.settings.promo_bg_video_mp4 }}" type="video/mp4">
            </video>
          {%- endif -%}
          {%- if section.settings.promo_bg_video_poster != blank -%}
            <img class="ag-hero-zero__bg-img ag-hero-zero__bg-img--mobile"
                 src="{{ section.settings.promo_bg_video_poster | image_url: width: 1200 }}"
                 alt="" loading="eager">
          {%- endif -%}
        {%- when 'color' -%}
          <div class="ag-hero-zero__bg-color"></div>
      {%- endcase -%}
    </div>

    {%- comment -%} Overlay PROMO {%- endcomment -%}
    <div class="ag-hero-zero__overlay"></div>

    {%- comment -%} Contenu PROMO {%- endcomment -%}
    <div class="ag-hero-zero__inner">

      {%- if section.settings.stars_enabled -%}
        <div class="ag-hero-zero__stars">
          <span class="ag-hero-zero__stars-icons">{{ stars_svg }}</span>
          {%- if section.settings.promo_stars_text != blank -%}
            <span class="ag-hero-zero__stars-text">{{ section.settings.promo_stars_text }}</span>
          {%- endif -%}
        </div>
      {%- endif -%}

      <h1 class="ag-hero-zero__title">
        {%- assign p_before  = section.settings.promo_title_before  -%}
        {%- assign p_zone1   = section.settings.promo_title_zone1   -%}
        {%- assign p_between = section.settings.promo_title_between -%}
        {%- assign p_zone2   = section.settings.promo_title_zone2   -%}
        {%- assign p_after   = section.settings.promo_title_after   -%}

