  <noscript>
    <style>.ag-hero-zero-{{ section.id }} [data-slot="default"] { display: flex !important; }</style>
  </noscript>

</section>

<script>
  (function() {
    var root = document.getElementById('ag-hero-zero-{{ section.id }}');
    if (!root) return;

    var startStr = root.dataset.scheduleStart || '';
    var endStr   = root.dataset.scheduleEnd   || '';
    var now      = new Date();

    function parseDate(s) {
      if (!s) return null;
      var d = new Date(s);
      return isNaN(d.getTime()) ? null : d;
    }

    var start = parseDate(startStr);
    var end   = parseDate(endStr);

    var isPromoActive =
      (start === null || now >= start) &&
      (end   === null || now <= end);

    var promoSlot   = root.querySelector('[data-slot="promo"]');
    var defaultSlot = root.querySelector('[data-slot="default"]');

    if (isPromoActive) {
      if (promoSlot)   promoSlot.hidden = false;
      if (defaultSlot) defaultSlot.hidden = true;
    } else {
      if (promoSlot)   promoSlot.hidden = true;
      if (defaultSlot) defaultSlot.hidden = false;
    }
  })();
</script>

