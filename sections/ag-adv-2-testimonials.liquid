{% comment %} ag-adv-2-testimonials.liquid — propriété de James Sparks {% endcomment %}
{% render 'ag-adv-2-schema-head' %}

{%- liquid
  assign s = section.settings
-%}

{%- capture root_style -%}
  {% if s.bg_color != blank %}background:{{ s.bg_color }};{% endif %}
  {% if s.card_bg != blank %}--ag2-tcard-bg:{{ s.card_bg }};{% endif %}
  {% if s.accent_color != blank %}--ag2-coral:{{ s.accent_color }};{% endif %}
  {% if s.accent_deep != blank %}--ag2-coral-deep:{{ s.accent_deep }};{% endif %}
  {% if s.text_color != blank %}--ag2-ink:{{ s.text_color }};{% endif %}
  {% if s.body_color != blank %}--ag2-ink-soft:{{ s.body_color }};{% endif %}
  {% if s.muted_color != blank %}--ag2-gray:{{ s.muted_color }};{% endif %}
  {% if s.stars_color != blank %}--ag2-gold:{{ s.stars_color }};{% endif %}
  {% if s.verified_color != blank %}--ag2-green:{{ s.verified_color }};{% endif %}
  {% if s.line_color != blank %}--ag2-line:{{ s.line_color }};{% endif %}
{%- endcapture -%}

<div class="ag-adv-2 spacing-style" style="{% render 'spacing-style', settings: section.settings %}{{ root_style | strip_newlines }}">
  <div class="ag-adv-2__col-wide">
    {%- if s.kicker != blank or s.heading != blank -%}
      <div class="ag-adv-2__shead">
        {%- if s.kicker != blank -%}<span class="ag-adv-2__kicker">{{ s.kicker }}</span>{%- endif -%}
        {%- if s.heading != blank -%}<h2>{{ s.heading }}</h2>{%- endif -%}
      </div>
    {%- endif -%}
    <div class="ag-adv-2-tgrid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'review' -%}
          {%- assign rating = block.settings.rating | default: 5 -%}
          <div class="ag-adv-2-tcard"{% if s.card_bg != blank %} style="background:{{ s.card_bg }};"{% endif %} {{ block.shopify_attributes }}>
            <div class="ag-adv-2-tcard__stars">
              {%- for i in (1..rating) -%}&#9733;{%- endfor -%}
            </div>
            <q class="ag-adv-2-tcard__q">{{ block.settings.quote }}</q>
            <div class="ag-adv-2-tcard__meta">
              <div class="ag-adv-2__ph">
                {%- if block.settings.avatar != blank -%}
                  <img src="{{ block.settings.avatar | image_url: width: 84 }}" alt="{{ block.settings.name | escape }}" loading="lazy">
                {%- else -%}
                  <span></span>
                {%- endif -%}
              </div>
              <div class="ag-adv-2-tcard__nm">
                {{ block.settings.name }}
                {%- if block.settings.location != blank -%}<span>{{ block.settings.location }}</span>{%- endif -%}
              </div>
            </div>
            {%- if block.settings.show_verified -%}
              <div class="ag-adv-2-tcard__verified">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M20 6 9 17l-5-5"/></svg>{{ s.verified_label | default: 'Achat vérifié' }}
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "AG-Adv-2 — Testimonials",
  "tag": "section",
  "class": "ag-adv-2-section",
  "enabled_on": {
    "templates": [
      "page"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Elles l'ont adopté"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre H2",
      "default": "Plus de 40 000 femmes ont changé de routine"
    },
    {
      "type": "text",
      "id": "verified_label",
      "label": "Label « vérifié »",
      "default": "Achat vérifié"
    },
    {
      "type": "header",
      "content": "Apparence"
    },
    {
      "type": "color_background",
      "id": "bg_color",
      "label": "Couleur de fond",
      "info": "Supporte couleur solide ou dégradé",
      "default": "#ffffff"
    },
    {
      "type": "color_background",
      "id": "card_bg",
      "label": "Couleur de fond des cartes",
      "info": "Supporte couleur solide ou dégradé",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Couleur d'accent",
      "default": "#ff6b6b"
    },
    {
      "type": "color",
      "id": "accent_deep",
      "label": "Couleur d'accent profonde",
      "default": "#e85459"
    },
    {
      "type": "color",
      "id": "stars_color",
      "label": "Couleur des étoiles",
      "default": "#e0a93a"
    },
    {
      "type": "color",
      "id": "verified_color",
      "label": "Couleur « vérifié »",
      "default": "#2ea86a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Couleur du texte",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Couleur du corps",
      "default": "#4a4a4a"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Couleur secondaire",
      "default": "#8c8c8c"
    },
    {
      "type": "color",
      "id": "line_color",
      "label": "Couleur des bordures",
      "default": "#ececec"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Padding haut",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Padding bas",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 8
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Témoignage",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "label": "Note (étoiles)",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Citation",
          "default": "J'étais sceptique après des années de déceptions. Au bout de trois semaines, mon mari m'a demandé si j'avais changé quelque chose."
        },
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "Avatar"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Nom",
          "default": "Valérie M."
        },
        {
          "type": "text",
          "id": "location",
          "label": "Lieu",
          "default": "Lyon"
        },
        {
          "type": "checkbox",
          "id": "show_verified",
          "label": "Afficher « Achat vérifié »",
          "default": true
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "AG-Adv-2 — Testimonials",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "name": "Valérie M.",
            "location": "Lyon",
            "quote": "J'étais sceptique après des années de déceptions. Au bout de trois semaines, mon mari m'a demandé si j'avais changé quelque chose. Tout est dit."
          }
        },
        {
          "type": "review",
          "settings": {
            "name": "Inès B.",
            "location": "Bordeaux",
            "quote": "Le tiraillement en fin de journée a disparu en deux semaines. J'ai arrêté trois autres produits. Ma trousse n'a jamais été aussi légère."
          }
        },
        {
          "type": "review",
          "settings": {
            "name": "Christine D.",
            "location": "Nantes",
            "quote": "À 58 ans, je ne pensais plus que quoi que ce soit puisse changer. Je me suis trompée. C'est la première fois que je rachète un produit deux fois."
          }
        },
        {
          "type": "review",
          "settings": {
            "name": "Sarah K.",
            "location": "Strasbourg",
            "quote": "Ce que j'aime, c'est l'absence de parfum. Ma peau est réactive et c'est le seul sérum qui ne l'a jamais agressée. Et le résultat est là."
          }
        },
        {
          "type": "review",
          "settings": {
            "name": "Fatou S.",
            "location": "Marseille",
            "quote": "J'ai offert un flacon à ma mère et un à ma fille. Trois générations conquises. Le rapport qualité-prix est incomparable."
          }
        },
        {
          "type": "review",
          "settings": {
            "name": "Élodie R.",
            "location": "Lille",
            "quote": "Esthéticienne depuis 20 ans, je recommande maintenant Lumira à mes clientes. Les ingrédients parlent d'eux-mêmes, sans le marketing habituel."
          }
        }
      ]
    }
  ]
}
{% endschema %}
