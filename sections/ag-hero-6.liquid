      "id": "image_mobile",
      "label": "Mobile Background Image"
    },
    {
      "type": "header",
      "content": "Typography Options"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "sans-serif"
    },
    {
      "type": "font_picker",
      "id": "text_font",
      "label": "Text font",
      "default": "sans-serif"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Transform Ordinary Baths into a Skin-Nourishing Ritual"
