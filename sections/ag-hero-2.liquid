      "label": "Mobile Image",
      "info": "If not set, desktop image will be used"
    },
    {
      "type": "header",
      "content": "Gradients & Overlays"
    },
    {
      "type": "color_background",
      "id": "gradient_desktop",
      "label": "Gradient Overlay (Desktop)",
      "default": "linear-gradient(to bottom, rgba(211, 25, 25, 0) 41.83%, rgba(211, 25, 25, 1) 100%)"
    },
    {
      "type": "color_background",
      "id": "gradient_mobile",
      "label": "Gradient Overlay (Mobile)",
      "default": "linear-gradient(to bottom, rgba(0, 0, 0, 0) 41.83%, rgba(0, 0, 0, 0.5) 100%)"
    },
    {
      "type": "header",
      "content": "Rating & Reviews"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show Rating Stars",
      "default": true
    },
    {
      "type": "range",
      "id": "rating_value",
      "min": 0,
      "max": 5,
      "step": 0.1,
      "label": "Rating Value",
      "default": 4.8
    },
    {
      "type": "text",
      "id": "review_display_text",
      "label": "Rating Text",
      "default": "4.8 · XXXX+ happy customers"
    },
    {
      "type": "color",
      "id": "rating_color",
      "label": "Stars Color",
      "default": "#FFC72D"
    },
    {
      "type": "color",
      "id": "rating_text_color",
      "label": "Rating Text Color",
      "default": "#042138"
    },
    {
      "type": "url",
      "id": "review_link",
      "label": "Rating Link URL",
      "info": "URL for the rating text to link to"
    },
    {
      "type": "select",
      "id": "review_alignment",
      "label": "Stars Alignment (Desktop)",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
