{% endstylesheet %}

{%- style -%}
  /* Force the Shopify section wrapper to be truly full-width */
  .shopify-section:has(#ag-hero-2-{{ section.id }}) {
    margin-left: 0 !important;
    margin-right: 0 !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
    max-width: 100% !important;
    width: 100% !important;
  }

  /* CSS Variables */
  #ag-hero-2-{{ section.id }} {
    --button-width-desktop: {{ button_width_desktop }}px;
    --button-height-desktop: {{ button_height_desktop }}px;
    --button-height-mobile: {{ button_height_mobile }}px;
    --content-padding-left: {{ section.settings.content_padding_left | default: 75 }}px;
    --content-padding-right: {{ section.settings.content_padding_right | default: 0 }}px;
    {% if section.settings.title_font %}
      --title-font-family: {{ section.settings.title_font.family }}, {{ section.settings.title_font.fallback_families }};
      --title-font-weight: {{ section.settings.title_font.weight }};
      --title-font-style: {{ section.settings.title_font.style }};
    {% else %}
      --title-font-family: var(--font-heading-family);
      --title-font-weight: var(--font-heading-weight);
      --title-font-style: normal;
    {% endif %}
  }

  /* Desktop styles */
  #ag-hero-2-{{ section.id }} .ag-hero-2__gradient-overlay {
    background: {{ gradient_desktop }};
  }

  #ag-hero-2-{{ section.id }} .ag-hero-2__award-text {
    font-size: {{ section.settings.pre_heading_size_desktop }}px;
    {% if pre_heading_use_gradient and section.settings.pre_heading_gradient != blank %}
      background: {{ section.settings.pre_heading_gradient }};
      background-clip: text;
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      color: transparent;
    {% else %}
      color: {{ pre_heading_color }};
    {% endif %}
  }

  #ag-hero-2-{{ section.id }} .ag-hero-2__heading {
    font-size: {{ heading_size_desktop }}px;
    font-family: var(--title-font-family) !important;
    font-weight: var(--title-font-weight) !important;
    font-style: var(--title-font-style) !important;
  }

  #ag-hero-2-{{ section.id }} .ag-hero-2__description {
    font-size: {{ desktop_description_size }}px;
  }

  #ag-hero-2-{{ section.id }} .ag-hero-2__button {
    border-radius: {{ button_radius }}px;
    {% if button_use_gradient and button_gradient != blank %}
      background: {{ button_gradient }};
    {% else %}
      background-color: {{ button_bg_color }};
    {% endif %}
    color: {{ button_text_color }};
  }

  /* Desktop spacing */
  #ag-hero-2-{{ section.id }} .ag-hero-2__content {
    gap: {{ section.settings.content_spacing_desktop }}px;
  }

  #ag-hero-2-{{ section.id }} .ag-hero-2__cta-section {
    margin-top: {{ section.settings.cta_margin_desktop }}px;
    gap: {{ section.settings.cta_spacing_desktop }}px;
  }

  /* Mobile styles */
  @media screen and (max-width: 991px) {
    #ag-hero-2-{{ section.id }} .ag-hero-2--mobile-only .ag-hero-2__gradient-overlay {
      background: {{ gradient_mobile }};
    }

    #ag-hero-2-{{ section.id }} .ag-hero-2__award-text {
      font-size: {{ section.settings.pre_heading_size_mobile }}px;
    }

    #ag-hero-2-{{ section.id }} .ag-hero-2__heading {
      font-size: {{ heading_size_mobile }}px;
      font-family: var(--title-font-family) !important;
      font-weight: var(--title-font-weight) !important;
      font-style: var(--title-font-style) !important;
    }

    #ag-hero-2-{{ section.id }} .ag-hero-2__description {
      font-size: {{ mobile_description_size }}px;
    }

    #ag-hero-2-{{ section.id }} .ag-hero-2__content {
      gap: {{ section.settings.content_spacing_mobile }}px;
      padding-top: {{ section.settings.content_padding_top_mobile }}px;
    }

    #ag-hero-2-{{ section.id }} .ag-hero-2__cta-section {
      margin-top: {{ section.settings.cta_margin_mobile }}px;
      gap: {{ section.settings.cta_spacing_mobile }}px;
    }

    #ag-hero-2-{{ section.id }} .ag-hero-2__rating-container {
      justify-content: center;
    }
  }
{%- endstyle -%}

{%- capture heading_html -%}
  {% if hero_title != blank %}
    {% if show_title_gradient and title_gradient != blank %}
      <h1 class="ag-hero-2__heading" style="background: {{ title_gradient }}; background-clip: text; -webkit-background-clip: text; -webkit-text-fill-color: transparent; color: transparent;">
        {{ hero_title }}
      </h1>
    {% elsif use_colored_words and colored_words != blank %}
      {% assign words_array = colored_words | split: ', ' %}
      {% assign title_with_colors = hero_title %}
      {% for word in words_array %}
        {% assign word_trimmed = word | strip %}
        {% assign replacement = '<span style="color: ' | append: word_color | append: ';">' | append: word_trimmed | append: '</span>' %}
        {% assign title_with_colors = title_with_colors | replace: word_trimmed, replacement %}
      {% endfor %}
      <h1 class="ag-hero-2__heading" style="color: {{ heading_color }};">{{ title_with_colors }}</h1>
    {% elsif use_font_words and font_words != blank %}
      {% assign words_array = font_words | split: ', ' %}
      {% assign title_with_font = hero_title %}
      {% for word in words_array %}
        {% assign word_trimmed = word | strip %}
        {% assign replacement = '<span style="font-family: ' | append: custom_font | append: ';">' | append: word_trimmed | append: '</span>' %}
        {% assign title_with_font = title_with_font | replace: word_trimmed, replacement %}
      {% endfor %}
      <h1 class="ag-hero-2__heading" style="color: {{ heading_color }};">{{ title_with_font }}</h1>
    {% else %}
      <h1 class="ag-hero-2__heading" style="color: {{ heading_color }};">{{ hero_title }}</h1>
    {% endif %}
  {% endif %}
{%- endcapture -%}

{%- capture rating_html -%}
  {% if show_rating %}
    <div class="ag-hero-2__reviews-wrapper {{ mobile_review_alignment_class }}">
      <div class="ag-hero-2__review-wrapper">
        <div class="stars-container" style="font-size: {{ star_size }}px;">
          {% assign full_stars = rating_value | floor %}
          {% assign has_half_star = rating_value | modulo: 1 %}
          {% assign empty_stars = 5 | minus: full_stars %}
          {% if has_half_star > 0 %}
            {% assign empty_stars = empty_stars | minus: 1 %}
          {% endif %}

          {% for i in (1..full_stars) %}
            <span class="rating-stars__star rating-stars__star--filled" style="color: {{ rating_color }};">★</span>
          {% endfor %}

          {% if has_half_star > 0 %}
            <span class="rating-stars__star rating-stars__star--half" style="color: {{ rating_color }};">☆</span>
          {% endif %}

          {% for i in (1..empty_stars) %}
            <span class="rating-stars__star rating-stars__star--empty" style="color: rgba(0,0,0,0.2);">☆</span>
          {% endfor %}
        </div>
        {% if review_display_text != blank %}
          {% if rating_link != blank %}
            <a
              href="{{ rating_link }}"
              class="ag-hero-2__rating-text"
              style="color: {{ rating_text_color }}"
            >
              {{ review_display_text }}
            </a>
          {% else %}
            <span class="ag-hero-2__rating-text" style="color: {{ rating_text_color }}">
              {{ review_display_text }}
            </span>
          {% endif %}
        {% endif %}
      </div>
    </div>
  {% endif %}
{%- endcapture -%}

{%- capture button_html -%}
  {% if button_text != blank %}
    <a href="{{ button_url | default: '#' }}" class="ag-hero-2__button">
      {% if button_use_icon and button_icon_position == 'left' %}
        <span class="ag-hero-2__button-icon ag-hero-2__button-icon--left">
          {{ button_icon_svg }}
        </span>
      {% endif %}
      <span class="ag-hero-2__button-text">{{ button_text }}</span>
      {% if button_use_icon and button_icon_position == 'right' %}
        <span class="ag-hero-2__button-icon ag-hero-2__button-icon--right">
          {{ button_icon_svg }}
        </span>
      {% endif %}
    </a>
  {% endif %}
{%- endcapture -%}

<div class="ag-hero-2" id="ag-hero-2-{{ section.id }}">
  <!-- Desktop View -->
  <div class="ag-hero-2__container ag-hero-2--desktop-only">
    <div class="ag-hero-2__image">
      {% if hero_image != blank %}
        <img
          srcset="{%- if hero_image.width >= 165 -%}{{ hero_image | image_url: width: 165 }} 165w,{%- endif -%}
          {%- if hero_image.width >= 360 -%}{{ hero_image | image_url: width: 360 }} 360w,{%- endif -%}
          {%- if hero_image.width >= 535 -%}{{ hero_image | image_url: width: 535 }} 535w,{%- endif -%}
          {%- if hero_image.width >= 720 -%}{{ hero_image | image_url: width: 720 }} 720w,{%- endif -%}
          {%- if hero_image.width >= 990 -%}{{ hero_image | image_url: width: 990 }} 990w,{%- endif -%}
          {%- if hero_image.width >= 1200 -%}{{ hero_image | image_url: width: 1200 }} 1200w,{%- endif -%}
          {%- if hero_image.width >= 1600 -%}{{ hero_image | image_url: width: 1600 }} 1600w,{%- endif -%}"
          src="{{ hero_image | image_url: width: 1600 }}"
          sizes="(min-width: 992px) 40vw, 100vw"
          alt="{{ hero_image.alt | default: 'Hero image' | escape }}"
          loading="lazy"
          width="{{ hero_image.width }}"
          height="{{ hero_image.height }}"
        >
      {% else %}
        {{ 'image' | placeholder_svg_tag: 'ag-hero-2__placeholder' }}
      {% endif %}
    </div>

    <div class="ag-hero-2__gradient-overlay"></div>

    <div class="ag-hero-2__content">
      <div class="ag-hero-2__main-content">
        <div class="ag-hero-2__text-section">
          {% if pre_heading != blank %}
            <h3
              class="ag-hero-2__pre-heading ag-hero-2__award-text{% if pre_heading_use_gradient %} ag-hero-2__pre-heading--gradient{% endif %}"
              {% unless pre_heading_use_gradient %}
                style="color: {{ pre_heading_color }};"
              {% endunless %}
            >
              {{ pre_heading }}
            </h3>
          {% endif %}

          <div class="ag-hero-2__heading-wrapper">
            {{ heading_html }}
          </div>
        </div>

        {% if description != blank %}
          <div class="ag-hero-2__description-wrapper">
            <div class="ag-hero-2__description" style="color: {{ description_color }};">
              {{ description }}
            </div>
          </div>
        {% endif %}
      </div>

      <div class="ag-hero-2__cta-section">
        {{ button_html }}
        {{ rating_html }}
      </div>
    </div>
  </div>

  <!-- Mobile View -->
  <div class="ag-hero-2__container ag-hero-2--mobile-only">
    <div class="ag-hero-2__gradient-overlay"></div>

    <div class="ag-hero-2__content">
      {% if pre_heading != blank %}
        <h3
          class="ag-hero-2__pre-heading ag-hero-2__award-text{% if pre_heading_use_gradient %} ag-hero-2__pre-heading--gradient{% endif %}"
          {% unless pre_heading_use_gradient %}
            style="color: {{ pre_heading_color }};"
          {% endunless %}
        >
          {{ pre_heading }}
        </h3>
      {% endif %}

      <div class="ag-hero-2__heading-wrapper">
        {{ heading_html }}
      </div>

      {% if description != blank %}
        <div class="ag-hero-2__description" style="color: {{ description_color }}; font-size: {{ mobile_description_size }}px;">
          {{ description }}
        </div>
      {% endif %}

      <div class="ag-hero-2__cta-section">
        {% if button_text != blank %}
          <a
            href="{{ button_url | default: '#' }}"
            class="ag-hero-2__button ag-hero-2__button--mobile"
          >
            {% if button_use_icon and button_icon_position == 'left' %}
              <span class="ag-hero-2__button-icon ag-hero-2__button-icon--left">
                {{ button_icon_svg }}
              </span>
            {% endif %}
            <span class="ag-hero-2__button-text">{{ button_text }}</span>
            {% if button_use_icon and button_icon_position == 'right' %}
              <span class="ag-hero-2__button-icon ag-hero-2__button-icon--right">
                {{ button_icon_svg }}
              </span>
            {% endif %}
          </a>
        {% endif %}

        {{ rating_html }}
      </div>
    </div>

    <div class="ag-hero-2__image">
      {% if mobile_image != blank %}
        <img
          srcset="{%- if mobile_image.width >= 165 -%}{{ mobile_image | image_url: width: 165 }} 165w,{%- endif -%}
          {%- if mobile_image.width >= 360 -%}{{ mobile_image | image_url: width: 360 }} 360w,{%- endif -%}
          {%- if mobile_image.width >= 535 -%}{{ mobile_image | image_url: width: 535 }} 535w,{%- endif -%}
          {%- if mobile_image.width >= 720 -%}{{ mobile_image | image_url: width: 720 }} 720w,{%- endif -%}
          {%- if mobile_image.width >= 990 -%}{{ mobile_image | image_url: width: 990 }} 990w,{%- endif -%}
          {%- if mobile_image.width >= 1200 -%}{{ mobile_image | image_url: width: 1200 }} 1200w,{%- endif -%}"
          src="{{ mobile_image | image_url: width: 720 }}"
          sizes="100vw"
          alt="{{ mobile_image.alt | default: 'Hero mobile image' | escape }}"
          loading="lazy"
          width="{{ mobile_image.width }}"
          height="{{ mobile_image.height }}"
        >
      {% else %}
        {{ 'image' | placeholder_svg_tag: 'ag-hero-2__placeholder' }}
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "AG Hero 2",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
