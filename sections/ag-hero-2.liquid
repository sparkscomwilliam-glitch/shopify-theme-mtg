      "default": "linear-gradient(to right, #FF0000, #0000FF)"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#000000"
    },
    {
      "type": "checkbox",
      "id": "use_colored_words",
      "label": "Color Specific Words in Heading",
      "default": false
    },
    {
      "type": "text",
      "id": "colored_words",
