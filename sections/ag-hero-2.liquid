      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Stars Size",
      "default": 16
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "pre_heading",
      "label": "Award Text (Uptitle)",
      "default": "XXX AWARD WINNING • XXX+ SOLD"
    },
    {
      "type": "checkbox",
      "id": "pre_heading_use_gradient",
      "label": "Use Gradient for Uptitle",
      "default": false
    },
    {
      "type": "color_background",
      "id": "pre_heading_gradient",
      "label": "Uptitle Gradient",
      "default": "linear-gradient(to right, #FF0000, #0000FF)"
    },
    {
      "type": "color",
      "id": "pre_heading_color",
      "label": "Uptitle Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "pre_heading_size_desktop",
      "min": 10,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Uptitle Size (Desktop)",
      "default": 16
    },
    {
      "type": "range",
      "id": "pre_heading_size_mobile",
      "min": 8,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Uptitle Size (Mobile)",
      "default": 12
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Lorem ipsum tempor<br>Incididunt ut labore"
    },
    {
      "type": "font_picker",
      "id": "title_font",
      "label": "Title Font",
      "default": "helvetica_n4"
    },
    {
      "type": "checkbox",
      "id": "heading_use_gradient",
      "label": "Use Gradient for Heading",
      "default": false,
      "info": "The gradient is applied directly on the text"
    },
    {
      "type": "color_background",
      "id": "heading_gradient",
