{% comment %}
  AG Hero 2 Section
  A responsive hero section with different layouts for desktop and mobile
{% endcomment %}

{%- liquid
  assign show_rating = section.settings.show_rating
  assign rating_value = section.settings.rating_value
  assign review_display_text = section.settings.review_display_text
  assign rating_link = section.settings.review_link
  assign rating_color = section.settings.rating_color
  assign rating_text_color = section.settings.rating_text_color
  assign star_size = section.settings.star_size
  assign mobile_review_alignment = section.settings.mobile_review_alignment | default: section.settings.review_alignment

  assign mobile_review_alignment_class = 'center'
  if mobile_review_alignment == 'left'
    assign mobile_review_alignment_class = 'left'
  elsif mobile_review_alignment == 'right'
    assign mobile_review_alignment_class = 'right'
  endif

  assign pre_heading = section.settings.pre_heading
  assign pre_heading_color = section.settings.pre_heading_color
  assign pre_heading_use_gradient = section.settings.pre_heading_use_gradient

  assign hero_title = section.settings.heading
  assign heading_color = section.settings.heading_color
  assign heading_size_desktop = section.settings.heading_size_desktop
  assign heading_size_mobile = section.settings.heading_size_mobile
  assign show_title_gradient = section.settings.heading_use_gradient
  assign title_gradient = section.settings.heading_gradient

  assign use_colored_words = section.settings.use_colored_words
  assign colored_words = section.settings.colored_words
  assign word_color = section.settings.word_color

  assign use_font_words = section.settings.use_font_words
  assign font_words = section.settings.font_words
  assign custom_font = section.settings.custom_font

  assign description = section.settings.description
  assign description_color = section.settings.description_color
  assign desktop_description_size = section.settings.description_size_desktop
  assign mobile_description_size = section.settings.description_size_mobile

  assign button_text = section.settings.button_text
  assign button_url = section.settings.button_url
  assign button_text_color = section.settings.button_text_color
  assign button_bg_color = section.settings.button_bg_color
  assign button_radius = section.settings.button_radius
  assign button_use_gradient = section.settings.button_use_gradient
  assign button_gradient = section.settings.button_gradient
  assign button_use_icon = section.settings.button_use_icon
  assign button_icon_svg = section.settings.button_icon_svg
  assign button_icon_position = section.settings.button_icon_position

  assign hero_image = section.settings.image
  assign mobile_image = section.settings.mobile_image | default: hero_image

  assign button_width_desktop = section.settings.button_width_desktop
  assign button_height_desktop = section.settings.button_height_desktop
  assign button_width_mobile = section.settings.button_width_mobile
  assign button_height_mobile = section.settings.button_height_mobile

  assign gradient_desktop = section.settings.gradient_desktop
  assign gradient_mobile = section.settings.gradient_mobile
-%}

{% stylesheet %}
.ag-hero-2 {
  width: 100%;
  position: relative;
  background-color: #fff;
  overflow: hidden;
  font-family: var(--font-body-family);
  font-weight: var(--font-body-weight);
}

/* Visibility control — scoped to this section */
.ag-hero-2 .ag-hero-2--desktop-only {
  display: none !important;
}

.ag-hero-2 .ag-hero-2--mobile-only {
  display: block;
}

@media screen and (min-width: 992px) {
  .ag-hero-2 .ag-hero-2--desktop-only {
    display: block !important;
  }

  .ag-hero-2 .ag-hero-2--mobile-only {
    display: none !important;
  }
}

.ag-hero-2__container {
  position: relative;
  width: 100%;
  background: transparent;
}

.ag-hero-2__image {
  position: relative;
  width: 100%;
  z-index: 0;
}

.ag-hero-2__image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.ag-hero-2__placeholder {
  width: 100%;
  height: 100%;
  background-color: #f5f5f5;
}

.ag-hero-2__gradient-overlay {
  position: absolute;
  width: 100%;
  top: 0;
  right: 0;
  left: 0;
  height: 100%;
  z-index: 1;
}

.ag-hero-2__content {
  position: absolute;
  top: 149px;
  left: var(--content-padding-left, 75px);
  right: var(--content-padding-right, auto);
  width: calc(725px - var(--content-padding-left, 75px) + 75px);
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: flex-start;
  gap: 48px;
  z-index: 2;
  background: transparent;
}

.ag-hero-2__pre-heading {
  font-size: 16px;
  letter-spacing: 0.03em;
  line-height: 16px;
  white-space: pre-wrap;
  margin: 0 0 10px 0;
  text-align: left !important;
  background: transparent;
}

.ag-hero-2__heading-wrapper {
  width: 100%;
  background: transparent;
}

.ag-hero-2__heading {
  font-size: 55px;
  font-weight: var(--font-heading-weight);
  line-height: 116%;
  text-transform: capitalize;
  margin: 0;
  font-family: var(--font-heading-family) !important;
  background: transparent;
}

.ag-hero-2__description {
  font-size: 18px;
  letter-spacing: 0.01em;
  line-height: 150%;
  margin: 0;
  background: transparent;
}

.ag-hero-2__cta-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  max-width: 454px;
  gap: 16px;
  margin-top: 20px;
}

.ag-hero-2__reviews-wrapper {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 15px;
  margin-bottom: 10px;
}

.ag-hero-2__review-wrapper {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 15px;
}

.ag-hero-2 .stars-container {
  display: flex;
  align-items: center;
}

.ag-hero-2__button {
  width: 100%;
  border-radius: 25px;
  background-color: #000;
  color: #f4fbfe;
  text-align: center;
  font-size: 16px;
  font-weight: 700;
  letter-spacing: 0.01em;
  line-height: 28px;
  text-transform: uppercase;
  padding: 18px 35px;
  text-decoration: none;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  cursor: pointer;
}

.ag-hero-2__button--mobile {
  width: 100%;
  height: var(--button-height-mobile, auto);
}

.ag-hero-2--desktop-only .ag-hero-2__button {
  width: var(--button-width-desktop, auto);
  height: var(--button-height-desktop, auto);
}

.ag-hero-2__button-text {
  display: inline-block;
}

.ag-hero-2__button-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.ag-hero-2__button-icon svg {
  width: 20px;
  height: 20px;
}

.ag-hero-2__rating-container {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 12px;
  color: #000;
}

.ag-hero-2__stars-container {
  display: flex;
  align-items: center;
}

.ag-hero-2__rating-text {
  letter-spacing: 0.05em;
  line-height: 19px;
  text-transform: uppercase;
  text-decoration: none;
}

/* Rating stars styling */
.ag-hero-2 .rating-stars {
  display: flex;
  align-items: center;
}

.ag-hero-2 .rating-stars__star {
  display: inline-flex;
  margin-right: 2px;
}

.ag-hero-2 .rating-stars__star--filled {
  color: var(--star-color, #FFD700);
}

.ag-hero-2 .rating-stars__star--half path {
  stroke: var(--star-color, #FFD700);
}

.ag-hero-2 .rating-stars__star--empty {
  color: rgba(0, 0, 0, 0.2);
}

