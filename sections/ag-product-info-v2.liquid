{{ 'ag-product-info.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ag-product-info.js' | asset_url }}" defer></script>

{%- if section.settings.load_google_fonts -%}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,700&family=Instrument+Serif&display=swap" rel="stylesheet">
{%- endif -%}

{%- liquid
  assign s = section.settings

  assign ag_product = closest.product
  if ag_product == blank
    assign ag_product = product
  endif
  assign current_variant = ag_product.selected_or_first_available_variant

  assign tier_blocks = section.blocks | where: 'type', 'tier'
  assign gift_blocks = section.blocks | where: 'type', 'gift'
  assign check_blocks = section.blocks | where: 'type', 'benefit_check'
  assign trust_blocks = section.blocks | where: 'type', 'trust_item'
  assign press_blocks = section.blocks | where: 'type', 'press_logo'
  assign faq_blocks = section.blocks | where: 'type', 'faq_item'
  assign side_card_blocks = section.blocks | where: 'type', 'side_card'
  assign videos_blocks = section.blocks | where: 'type', 'videos'

  assign display_title = s.custom_title | default: ag_product.title
  assign show_side_cards = false
  if side_card_blocks.size > 0
    assign show_side_cards = true
  endif

  assign default_tier = tier_blocks | first
  for block in tier_blocks
    if block.settings.preselect
      assign default_tier = block
      break
    endif
  endfor

  assign default_qty = 1
  assign default_total_cents = current_variant.price
  if default_tier
    assign default_qty = default_tier.settings.qty | default: 1
    assign default_total_cents = 100 | minus: default_tier.settings.discount | times: current_variant.price | divided_by: 100.0 | round | times: default_qty
  endif
  assign default_total = default_total_cents | money_without_trailing_zeros
  if current_variant.compare_at_price > current_variant.price
    assign default_compare_cents = current_variant.compare_at_price | times: default_qty
  else
    assign default_compare_cents = current_variant.price | times: default_qty
  endif
  assign default_compare = default_compare_cents | money_without_trailing_zeros

  assign gift_ids = ''
  for block in gift_blocks
    assign gp = block.settings.gift_product
    if gp != blank and gp.selected_or_first_available_variant != blank
      assign gift_ids = gift_ids | append: gp.selected_or_first_available_variant.id | append: ','
    endif
  endfor
  assign gift_ids_json = gift_ids | split: ',' | json
-%}

<style>
  #shopify-section-{{ section.id }} .ag-pinfo--v2 {
    {%- if s.color_bg != blank %}--ag-bg: {{ s.color_bg }};{% endif -%}
    {%- if s.color_text_primary != blank %}--ag-text-primary: {{ s.color_text_primary }}; --ag-text-heading: {{ s.color_text_primary }};{% endif -%}
    {%- if s.color_text_secondary != blank %}--ag-text-secondary: {{ s.color_text_secondary }};{% endif -%}
    {%- if s.color_accent != blank %}--ag-accent: {{ s.color_accent }};{% endif -%}
    {%- if s.color_accent_dark != blank %}--ag-accent-dark: {{ s.color_accent_dark }};{% endif -%}
    {%- if s.color_accent_text != blank %}--ag-accent-text: {{ s.color_accent_text }};{% endif -%}
    {%- if s.color_terra != blank %}--ag-terra: {{ s.color_terra }};{% endif -%}
    {%- if s.color_card_bg != blank %}--ag-card-bg: {{ s.color_card_bg }};{% endif -%}
    {%- if s.color_card_border != blank %}--ag-card-border: {{ s.color_card_border }}; --ag-line: {{ s.color_card_border }};{% endif -%}
    {%- if s.color_card_selected_bg != blank %}--ag-card-selected-bg: {{ s.color_card_selected_bg }};{% endif -%}
    {%- if s.color_card_selected_border != blank %}--ag-card-selected-border: {{ s.color_card_selected_border }};{% endif -%}
  }
  /* CTA — direct write, bypasses CSS var indirection to guarantee a visible background. */
  #shopify-section-{{ section.id }} .ag-pinfo--v2 .ag-cta {
    background: {{ s.cta_bg | default: '#3b5333' }};
    color: {{ s.cta_text_color | default: '#f6f2e8' }};
    {%- if s.cta_radius != blank %}border-radius: {{ s.cta_radius }}px;{% endif -%}
    {%- if s.cta_font != blank %}font-family: {{ s.cta_font.family }}, {{ s.cta_font.fallback_families }};{% endif -%}
  }
  {%- if s.cta_font != blank %}{{ s.cta_font | font_face: font_display: 'swap' }}{% endif -%}
  {%- if s.section_bg != blank %}
  #shopify-section-{{ section.id }} .ag-pinfo--v2 { background: {{ s.section_bg }}; }
  {%- endif %}
  {%- if s.cta_text_gradient != blank %}
  #shopify-section-{{ section.id }} .ag-pinfo--v2 .ag-cta__label {
    background: {{ s.cta_text_gradient }};
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  {%- endif %}
</style>

<section
  class="ag-pinfo ag-pinfo--v2"
  data-section-id="{{ section.id }}"
  data-product-id="{{ ag_product.id }}"
  data-money-format="{{ shop.money_format | escape }}"
  data-show-cta-price="{% if s.show_price_on_cta %}true{% else %}false{% endif %}"
  data-gift-variant-ids="{{ gift_ids_json | escape }}"
>
  <div class="ag-pinfo__inner">
    <div class="ag-grid">
      <div class="ag-gallery">
        <div class="ag-gallery__hero{% if show_side_cards %} ag-gallery__hero--with-cards{% endif %}">
          <div class="ag-gallery__main" data-ag-main-image data-ag-lightbox-open>
            {%- if s.image_badge_text != blank -%}
              <span class="ag-gallery__label">{{ s.image_badge_text }}</span>
            {%- endif -%}
            {%- if s.image_badge2_text != blank -%}
              <span class="ag-gallery__badge2">{{ s.image_badge2_text }}</span>
            {%- endif -%}
            {%- if ag_product.featured_image -%}
              {{ ag_product.featured_image | image_url: width: 1242 | image_tag: loading: 'eager', alt: ag_product.featured_image.alt | default: display_title }}
            {%- else -%}
              <div class="ag-gallery__placeholder">{{ 'product-2' | placeholder_svg_tag }}</div>
            {%- endif -%}
          </div>

          {%- if show_side_cards -%}
            <div class="ag-side-cards" aria-label="Key benefits">
              {%- for block in side_card_blocks limit: 3 -%}
                <div class="ag-side-card" {{ block.shopify_attributes }}>
                  <span class="ag-side-card__icon" aria-hidden="true">{{ block.settings.icon }}</span>
                  <span class="ag-side-card__label">{{ block.settings.label }}</span>
                </div>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>

        {%- if ag_product.images.size > 0 -%}
          <div class="ag-thumbs" data-ag-thumbs>
            <button type="button" class="ag-thumbs__arrow ag-thumbs__arrow--prev" data-ag-thumbs-prev aria-label="Previous" hidden>‹</button>
            <div class="ag-thumbs__track" data-ag-thumbs-track>
              {%- for image in ag_product.images -%}
                <button
                  type="button"
                  class="ag-thumb{% if forloop.first %} is-active{% endif %}"
                  data-media-src="{{ image | image_url: width: 1242 }}"
                  aria-label="{{ image.alt | default: display_title }}"
                >
                  {{ image | image_url: width: 240 | image_tag: loading: 'lazy', alt: image.alt | default: display_title }}
                </button>
              {%- endfor -%}
            </div>
            <button type="button" class="ag-thumbs__arrow ag-thumbs__arrow--next" data-ag-thumbs-next aria-label="Next" hidden>›</button>
          </div>
        {%- endif -%}

        {%- if s.review_text != blank -%}
          <div class="ag-review-card ag-desktop-only">
            <div class="ag-review-card__head">
              <span class="ag-review-card__stars" aria-hidden="true">★★★★★</span>
              <span class="ag-review-card__name">{{ s.review_name }}</span>
              {%- if s.review_verified_label != blank -%}
                <span class="ag-review-card__verified">{{ s.review_verified_label }}</span>
              {%- endif -%}
            </div>
            <p class="ag-review-card__text">{{ s.review_text }}</p>
          </div>
        {%- endif -%}
      </div>

      <div class="ag-buycol">
        {%- if s.product_eyebrow != blank -%}
          <p class="ag-eyebrow">{{ s.product_eyebrow }}</p>
        {%- endif -%}

        <h1 class="ag-title">{{ display_title }}</h1>

        {%- if s.rating_text != blank or s.reviews_text != blank -%}
          <div class="ag-rating ag-rating--badge">
            {%- if s.rating_text != blank -%}
              <span class="ag-rating__stars">{{ s.rating_text }}</span>
            {%- endif -%}
            {%- if s.reviews_text != blank -%}
              <span class="ag-rating__count">{{ s.reviews_text }}</span>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if s.custom_description != blank -%}
          <p class="ag-desc">{{ s.custom_description }}</p>
        {%- elsif ag_product.description != blank -%}
          <div class="ag-desc">{{ ag_product.description | strip_html | truncatewords: 45 }}</div>
        {%- endif -%}

        {%- if check_blocks.size > 0 -%}
          <div class="ag-checks">
            {%- for block in check_blocks -%}
              <div class="ag-check" {{ block.shopify_attributes }}>
                <span class="ag-check__icon" aria-hidden="true">✓</span>
                <span>{{ block.settings.text }}</span>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- form 'product', ag_product, data-ag-product-form: 'true' -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}">
          <input type="hidden" name="quantity" value="{{ default_qty }}">

          <div class="ag-buybox">
            {%- if s.buybox_title != blank -%}
              <h2 class="ag-buybox__title">{{ s.buybox_title }}</h2>
            {%- endif -%}

            {% render 'ag-pinfo-qty-breaks', product: ag_product, section: section %}

            {%- if gift_blocks.size > 0 -%}
              <div class="ag-gifts-table">
                <div class="ag-gifts-header">
                  <span>{{ s.gifts_header_label }}</span>
                  <span>{{ s.gifts_value_label }}</span>
                </div>
                {%- for block in gift_blocks -%}
                  {%- assign gp = block.settings.gift_product -%}
                  <div class="ag-gift-row" {{ block.shopify_attributes }}>
                    <span class="ag-gift-badge">{{ s.gifts_free_label | default: 'FREE' }}</span>
                    <span class="ag-gift-label">{{ block.settings.gift_label | default: gp.title }}</span>
                    <span class="ag-gift-value">{{ block.settings.gift_value }}</span>
                  </div>
                {%- endfor -%}
                <div class="ag-gifts-total">
                  <span class="ag-gifts-total__badge">
                    {{- s.gifts_total_prefix }} <span data-ag-price>{{ default_total }}</span> {{ s.gifts_total_suffix -}}
                  </span>
                  <span class="ag-gifts-total__prices">
                    <span class="ag-gifts-total__compare" data-ag-compare>
                      {%- if default_compare_cents > default_total_cents %}{{ default_compare }}{% endif -%}
                    </span>
                    <span class="ag-gifts-total__price" data-ag-price>{{ default_total }}</span>
                  </span>
                </div>
              </div>
            {%- endif -%}
          </div>

          <div class="ag-native-blocks">
            {%- for block in section.blocks -%}
              {%- case block.type -%}
                {%- when 'ag_reviews_carousel' -%}
                  {% render 'ag-pinfo-reviews-carousel', block: block, section: section %}
                {%- when 'ag_rating_summary' -%}
                  {% render 'ag-pinfo-rating-summary', block: block, section: section %}
                {%- when 'ag_stock_notification' -%}
                  {% render 'ag-pinfo-stock-notification', block: block, section: section %}
                {%- when 'ag_shipping_info' -%}
                  {% render 'ag-pinfo-shipping-info', block: block, section: section %}
                {%- when 'ag_social_proof' -%}
                  {% render 'ag-pinfo-social-proof', block: block, section: section %}
                {%- when 'ag_product_benefits' -%}
                  {% render 'ag-pinfo-product-benefits', block: block, section: section %}
              {%- endcase -%}
            {%- endfor -%}
            {% content_for 'blocks' %}
          </div>

          <button type="submit" name="add" class="ag-cta" data-ag-main-cta>
            <span class="ag-cta__label">{{ s.cta_text | default: 'Get Started Today' }}</span>
            <span class="ag-cta__price" data-ag-cta-price{% unless s.show_price_on_cta %} hidden{% endunless %}>{{ default_total }}</span>
          </button>
          <p class="ag-cta-error" data-ag-cta-error hidden></p>

          {%- for block in videos_blocks -%}
            {% render 'ag-pinfo-videos', block: block, section: section %}
          {%- endfor -%}

          {%- if s.cta_subtext != blank -%}
            <p class="ag-cta-sub">{{ s.cta_subtext }}</p>
          {%- endif -%}
        {%- endform -%}

        {%- if trust_blocks.size > 0 -%}
          <div class="ag-trust">
            {%- for block in trust_blocks -%}
              <div class="ag-trust__item" {{ block.shopify_attributes }}>
                <span class="ag-trust__icon" aria-hidden="true">{{ block.settings.icon }}</span>
                <span class="ag-trust__label">{{ block.settings.label }}</span>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>

    {%- if press_blocks.size > 0 -%}
      <div class="ag-press">
        {%- if s.press_title != blank -%}
          <span class="ag-press__title">{{ s.press_title }}</span>
        {%- endif -%}
        {%- for block in press_blocks -%}
          <span class="ag-press__logo" {{ block.shopify_attributes }}>{{ block.settings.name }}</span>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if s.doctor_quote_text != blank -%}
      <div class="ag-quote ag-doctor-quote">
        <span class="ag-quote__mark" aria-hidden="true">&ldquo;</span>
        <div class="ag-quote__body">
          <p class="ag-quote__text">{{ s.doctor_quote_text }}</p>
          <div class="ag-quote__person">
            <span class="ag-quote__avatar">
              {%- if s.doctor_image != blank -%}
                {{ s.doctor_image | image_url: width: 96, height: 96, crop: 'center' | image_tag: loading: 'lazy', alt: s.doctor_name | default: '' }}
              {%- endif -%}
            </span>
            <span>
              <strong class="ag-quote__name">{{ s.doctor_name }}</strong>
              <span class="ag-quote__role">{{ s.doctor_title }}</span>
            </span>
          </div>
        </div>
      </div>
    {%- endif -%}

    {%- if faq_blocks.size > 0 -%}
      <div class="ag-faq">
        <h2 class="ag-faq__title">{{ s.faq_title | default: 'Questions, answered' }}</h2>
        <div class="ag-faq__list">
          {%- for block in faq_blocks -%}
            <div class="ag-faq-item{% if forloop.first %} is-open{% endif %}" {{ block.shopify_attributes }}>
              <button
                type="button"
                class="ag-faq-btn"
                aria-expanded="{% if forloop.first %}true{% else %}false{% endif %}"
                aria-controls="ag-faq-{{ section.id }}-{{ forloop.index }}"
              >
                <span class="ag-faq-btn__q">{{ block.settings.question }}</span>
                <span class="ag-faq-btn__icon" aria-hidden="true">{% if forloop.first %}—{% else %}+{% endif %}</span>
              </button>
              <div class="ag-faq-answer" id="ag-faq-{{ section.id }}-{{ forloop.index }}">
                <div class="ag-faq-answer__inner">
                  <p>{{ block.settings.answer }}</p>
                </div>
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>

  {%- if ag_product.images.size > 1 -%}
    <dialog class="ag-lightbox" data-ag-lightbox aria-label="Product gallery">
      <button type="button" class="ag-lightbox__close" data-ag-lightbox-close aria-label="Close">×</button>
      <div class="ag-lightbox__track">
        {%- for image in ag_product.images -%}
          <div class="ag-lightbox__slide">
            {{ image | image_url: width: 1400 | image_tag: loading: 'lazy', alt: image.alt | default: display_title }}
          </div>
        {%- endfor -%}
      </div>
    </dialog>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "AG Product Info V2",
  "tag": "section",
  "class": "ag-section-product-info",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    { "type": "header", "content": "Couleurs" },
    { "type": "color", "id": "color_bg", "label": "Fond de section", "default": "#faf3e8" },
    { "type": "color_background", "id": "section_bg", "label": "Fond de section (gradient)", "info": "Couleur ou dégradé. Override le fond de section." },
    { "type": "color", "id": "color_text_primary", "label": "Texte principal", "default": "#3b3128" },
    { "type": "color", "id": "color_text_secondary", "label": "Texte secondaire", "default": "#796e60" },
    { "type": "color", "id": "color_accent", "label": "Accent sage", "default": "#5e7c54" },
    { "type": "color", "id": "color_accent_dark", "label": "Accent foncé", "default": "#3b5333" },
    { "type": "color", "id": "color_accent_text", "label": "Texte sur accent", "default": "#ffffff" },
    { "type": "color", "id": "color_terra", "label": "Accent terra", "default": "#bd6a45" },
    { "type": "color", "id": "color_card_bg", "label": "Fond card", "default": "#fffdf9" },
    { "type": "color", "id": "color_card_border", "label": "Bordure card", "default": "#e8ddca" },
    { "type": "color", "id": "color_card_selected_bg", "label": "Fond card sélectionnée", "default": "#f3f7ee" },
    { "type": "color", "id": "color_card_selected_border", "label": "Bordure card sélectionnée", "default": "#5e7c54" },
    { "type": "header", "content": "Contenu produit" },
    { "type": "text", "id": "product_eyebrow", "label": "Eyebrow", "default": "DAILY GREENS RITUAL" },
    { "type": "text", "id": "custom_title", "label": "Titre personnalisé" },
    { "type": "textarea", "id": "custom_description", "label": "Description personnalisée" },
    { "type": "text", "id": "rating_text", "label": "Note", "default": "★★★★★" },
    { "type": "text", "id": "reviews_text", "label": "Nombre d'avis", "default": "4.9 · 1,850+ reviews" },
    { "type": "text", "id": "image_badge_text", "label": "Badge image haut", "default": "+3 free gifts" },
    { "type": "text", "id": "image_badge2_text", "label": "Badge image bas", "default": "★ Best tasting matcha 2024" },
    { "type": "header", "content": "Hero side cards" },
    { "type": "paragraph", "content": "Ajoutez des blocs « Side card (hero) » ci-dessous pour les afficher à côté de l'image principale." },
    { "type": "header", "content": "Buy box" },
    { "type": "text", "id": "buybox_title", "label": "Titre", "default": "Choose your pack" },
    { "type": "header", "content": "Free gifts" },
    { "type": "text", "id": "gifts_header_label", "label": "En-tête", "default": "ORDER NOW & RECEIVE FREE GIFTS" },
    { "type": "text", "id": "gifts_value_label", "label": "Colonne valeur", "default": "VALUE" },
    { "type": "text", "id": "gifts_free_label", "label": "Badge FREE", "default": "FREE" },
    { "type": "text", "id": "gifts_total_prefix", "label": "Total — préfixe", "default": "JUST" },
    { "type": "text", "id": "gifts_total_suffix", "label": "Total — suffixe", "default": "TODAY" },
    { "type": "header", "content": "CTA — contenu" },
    { "type": "text", "id": "cta_text", "label": "Texte CTA", "default": "Get Started Today" },
    { "type": "checkbox", "id": "show_price_on_cta", "label": "Afficher le prix sur le bouton", "default": true },
    { "type": "textarea", "id": "cta_subtext", "label": "Sous-texte CTA", "default": "Free shipping on orders over $50 · Cancel anytime" },
    { "type": "header", "content": "CTA — style" },
    { "type": "color_background", "id": "cta_bg", "label": "Fond bouton (couleur ou gradient)" },
    { "type": "color", "id": "cta_text_color", "label": "Couleur texte bouton" },
    { "type": "color_background", "id": "cta_text_gradient", "label": "Texte en gradient (optionnel)" },
    { "type": "range", "id": "cta_radius", "label": "Arrondi bouton", "min": 0, "max": 40, "step": 1, "unit": "px", "default": 18 },
    { "type": "font_picker", "id": "cta_font", "label": "Police bouton", "default": "helvetica_n4" },
    { "type": "header", "content": "Avis (colonne gauche)" },
    { "type": "text", "id": "review_name", "label": "Nom", "default": "Diane D." },
    { "type": "text", "id": "review_verified_label", "label": "Label vérifié", "default": "✓ Verified" },
    { "type": "textarea", "id": "review_text", "label": "Texte" },
    { "type": "header", "content": "Press strip" },
    { "type": "text", "id": "press_title", "label": "Titre", "default": "Featured & loved by" },
    { "type": "header", "content": "Citation expert" },
    { "type": "textarea", "id": "doctor_quote_text", "label": "Citation" },
    { "type": "text", "id": "doctor_name", "label": "Nom" },
    { "type": "text", "id": "doctor_title", "label": "Titre / Fonction" },
    { "type": "image_picker", "id": "doctor_image", "label": "Photo" },
    { "type": "header", "content": "FAQ" },
    { "type": "text", "id": "faq_title", "label": "Titre FAQ", "default": "Questions, answered" },
    { "type": "header", "content": "Avancé" },
    { "type": "checkbox", "id": "load_google_fonts", "label": "Charger Google Fonts (DM Sans + Instrument Serif)", "default": true }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Pack (Quantity Break)",
      "settings": [
        { "type": "header", "content": "Config" },
        { "type": "range", "id": "qty", "label": "Quantité", "min": 1, "max": 12, "default": 1 },
        { "type": "range", "id": "discount", "label": "Remise", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 0 },
        { "type": "checkbox", "id": "preselect", "label": "Sélectionné par défaut", "default": false },
        { "type": "text", "id": "discount_code", "label": "Code promo Shopify (optionnel)", "info": "Créé dans Réductions. Appliqué au panier à l'ajout." },
        { "type": "header", "content": "Textes", "info": "Placeholders : [qty] [discount] [item_price] [total_price]" },
        { "type": "text", "id": "title", "label": "Titre", "default": "Starter" },
