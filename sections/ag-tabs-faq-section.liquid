{% comment %} ag-tabs-faq-section.liquid — propriété de James Sparks {% endcomment %}
<style>
  .container-{{section.id}} {
      position: relative;
      line-height: 1.5;
      color: #393939;
      margin: 0 auto;
      margin-top: {{ section.settings.margin_top }}px;
      margin-bottom: {{ section.settings.margin_bottom }}px;
      padding: 10px;
      {% if section.settings.full_width %}width: 100%{% else %}max-width: 1200px;{% endif %}
      background-color: {{ section.settings.background }};
      border-radius: {{ section.settings.border_radius }}px;
      border: {{ section.settings.border_width }}px {{ section.settings.border_style }} {{ section.settings.border_color }};
  }

  .container-{{section.id}} .menu-container {
      position: sticky;
      top: 0;
      left: 0;
      right: 0;
      padding: 6px 10px;
      z-index: 1000;
  }

  .container-{{section.id}} .menu-container h2 {
      color: {{ section.settings.title_color }};
      font-size: {{ section.settings.section_title_font_size }}px;
      margin-bottom: 20px;
      text-align: center;
  }

  .container-{{section.id}} .menu-container .menu {
      display: flex;
      justify-content: center;
      gap: 10px;
      width: 100%;
      max-width: 1000px;
      margin: 0 auto;
      overflow-x: auto;
  }

  .container-{{section.id}} .menu-container .menu .menu-item-{{section.id}} {
      white-space: nowrap;
      padding: 8px 16px;
      border: 1px solid {{ section.settings.tab_inactive_border_color }};
      border-radius: {{ section.settings.tab_inactive_border_radius }}px;
      cursor: pointer;
      transition: all 0.3s ease;
      font-size: {{ section.settings.tab_title_font_size }}px;
      font-weight: {{ section.settings.tab_title_font_weight }};
      background: {{ section.settings.tab_inactive_background_color }};
      color: {{ section.settings.tab_title_color }};
  }

  .container-{{section.id}} .menu-container .menu .menu-item-{{section.id}}.active-{{section.id}} {
      border: 1px solid {{ section.settings.tab_active_border_color }};
      border-radius: {{ section.settings.tab_active_border_radius }}px;
      color: {{ section.settings.tab_title_active_color }};
      background: {{ section.settings.tab_active_background_color }};
  }

  .container-{{section.id}} .faq-container {
      display: flex;
      flex-direction: column;
      gap: 15px;
      width: 90%;
      margin: 0 auto;
      margin-top: 1em;
  }

  .container-{{section.id}} .faq-container .faq-item-{{section.id}} {
      border-bottom: 1px solid #eee;
  }

  .container-{{section.id}} .faq-container .faq-item-{{section.id}}.hidden {
      display: none;
  }

  .container-{{section.id}} .faq-container .faq-item-{{section.id}} .faq-question-{{section.id}} {
      width: 100%;
      text-align: left;
      padding: 20px 40px 20px 0;
      position: relative;
      border: none;
      font-weight: {{ section.settings.question_font_weight }};
      background: none;
      cursor: pointer;
      color: {{ section.settings.question_color }};
      font-size: {{ section.settings.question_font_size }}px;
      transition: color 0.2s ease;
  }

  .container-{{section.id}} .faq-container .faq-item-{{section.id}} .faq-question-{{section.id}} .icon-plus-minus {
      position: absolute;
      right: 10px;
      top: 50%;
      transform: translateY(-50%);
      width: 20px;
      height: 20px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: {{ section.settings.question_icon_color }};
  }

  .container-{{section.id}} .faq-container .faq-item-{{section.id}} .faq-question-{{section.id}} .icon-plus-minus::before,
  .container-{{section.id}} .faq-container .faq-item-{{section.id}} .faq-question-{{section.id}} .icon-plus-minus::after {
      content: '';
      position: absolute;
      background-color: {{ section.settings.question_icon_color }};
      transition: all 0.2s ease;
  }

  .container-{{section.id}} .faq-container .faq-item-{{section.id}} .faq-question-{{section.id}} .icon-plus-minus::before {
      width: 16px;
      height: 2px;
  }

  .container-{{section.id}} .faq-container .faq-item-{{section.id}} .faq-question-{{section.id}} .icon-plus-minus::after {
      width: 2px;
      height: 16px;
  }

  .container-{{section.id}} .faq-container .faq-item-{{section.id}}.active-{{section.id}} .icon-plus-minus::after {
      transform: rotate(90deg) scale(0);
  }

  .container-{{section.id}} .faq-container .faq-item-{{section.id}} .faq-answer {
      max-height: 0;
      overflow: hidden;
      transition: all 0.5s ease;
      opacity: 0;
      transform: translateY(-10px);
      padding: 0 40px 0 0;
      color: {{ section.settings.answer_color }};
      font-size: {{ section.settings.answer_font_size }}px;
  }

  .container-{{section.id}} .faq-container .faq-item-{{section.id}}.active-{{section.id}} .faq-answer {
      max-height: 300px;
      opacity: 1;
      transform: translateY(0);
      padding-bottom: 20px;
  }

  .container-{{section.id}} .faq-container .faq-item-{{section.id}} .faq-answer a {
      color: #000;
  }

  @media (max-width: 768px) {
      .container-{{section.id}} .menu-container h2 {
          font-size: {{section.settings.tab_header_font_size_mobile }}px !important;
          text-align: center;
      }
      .container-{{section.id}} .menu-container .menu-item-{{section.id}} {
          font-size: {{section.settings.tab_font_size_mobile }}px !important;
          text-align: left;
      }
      .container-{{section.id}} .menu-container .menu {
          padding-left: 0 !important;
          padding-bottom: 1em;
      }
      .container-{{section.id}} .faq-container {
          width: 100%;
      }
      .container-{{section.id}} .faq-container .faq-question-{{section.id}} {
          font-size: {{section.settings.tab_text_font_size_mobile}}px;
          padding-right: 30px;
      }
      .container-{{section.id}} .faq-container .faq-item-{{section.id}} .faq-answer {
          overflow-y: auto;
          font-size: {{section.settings.tab_text_font_size_mobile}}px;
      }
  }

  @media (max-width: 600px) {
      .container-{{section.id}} .menu-container .menu {
          padding-bottom: 1em;
      }
  }

  @media (max-width: 530px) {
      .container-{{section.id}} .menu-container .menu {
          padding-bottom: 1em;
      }
  }

  @media (max-width: 475px) {
      .container-{{section.id}} .menu-container .menu {
          padding-bottom: 1em;
      }
  }

  @media (max-width: 400px) {
      .container-{{section.id}} .menu-container .menu {
          padding-bottom: 1em;
      }
  }
</style>

<div id="ag-tabs-faq-{{ section.id }}" class="container-{{section.id}}">
  <div class="menu-container">
    <h2>{{ section.settings.title }}</h2>
    <div class="menu">
      {% for block in section.blocks %}
        {% if block.type == 'menu_item' %}
          {% assign category_id = block.settings.category | handleize %}
          <div class="menu-item-{{section.id}}" data-category="{{ category_id }}">
            {{ block.settings.category }}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
  <div class="faq-container">
    {% for block in section.blocks %}
      {% if block.type == 'faq_item' %}
        {% assign category_id = block.settings.category | handleize %}
        <div class="faq-item-{{section.id}}" data-category="{{ category_id }}">
          <div class="faq-question-{{section.id}}">{{ block.settings.question }}
            <span class="icon-plus-minus"></span>
          </div>
          <div class="faq-answer">{{ block.settings.answer }}</div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</div>

