{% comment %} ag-adv-press-bar.liquid — propriété de James Sparks {% endcomment %}
{% render 'ag-adv-schema-head' %}

{%- capture ag_vars -%}
  {%- if section.settings.ag_bg != blank -%}--ag-section-bg:{{ section.settings.ag_bg }};{%- endif -%}
  {%- if section.settings.ag_radius and section.settings.ag_radius > 0 -%}--ag-section-radius:{{ section.settings.ag_radius }}px;{%- endif -%}
  {%- if section.settings.ag_accent != blank -%}--ag-section-accent:{{ section.settings.ag_accent }};{%- endif -%}
  {%- if section.settings.ag_accent_soft != blank -%}--ag-section-accent-soft:{{ section.settings.ag_accent_soft }};{%- endif -%}
{%- endcapture -%}
{%- capture ag_root_style -%}{% if section.settings.ag_bg != blank %}background:{{ section.settings.ag_bg }};{% endif %}{{ ag_vars }}{%- endcapture -%}


<div class="ag-adv spacing-style" style="{% render 'spacing-style', settings: section.settings %}{{ ag_root_style }}">
  <div class="ag-adv__wrap">
    <section class="ag-adv-press">
      {%- if section.settings.label != blank -%}
        <div class="ag-adv-press__label">{{ section.settings.label }}</div>
      {%- endif -%}
      <div class="ag-adv-press__row">
        {%- for block in section.blocks -%}
          {%- if block.type == 'press' -%}
            <div class="ag-adv-press__logo" {{ block.shopify_attributes }}>
              {%- if block.settings.logo != blank -%}
                <img src="{{ block.settings.logo | image_url: height: 56 }}" alt="{{ block.settings.name | escape }}" loading="lazy">
              {%- else -%}
                <span class="ag-adv-press__name">{{ block.settings.name }}</span>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </section>
  </div>
</div>

{% schema %}
{
  "name": "AG Adv — Press Bar",
  "enabled_on": {
    "templates": [
      "page"
    ]
  },
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Texte d'introduction",
      "default": "As Featured In"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Couleur de fond",
      "default": "#f5f7f5"
    },
    {
      "type": "header",
      "content": "Apparence personnalisée"
    },
    {
      "type": "color_background",
      "id": "ag_bg",
      "label": "Fond de la section",
      "info": "Override le fond. Supporte solide ou dégradé."
    },
    {
      "type": "range",
      "id": "ag_radius",
      "label": "Radius des éléments (px)",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0,
      "info": "0 = utilise la valeur par défaut du design"
    },
    {
      "type": "color",
      "id": "ag_accent",
      "label": "Couleur d'accent",
      "info": "Mots highlighted, eyebrow, badges, icônes, étoiles, etc."
    },
    {
      "type": "color",
      "id": "ag_accent_soft",
      "label": "Couleur d'accent — pastilles soft",
      "info": "Fond des pills, icônes douces, badges légers"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Padding haut",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Padding bas",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "press",
      "name": "Logo presse",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Nom du média (alt text)",
          "default": "Media name"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "AG Adv — Press Bar",
      "blocks": [
        {
          "type": "press",
          "settings": {
            "name": "Forbes"
          }
        },
        {
          "type": "press",
          "settings": {
            "name": "Vogue"
          }
        },
        {
          "type": "press",
          "settings": {
            "name": "Wired"
          }
        },
        {
          "type": "press",
          "settings": {
            "name": "Goop"
          }
        },
        {
          "type": "press",
          "settings": {
            "name": "Well+Good"
          }
        }
      ]
    }
  ],
  "tag": "section",
  "class": "ag-adv-section"
}
{% endschema %}
