{{ 'neon-product-support.css' | asset_url | stylesheet_tag }}

{% if section.blocks.size > 0 %}
  <section class="ns-support-section">
    <div class="ns-support ns-services" aria-labelledby="NeonServices-{{ section.id }}">
      <header class="ns-support__heading">
        {% if section.settings.kicker != blank %}<p>{{ section.settings.kicker }}</p>{% endif %}
        <h2 id="NeonServices-{{ section.id }}">{{ section.settings.heading }}</h2>
        {% if section.settings.intro != blank %}<div class="rte">{{ section.settings.intro }}</div>{% endif %}
      </header>
      <div class="ns-services__grid">
        {% for block in section.blocks %}
          <article class="ns-services__card" {{ block.shopify_attributes }}>
            {% if block.settings.marker != blank %}<span class="ns-services__icon" aria-hidden="true">{{ block.settings.marker }}</span>{% endif %}
            {% if block.settings.heading != blank %}<h3>{{ block.settings.heading }}</h3>{% endif %}
            {% if block.settings.content != blank %}<div class="rte">{{ block.settings.content }}</div>{% endif %}
          </article>
        {% endfor %}
      </div>
    </div>
  </section>
{% endif %}

{% schema %}
{
  "name": "Produit · repères d’achat",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Sur-titre", "default": "REPÈRES D’ACHAT" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Les informations utiles avant de choisir" },
    { "type": "richtext", "id": "intro", "label": "Introduction", "default": "<p>Présentez ici uniquement les informations confirmées pour ce produit et votre boutique.</p>" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Repère",
      "limit": 8,
      "settings": [
        { "type": "text", "id": "marker", "label": "Repère court", "default": "01" },
        { "type": "text", "id": "heading", "label": "Titre", "default": "État et contenu" },
        { "type": "richtext", "id": "content", "label": "Contenu", "default": "<p>Décrivez l’état observé et les éléments effectivement inclus.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Produit · repères d’achat",
      "blocks": [
        { "type": "item", "settings": { "marker": "01", "heading": "État et contenu", "content": "<p>Décrivez l’état observé et les éléments effectivement inclus.</p>" } },
        { "type": "item", "settings": { "marker": "02", "heading": "Format et compatibilité", "content": "<p>Indiquez les dimensions ou accessoires compatibles lorsqu’ils sont confirmés.</p>" } },
        { "type": "item", "settings": { "marker": "03", "heading": "Livraison", "content": "<p>Précisez le mode de protection et les options d’envoi disponibles.</p>" } },
        { "type": "item", "settings": { "marker": "04", "heading": "Conservation", "content": "<p>Ajoutez des conseils adaptés au matériau et au type de produit.</p>" } }
      ]
    }
  ]
}
{% endschema %}
