{% comment %} ag-adv-header.liquid — propriété de James Sparks {% endcomment %}
{% render 'ag-adv-schema-head' %}

{%- capture ag_vars -%}
  {%- if section.settings.ag_bg != blank -%}--ag-section-bg:{{ section.settings.ag_bg }};{%- endif -%}
  {%- if section.settings.ag_radius and section.settings.ag_radius > 0 -%}--ag-section-radius:{{ section.settings.ag_radius }}px;{%- endif -%}
  {%- if section.settings.ag_accent != blank -%}--ag-section-accent:{{ section.settings.ag_accent }};{%- endif -%}
  {%- if section.settings.ag_accent_soft != blank -%}--ag-section-accent-soft:{{ section.settings.ag_accent_soft }};{%- endif -%}
{%- endcapture -%}
{%- capture ag_root_style -%}{% if section.settings.ag_bg != blank %}background:{{ section.settings.ag_bg }};{% endif %}{{ ag_vars }}{%- endcapture -%}


{%- liquid
  assign brand   = section.settings.media_name
  assign category = section.settings.category
  assign date    = section.settings.date
  assign logo    = section.settings.logo
  assign show_nav = section.settings.show_nav
  assign cta_text = section.settings.cta_text
  assign cta_link = section.settings.cta_link
-%}

<div class="ag-adv spacing-style" style="{% render 'spacing-style', settings: section.settings %}{{ ag_root_style }}">
  <header class="ag-adv-header"{% if section.settings.border_color != blank %} style="border-bottom-color: {{ section.settings.border_color }};"{% endif %}>
    <div class="ag-adv-header__in">

      <a class="ag-adv__brand" href="{{ shop.url }}">
        <span class="ag-adv__brand-mark">
          {%- if logo != blank -%}
            <img src="{{ logo | image_url: width: 80 }}" alt="{{ brand | escape }}">
          {%- else -%}
            {{ section.settings.brand_mark }}
          {%- endif -%}
        </span>
        <span>{{ brand }}</span>
      </a>

      {%- if show_nav -%}
        <nav class="ag-adv-header__nav">
          {%- if section.settings.nav_1_label != blank -%}
            <a href="{{ section.settings.nav_1_link | default: '#' }}">{{ section.settings.nav_1_label }}</a>
          {%- endif -%}
          {%- if section.settings.nav_2_label != blank -%}
            <a href="{{ section.settings.nav_2_link | default: '#' }}">{{ section.settings.nav_2_label }}</a>
          {%- endif -%}
          {%- if section.settings.nav_3_label != blank -%}
            <a href="{{ section.settings.nav_3_link | default: '#' }}">{{ section.settings.nav_3_label }}</a>
          {%- endif -%}
        </nav>
      {%- endif -%}

      {%- if cta_text != blank -%}
        <a class="ag-adv-header__cta" href="{{ cta_link | default: '#offer' }}">{{ cta_text }}</a>
      {%- endif -%}

    </div>
  </header>

  {%- if category != blank or date != blank -%}
    <div class="ag-adv__wrap" style="padding-top:18px;">
      <div class="ag-adv__col" style="font-size:12.5px;color:var(--ag-adv-ink3);letter-spacing:.04em;text-transform:uppercase;font-weight:700;">
        {% if category != blank %}{{ category }}{% endif %}
        {% if category != blank and date != blank %} · {% endif %}
        {% if date != blank %}{{ date }}{% endif %}
      </div>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "AG Adv — Header",
  "enabled_on": {
    "templates": [
      "page"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "Identité du média"
    },
    {
      "type": "text",
      "id": "media_name",
      "label": "Nom du média / blog",
      "default": "The Wellness Journal"
    },
    {
      "type": "text",
      "id": "brand_mark",
      "label": "Caractère du logo (si pas d'image)",
      "info": "Un emoji ou une lettre. Ex: ☾, A, ✦",
      "default": "☾"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo (optionnel, remplace le caractère)"
    },
    {
      "type": "text",
      "id": "category",
      "label": "Catégorie",
      "default": "Health & Performance"
    },
    {
      "type": "text",
      "id": "date",
      "label": "Date de l'article",
      "default": "June 2, 2026"
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "checkbox",
      "id": "show_nav",
      "label": "Afficher la barre de navigation",
      "default": true
    },
    {
      "type": "text",
      "id": "nav_1_label",
      "label": "Lien 1 — Texte",
      "default": "Reviews"
    },
    {
      "type": "url",
      "id": "nav_1_link",
      "label": "Lien 1 — URL"
    },
    {
      "type": "text",
      "id": "nav_2_label",
      "label": "Lien 2 — Texte",
      "default": "How it works"
    },
    {
      "type": "url",
      "id": "nav_2_link",
      "label": "Lien 2 — URL"
    },
    {
      "type": "text",
      "id": "nav_3_label",
      "label": "Lien 3 — Texte",
      "default": "FAQ"
    },
    {
      "type": "url",
      "id": "nav_3_link",
      "label": "Lien 3 — URL"
    },
    {
      "type": "header",
      "content": "Bouton CTA"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Texte du bouton",
      "default": "Get 50% Off"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Lien du bouton"
    },
    {
      "type": "header",
      "content": "Apparence"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Couleur de fond",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Couleur de la bordure inférieure",
      "default": "#e7ebe7"
    },
    {
      "type": "header",
      "content": "Apparence personnalisée"
    },
    {
      "type": "color_background",
      "id": "ag_bg",
      "label": "Fond de la section",
      "info": "Override le fond. Supporte solide ou dégradé."
    },
    {
      "type": "range",
      "id": "ag_radius",
      "label": "Radius des éléments (px)",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0,
      "info": "0 = utilise la valeur par défaut du design"
    },
    {
      "type": "color",
      "id": "ag_accent",
      "label": "Couleur d'accent",
      "info": "Mots highlighted, eyebrow, badges, icônes, étoiles, etc."
    },
    {
      "type": "color",
      "id": "ag_accent_soft",
      "label": "Couleur d'accent — pastilles soft",
      "info": "Fond des pills, icônes douces, badges légers"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Padding haut",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Padding bas",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "AG Adv — Header"
    }
  ],
  "tag": "section",
  "class": "ag-adv-section"
}
{% endschema %}
