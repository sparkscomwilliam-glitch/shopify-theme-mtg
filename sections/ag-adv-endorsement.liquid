{% comment %} ag-adv-endorsement.liquid — propriété de James Sparks {% endcomment %}
{% render 'ag-adv-schema-head' %}

{%- capture ag_vars -%}
  {%- if section.settings.ag_bg != blank -%}--ag-section-bg:{{ section.settings.ag_bg }};{%- endif -%}
  {%- if section.settings.ag_radius and section.settings.ag_radius > 0 -%}--ag-section-radius:{{ section.settings.ag_radius }}px;{%- endif -%}
  {%- if section.settings.ag_accent != blank -%}--ag-section-accent:{{ section.settings.ag_accent }};{%- endif -%}
  {%- if section.settings.ag_accent_soft != blank -%}--ag-section-accent-soft:{{ section.settings.ag_accent_soft }};{%- endif -%}
{%- endcapture -%}
{%- capture ag_root_style -%}{% if section.settings.ag_bg != blank %}background:{{ section.settings.ag_bg }};{% endif %}{{ ag_vars }}{%- endcapture -%}


{%- liquid
  assign bg_style = section.settings.bg_style
  assign light_class = ''
  if bg_style == 'light'
    assign light_class = ' ag-adv-endorsement--light'
  endif
-%}

<div class="ag-adv spacing-style" style="{% render 'spacing-style', settings: section.settings %}{{ ag_root_style }}">
  <div class="ag-adv__wrap">
    <aside class="ag-adv-endorsement{{ light_class }}">
      {%- if section.settings.photo != blank -%}
        <img class="ag-adv-endorsement__img" src="{{ section.settings.photo | image_url: width: 240 }}" alt="{{ section.settings.name | escape }}" loading="lazy">
      {%- endif -%}
      <div>
        {%- if section.settings.quote != blank -%}
          <p class="ag-adv-endorsement__q">{{ section.settings.quote }}</p>
        {%- endif -%}
        <cite class="ag-adv-endorsement__cite">
          {{ section.settings.name }}
          {%- if section.settings.role != blank -%}<span>{{ section.settings.role }}</span>{%- endif -%}
        </cite>
        {%- if section.settings.attribution != blank -%}
          <div style="margin-top:8px;font-size:13px;opacity:.8;">{{ section.settings.attribution }}</div>
        {%- endif -%}
      </div>
    </aside>
  </div>
</div>

{% schema %}
{
  "name": "AG Adv — Endorsement",
  "enabled_on": {
    "templates": [
      "page"
    ]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "photo",
      "label": "Photo de l'expert / autorité"
    },
    {
      "type": "text",
      "id": "name",
      "label": "Nom",
      "default": "Dr. Elena Hart"
    },
    {
      "type": "text",
      "id": "role",
      "label": "Titre / rôle",
      "default": "Sleep Physiologist · 18 years in clinical research"
    },
    {
      "type": "richtext",
      "id": "quote",
      "label": "Citation",
      "default": "<p>A steady overnight release is exactly what a restless nervous system needs — and it's far gentler than sedating yourself to sleep.</p>"
    },
    {
      "type": "text",
      "id": "attribution",
      "label": "Attribution courte (optionnelle)"
    },
    {
      "type": "select",
      "id": "bg_style",
      "label": "Style de fond",
      "options": [
        {
          "value": "dark",
          "label": "Sombre (sage profond)"
        },
        {
          "value": "light",
          "label": "Clair (carte blanche)"
        }
      ],
      "default": "dark"
    },
    {
      "type": "header",
      "content": "Apparence personnalisée"
    },
    {
      "type": "color_background",
      "id": "ag_bg",
      "label": "Fond de la section",
      "info": "Override le fond. Supporte solide ou dégradé."
    },
    {
      "type": "range",
      "id": "ag_radius",
      "label": "Radius des éléments (px)",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0,
      "info": "0 = utilise la valeur par défaut du design"
    },
    {
      "type": "color",
      "id": "ag_accent",
      "label": "Couleur d'accent",
      "info": "Mots highlighted, eyebrow, badges, icônes, étoiles, etc."
    },
    {
      "type": "color",
      "id": "ag_accent_soft",
      "label": "Couleur d'accent — pastilles soft",
      "info": "Fond des pills, icônes douces, badges légers"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Padding haut",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Padding bas",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "AG Adv — Endorsement"
    }
  ],
  "tag": "section",
  "class": "ag-adv-section"
}
{% endschema %}
