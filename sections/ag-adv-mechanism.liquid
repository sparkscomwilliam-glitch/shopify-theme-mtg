{% comment %} ag-adv-mechanism.liquid — propriété de James Sparks {% endcomment %}
{% render 'ag-adv-schema-head' %}

{%- capture ag_vars -%}
  {%- if section.settings.ag_bg != blank -%}--ag-section-bg:{{ section.settings.ag_bg }};{%- endif -%}
  {%- if section.settings.ag_radius and section.settings.ag_radius > 0 -%}--ag-section-radius:{{ section.settings.ag_radius }}px;{%- endif -%}
  {%- if section.settings.ag_accent != blank -%}--ag-section-accent:{{ section.settings.ag_accent }};{%- endif -%}
  {%- if section.settings.ag_accent_soft != blank -%}--ag-section-accent-soft:{{ section.settings.ag_accent_soft }};{%- endif -%}
{%- endcapture -%}
{%- capture ag_root_style -%}{% if section.settings.ag_bg != blank %}background:{{ section.settings.ag_bg }};{% endif %}{{ ag_vars }}{%- endcapture -%}


{%- liquid
  assign style = section.settings.step_style
  assign cols_class = ''
  if style == 'columns'
    assign cols_class = ' ag-adv-mechanism__steps--cols'
  endif
-%}

<div class="ag-adv spacing-style" style="{% render 'spacing-style', settings: section.settings %}{{ ag_root_style }}">
  <section class="ag-adv-mechanism">
    <div class="ag-adv__wrap">
      <div class="ag-adv-mechanism__h">
        {%- if section.settings.title != blank -%}
          <h2>{{ section.settings.title }}</h2>
        {%- endif -%}
        {%- if section.settings.intro != blank -%}
          <div class="ag-adv-mechanism__intro">{{ section.settings.intro }}</div>
        {%- endif -%}
      </div>

      <div class="ag-adv-mechanism__steps{{ cols_class }}">
        {%- for block in section.blocks -%}
          {%- if block.type == 'step' -%}
            <div class="ag-adv-step" {{ block.shopify_attributes }}>
              {%- if style == 'numbered' -%}
                <span class="ag-adv-step__num">{{ forloop.index }}</span>
              {%- else -%}
                <div class="ag-adv-step__icon">
                  {%- if block.settings.icon_image != blank -%}
                    <img src="{{ block.settings.icon_image | image_url: width: 80 }}" alt="" loading="lazy">
                  {%- elsif block.settings.icon_emoji != blank -%}
                    {{ block.settings.icon_emoji }}
                  {%- endif -%}
                </div>
              {%- endif -%}
              {%- if block.settings.name != blank -%}
                <div class="ag-adv-step__name">{{ block.settings.name }}</div>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="ag-adv-step__text">{{ block.settings.text }}</div>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "AG Adv — Mécanisme",
  "enabled_on": {
    "templates": [
      "page"
    ]
  },
  "max_blocks": 5,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "default": "How NovaSleep Pro works"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Texte d'introduction",
      "default": "<p>A transdermal patch releases a natural sleep blend steadily through the skin all night, working with your body's circadian rhythm — not against it.</p>"
    },
    {
      "type": "select",
      "id": "step_style",
      "label": "Style des étapes",
      "options": [
        {
          "value": "numbered",
          "label": "Numéroté (1, 2, 3...)"
        },
        {
          "value": "icons",
          "label": "Avec icônes / emoji"
        },
        {
          "value": "columns",
          "label": "Colonnes (3 par ligne, sans icônes)"
        }
      ],
      "default": "numbered"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Couleur de fond de la section",
      "default": "#f5f7f5"
    },
    {
      "type": "header",
      "content": "Apparence personnalisée"
    },
    {
      "type": "color_background",
      "id": "ag_bg",
      "label": "Fond de la section",
      "info": "Override le fond. Supporte solide ou dégradé."
    },
    {
      "type": "range",
      "id": "ag_radius",
      "label": "Radius des éléments (px)",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0,
      "info": "0 = utilise la valeur par défaut du design"
    },
    {
      "type": "color",
      "id": "ag_accent",
      "label": "Couleur d'accent",
      "info": "Mots highlighted, eyebrow, badges, icônes, étoiles, etc."
    },
    {
      "type": "color",
      "id": "ag_accent_soft",
      "label": "Couleur d'accent — pastilles soft",
      "info": "Fond des pills, icônes douces, badges légers"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Padding haut",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Padding bas",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 8
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Étape",
      "settings": [
        {
          "type": "text",
          "id": "icon_emoji",
          "label": "Emoji / caractère",
          "default": "🌙"
        },
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Icône image (prioritaire sur l'emoji)"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Nom de l'étape",
          "default": "Apply before bed"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Explication",
          "default": "<p>Stick a small patch behind your ear — it's discreet, painless and stays on all night.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "AG Adv — Mécanisme",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "icon_emoji": "🌙",
            "name": "Apply before bed",
            "text": "<p>Stick a small patch behind your ear — discreet, painless, stays on all night.</p>"
          }
        },
        {
          "type": "step",
          "settings": {
            "icon_emoji": "💧",
            "name": "Steady transdermal release",
            "text": "<p>The natural blend diffuses through the skin slowly over hours.</p>"
          }
        },
        {
          "type": "step",
          "settings": {
            "icon_emoji": "✨",
            "name": "Wake up clear",
            "text": "<p>Peel off in the morning. No residue, no grogginess, no fog.</p>"
          }
        }
      ]
    }
  ],
  "tag": "section",
  "class": "ag-adv-section"
}
{% endschema %}
