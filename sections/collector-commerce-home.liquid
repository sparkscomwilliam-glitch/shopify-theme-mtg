{% liquid
  assign featured_product = section.settings.featured_product
  if featured_product == blank
    assign featured_product = collections.all.products.first
  endif

  assign product_collection = section.settings.best_sellers
  if product_collection == blank
    assign product_collection = collections.all
  endif
%}

{{ 'collector-commerce.css' | asset_url | stylesheet_tag }}

<section class="commerce-home commerce-home--{{ section.id }}">
  <div class="commerce-offer lab-mono">
    <span class="commerce-offer__pulse" aria-hidden="true"></span>
    {{ section.settings.offer_text }}
    <a href="{{ routes.all_products_collection_url }}">Découvrir la sélection <span aria-hidden="true">↗</span></a>
  </div>

  <div class="commerce-shell">
    <div class="commerce-hero">
      <div class="commerce-hero__copy">
        <span class="commerce-kicker lab-mono">COLLECTOR LAB / BOUTIQUE</span>
        <h1>{{ section.settings.heading }}</h1>
        <p class="commerce-hero__lead">{{ section.settings.subheading }}</p>

        <ul class="commerce-checks" aria-label="Points clés">
          <li><span aria-hidden="true">✓</span> Formats expliqués avant l’achat</li>
          <li><span aria-hidden="true">✓</span> Compatibilité clairement indiquée</li>
          <li><span aria-hidden="true">✓</span> Usage réel et capacité documentés</li>
          <li><span aria-hidden="true">✓</span> Limites de protection visibles</li>
        </ul>

        <div class="commerce-actions">
          <a class="commerce-button commerce-button--primary" href="{{ routes.all_products_collection_url }}">Voir les produits <span aria-hidden="true">→</span></a>
          {% if featured_product != blank %}
            <a class="commerce-button commerce-button--ghost" href="{{ featured_product.url }}">Voir la fiche</a>
          {% endif %}
        </div>
      </div>

      <div class="commerce-hero__visual">
        <div class="commerce-hero__hud lab-mono"><span>OBJET SÉLECTIONNÉ</span><span>ANALYSE / 001</span></div>
        {% if featured_product != blank %}
          <a href="{{ featured_product.url }}" class="commerce-hero__media" aria-label="Voir {{ featured_product.title }}">
            {% if featured_product.featured_image %}
              {{ featured_product.featured_image | image_url: width: 1200 | image_tag: loading: 'eager', widths: '480, 720, 960, 1200', sizes: '(max-width: 799px) 100vw, 50vw', alt: featured_product.title }}
            {% else %}
              {{ 'product-1' | placeholder_svg_tag: 'commerce-placeholder' }}
            {% endif %}
          </a>
          <div class="commerce-hero__product">
            <div><span class="lab-mono">SÉLECTION DU LAB</span><strong>{{ featured_product.title }}</strong></div>
            <b>{{ featured_product.price | money }}</b>
          </div>
        {% else %}
          <div class="commerce-hero__media">{{ 'product-1' | placeholder_svg_tag: 'commerce-placeholder' }}</div>
        {% endif %}
      </div>
    </div>

    <div class="commerce-benefits" aria-label="Services de la boutique">
      <div><span class="commerce-benefits__icon">⌁</span><p><b>Formats contrôlés</b><small>Dimensions lisibles sur chaque fiche</small></p></div>
      <div><span class="commerce-benefits__icon">◇</span><p><b>Sélection spécialisée</b><small>Protection, rangement, exposition</small></p></div>
      <div><span class="commerce-benefits__icon">↗</span><p><b>Expédition suivie</b><small>Suivi communiqué après envoi</small></p></div>
      <div><span class="commerce-benefits__icon">?</span><p><b>Aide avant achat</b><small>Vérifiez la compatibilité avec nous</small></p></div>
    </div>

    <section class="commerce-section commerce-products" aria-labelledby="commerce-products-{{ section.id }}">
      <div class="commerce-heading commerce-heading--row">
        <div><span class="commerce-kicker lab-mono">BEST SELLERS / SÉLECTION</span><h2 id="commerce-products-{{ section.id }}">Les essentiels du Collector Lab.</h2></div>
        <a href="{{ routes.all_products_collection_url }}">Voir tous les produits <span aria-hidden="true">→</span></a>
      </div>

      <div class="commerce-product-grid">
        {% for product in product_collection.products limit: 4 %}
          {% assign selected_variant = product.selected_or_first_available_variant %}
          {% assign commerce_form_id = 'commerce-product-form-' | append: section.id | append: '-' | append: forloop.index %}
          <article class="commerce-product-card">
            <a href="{{ product.url }}" class="commerce-product-card__media">
              <span class="commerce-product-card__badge lab-mono">OBJ / {{ forloop.index | prepend: '0' }}</span>
              {% if product.featured_image %}
                {{ product.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '320, 480, 640, 800', sizes: '(max-width: 699px) 82vw, (max-width: 1099px) 48vw, 25vw', alt: product.title }}
              {% else %}
                {{ 'product-' | append: forloop.index | placeholder_svg_tag: 'commerce-placeholder' }}
              {% endif %}
            </a>
            <div class="commerce-product-card__body">
              <span class="lab-mono">PROTECTION / COLLECTION</span>
              <div class="commerce-product-card__title"><a href="{{ product.url }}">{{ product.title }}</a><strong>{{ product.price | money }}</strong></div>
              <ul><li>Compatibilité sur la fiche</li><li>Usage documenté</li></ul>
              {% form 'product', product, id: commerce_form_id %}
                <input type="hidden" name="id" value="{{ selected_variant.id }}">
                <button class="commerce-add" type="submit" name="add" {% unless selected_variant.available %}disabled{% endunless %}>
                  {% if selected_variant.available %}Ajouter au panier{% else %}Indisponible{% endif %}
                </button>
              {% endform %}
            </div>
          </article>
        {% else %}
          <article class="commerce-product-card commerce-product-card--empty">
            <div class="commerce-product-card__media">{{ 'product-1' | placeholder_svg_tag: 'commerce-placeholder' }}</div>
            <div class="commerce-product-card__body"><span class="lab-mono">CATALOGUE</span><div class="commerce-product-card__title"><span>Ajoutez vos premiers produits</span></div></div>
          </article>
        {% endfor %}
      </div>
    </section>

    <section class="commerce-section commerce-demos" aria-labelledby="commerce-demos-{{ section.id }}">
      <div class="commerce-heading commerce-heading--center">
        <span class="commerce-kicker lab-mono">VOIR / COMPRENDRE / CHOISIR</span>
        <h2 id="commerce-demos-{{ section.id }}">Les produits en situation réelle.</h2>
        <p>Des vues utiles pour comprendre la manipulation, la capacité et l’encombrement avant de choisir.</p>
      </div>
      <div class="commerce-demo-grid">
        <article class="commerce-demo-card">
          <div class="commerce-demo-card__media">
            {% if featured_product.featured_image %}{{ featured_product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: featured_product.title }}{% else %}{{ 'lifestyle-1' | placeholder_svg_tag: 'commerce-placeholder' }}{% endif %}
            <span class="commerce-demo-card__play" aria-hidden="true">↗</span>
          </div>
          <span class="lab-mono">01 / MANIPULATION</span><h3>Accéder à sa collection</h3><p>Ouverture, insertion et consultation sans geste inutile.</p>
        </article>
        <article class="commerce-demo-card">
          <div class="commerce-demo-card__media commerce-demo-card__media--detail">
            {% if featured_product.featured_image %}{{ featured_product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: featured_product.title }}{% else %}{{ 'lifestyle-2' | placeholder_svg_tag: 'commerce-placeholder' }}{% endif %}
            <span class="commerce-demo-card__play" aria-hidden="true">↗</span>
          </div>
          <span class="lab-mono">02 / MATÉRIAUX</span><h3>Observer les détails</h3><p>Bords, fermetures, poches et finitions montrés de près.</p>
        </article>
        <article class="commerce-demo-card">
          <div class="commerce-demo-card__media commerce-demo-card__media--wide">
            {% if featured_product.featured_image %}{{ featured_product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: featured_product.title }}{% else %}{{ 'lifestyle-1' | placeholder_svg_tag: 'commerce-placeholder' }}{% endif %}
            <span class="commerce-demo-card__play" aria-hidden="true">↗</span>
          </div>
          <span class="lab-mono">03 / CAPACITÉ</span><h3>Mesurer l’usage</h3><p>Capacité nue, sleeved et chargée clairement différenciée.</p>
        </article>
      </div>
    </section>

    <section class="commerce-section commerce-categories" aria-labelledby="commerce-categories-{{ section.id }}">
      <div class="commerce-heading commerce-heading--center">
        <span class="commerce-kicker lab-mono">SHOP BY NEED</span>
        <h2 id="commerce-categories-{{ section.id }}">Acheter selon votre besoin.</h2>
      </div>
      <div class="commerce-category-grid">
        {% for block in section.blocks %}
          {% assign category = block.settings.collection %}
          {% assign category_image = category.featured_image %}
          {% if category_image == blank and category.products.first != blank %}
            {% assign category_image = category.products.first.featured_image %}
          {% endif %}
          <a class="commerce-category-card{% if forloop.first %} commerce-category-card--featured{% endif %}" href="{% if category != blank %}{{ category.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}" {{ block.shopify_attributes }}>
            {% if category_image %}{{ category_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '420, 720, 960, 1200', alt: block.settings.title }}{% else %}{{ 'collection-' | append: forloop.index | placeholder_svg_tag: 'commerce-placeholder' }}{% endif %}
            <span class="commerce-category-card__shade"></span>
            <span class="commerce-category-card__content"><small class="lab-mono">0{{ forloop.index }} / CATÉGORIE</small><strong>{{ block.settings.title }}</strong><em>{{ block.settings.description }}</em><b>Explorer <span aria-hidden="true">↗</span></b></span>
          </a>
        {% endfor %}
      </div>
    </section>

    <section class="commerce-story">
      <div class="commerce-story__visual">
        {% if section.settings.story_image %}
          {{ section.settings.story_image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1400', sizes: '(max-width: 799px) 100vw, 50vw', alt: section.settings.story_heading }}
        {% elsif featured_product.featured_image %}
          {{ featured_product.featured_image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1400', sizes: '(max-width: 799px) 100vw, 50vw', alt: featured_product.title }}
        {% else %}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'commerce-placeholder' }}
        {% endif %}
        <div class="commerce-story__measure lab-mono"><span>63 × 88 MM</span><span>FORMAT STANDARD</span></div>
      </div>
      <div class="commerce-story__copy">
        <span class="commerce-kicker lab-mono">POURQUOI COLLECTOR LAB</span>
        <h2>{{ section.settings.story_heading }}</h2>
        <p>{{ section.settings.story_text }}</p>
        <div class="commerce-story__features">
          <span>✓ Dimensions utiles affichées</span><span>✓ Compatibilité sans ambiguïté</span><span>✓ Matériaux documentés</span><span>✓ Limites d’usage expliquées</span>
        </div>
        <a class="commerce-button commerce-button--ghost" href="{{ routes.all_products_collection_url }}">Découvrir la méthode <span aria-hidden="true">→</span></a>
      </div>
    </section>
  </div>

  <section class="commerce-usps" aria-labelledby="commerce-usps-{{ section.id }}">
    <div class="commerce-shell">
      <div class="commerce-heading commerce-heading--center commerce-heading--light">
        <span class="commerce-kicker lab-mono">LA DIFFÉRENCE COLLECTOR LAB</span>
        <h2 id="commerce-usps-{{ section.id }}">Plus simple à comparer. Plus sûr à choisir.</h2>
        <p>Une boutique conçue pour répondre aux questions concrètes avant l’achat.</p>
      </div>
      <div class="commerce-usp-grid">
        <article><span class="commerce-usp-grid__index lab-mono">01</span><i>↔</i><h3>Mesures lisibles</h3><p>Dimensions intérieures et extérieures séparées quand elles sont disponibles.</p></article>
        <article><span class="commerce-usp-grid__index lab-mono">02</span><i>◇</i><h3>Compatibilité claire</h3><p>Standard, Japanese, Toploader et slabs identifiés sans jargon inutile.</p></article>
        <article><span class="commerce-usp-grid__index lab-mono">03</span><i>▦</i><h3>Capacité réaliste</h3><p>Les capacités théoriques et les usages réellement chargés sont distingués.</p></article>
        <article><span class="commerce-usp-grid__index lab-mono">04</span><i>!</i><h3>Limites visibles</h3><p>Lumière, humidité et incompatibilités restent affichées avant la commande.</p></article>
      </div>
      <div class="commerce-usps__action"><a class="commerce-button commerce-button--primary" href="{{ routes.all_products_collection_url }}">Explorer le catalogue <span aria-hidden="true">↗</span></a></div>
    </div>
  </section>

  <div class="commerce-shell">
    <section class="commerce-final">
      <div><span class="commerce-kicker lab-mono">VOTRE COLLECTION / VOTRE SYSTÈME</span><h2>Commencez par le besoin.<br>Choisissez ensuite le produit.</h2></div>
      <a class="commerce-button commerce-button--primary" href="{{ routes.all_products_collection_url }}">Voir la boutique <span aria-hidden="true">→</span></a>
    </section>
  </div>
</section>

{% schema %}
{
  "name": "Accueil Collector Shop",
  "settings": [
    { "type": "text", "id": "offer_text", "label": "Bandeau", "default": "Protection, rangement et exposition pour collectionneurs" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Protégez mieux. Organisez clairement. Exposez avec précision." },
    { "type": "textarea", "id": "subheading", "label": "Introduction", "default": "Des solutions pour cartes et collections choisies selon leurs dimensions, leur compatibilité et leur usage réel." },
    { "type": "product", "id": "featured_product", "label": "Produit du hero" },
    { "type": "collection", "id": "best_sellers", "label": "Collection meilleures ventes" },
    { "type": "image_picker", "id": "story_image", "label": "Image histoire de marque" },
    { "type": "text", "id": "story_heading", "label": "Titre histoire", "default": "Une boutique pensée comme un laboratoire de collection." },
    { "type": "textarea", "id": "story_text", "label": "Texte histoire", "default": "Nous organisons l’information produit comme une fiche d’archive : ce qui est mesuré, ce qui est confirmé, ce qui reste à vérifier et l’usage auquel chaque solution répond." }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Catégorie",
      "limit": 3,
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Titre", "default": "Protection" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Sleeves, toploaders et solutions adaptées au niveau de protection recherché." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Accueil Collector Shop",
      "blocks": [
        { "type": "category", "settings": { "title": "Protection", "description": "Sleeves, toploaders et solutions adaptées au niveau de protection recherché." } },
        { "type": "category", "settings": { "title": "Rangement", "description": "Binders et boîtes pour classer une collection active ou archivée." } },
        { "type": "category", "settings": { "title": "Exposition", "description": "Présentoirs et protections pour mettre en valeur les pièces clés." } }
      ]
    }
  ]
}
{% endschema %}
