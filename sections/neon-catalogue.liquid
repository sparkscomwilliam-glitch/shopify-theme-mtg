{{ 'neon-catalogue.css' | asset_url | stylesheet_tag }}
<script src="{{ 'neon-catalogue.js' | asset_url }}" type="module" fetchpriority="low"></script>

{%- liquid
  assign is_all_products = false
  if collection.handle == 'all'
    assign is_all_products = true
  endif

  assign catalogue_title = collection.title
  assign catalogue_description = collection.description
  assign catalogue_kicker = section.settings.category_kicker
  if is_all_products
    assign catalogue_title = section.settings.all_products_title | default: collection.title
    assign catalogue_description = section.settings.all_products_description
    assign catalogue_kicker = section.settings.all_products_kicker
  endif

  assign sort_by = collection.sort_by | default: collection.default_sort_by
  assign active_filter_count = 0
  for filter in collection.filters
    assign active_filter_count = active_filter_count | plus: filter.active_values.size
    if filter.type == 'price_range' and filter.min_value.value != blank or filter.type == 'price_range' and filter.max_value.value != blank
      assign active_filter_count = active_filter_count | plus: 1
    endif
  endfor
-%}

<section
  class="neon-catalogue{% if is_all_products %} neon-catalogue--all{% endif %}"
  data-neon-catalogue
  style="--neon-products-desktop: {{ section.settings.columns_desktop }}; --neon-products-mobile: {{ section.settings.columns_mobile }};"
>
  <div class="neon-catalogue__halo neon-catalogue__halo--teal" aria-hidden="true"></div>
  <div class="neon-catalogue__halo neon-catalogue__halo--violet" aria-hidden="true"></div>

  <div class="neon-catalogue__inner">
    <header class="neon-catalogue__header">
      <div class="neon-catalogue__heading">
        {%- if catalogue_kicker != blank -%}<p class="neon-catalogue__kicker">{{ catalogue_kicker }}</p>{%- endif -%}
        <h1>{{ catalogue_title | escape }}</h1>
        {%- if catalogue_description != blank -%}
          <div class="neon-catalogue__description rte">{{ catalogue_description }}</div>
        {%- endif -%}
      </div>

      <div class="neon-catalogue__header-index" aria-hidden="true">
        <span>CAT/{{ collection.handle | upcase | truncate: 12, '' }}</span>
        {% assign catalogue_count = collection.all_products_count | default: collection.products_count %}
        <span>{% if catalogue_count < 10 %}00{% elsif catalogue_count < 100 %}0{% endif %}{{ catalogue_count }} ITEMS</span>
      </div>
    </header>

    <div class="neon-catalogue__toolbar">
      <button
        type="button"
        class="neon-catalogue__filter-trigger"
        data-neon-filter-open
        aria-controls="NeonFilterDrawer-{{ section.id }}"
        aria-expanded="false"
      >
        <span class="neon-catalogue__toolbar-icon" aria-hidden="true">{{ 'icon-filter.svg' | inline_asset_content }}</span>
        <span>Filtres</span>
        {%- if active_filter_count > 0 -%}<span class="neon-catalogue__filter-badge">{{ active_filter_count }}</span>{%- endif -%}
      </button>

      <div class="neon-catalogue__result-count" aria-live="polite">
        <strong>{{ collection.products_count }}</strong>
        <span>sur {{ collection.all_products_count }} produits</span>
      </div>

      <label class="neon-catalogue__sort">
        <span>Trier par</span>
        <select name="sort_by" data-neon-sort aria-label="Trier les produits">
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value | escape }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name | escape }}</option>
          {%- endfor -%}
        </select>
        <span class="neon-catalogue__sort-caret" aria-hidden="true">{{ 'icon-caret.svg' | inline_asset_content }}</span>
      </label>
    </div>

    {%- if active_filter_count > 0 -%}
      <div class="neon-active-filters" aria-label="Filtres actifs">
        {%- for filter in collection.filters -%}
          {%- if filter.type == 'price_range' and filter.min_value.value != blank or filter.type == 'price_range' and filter.max_value.value != blank -%}
            <a class="neon-active-filter" href="{{ filter.url_to_remove }}">
              {{ filter.label | escape }}:
              {%- if filter.min_value.value != blank -%} {{ filter.min_value.value | money }}{%- else -%} {{ 0 | money }}{%- endif -%}
              –
              {%- if filter.max_value.value != blank -%} {{ filter.max_value.value | money }}{%- else -%} {{ filter.range_max | money }}{%- endif -%}
              <span aria-hidden="true">{{ 'icon-filters-close.svg' | inline_asset_content }}</span>
            </a>
          {%- else -%}
            {%- for value in filter.active_values -%}
              <a class="neon-active-filter" href="{{ value.url_to_remove }}">
                {{ value.label | escape }}
                <span aria-hidden="true">{{ 'icon-filters-close.svg' | inline_asset_content }}</span>
              </a>
            {%- endfor -%}
          {%- endif -%}
        {%- endfor -%}
        <a class="neon-active-filters__clear" href="{{ collection.url }}">Tout effacer</a>
      </div>
    {%- endif -%}

    <div class="neon-catalogue__layout">
      {%- if section.settings.enable_filtering and collection.filters.size > 0 -%}
        <aside class="neon-catalogue__sidebar" aria-label="Filtres du catalogue">
          <form action="{{ collection.url }}" method="get" data-neon-filter-form data-neon-auto-submit>
            <input type="hidden" name="sort_by" value="{{ sort_by }}">
            <div class="neon-catalogue__sidebar-head">
              <div>
                <p class="neon-catalogue__kicker">AFFINER LA RECHERCHE</p>
                <h2>Filtres</h2>
              </div>
              {%- if active_filter_count > 0 -%}<a href="{{ collection.url }}">Effacer</a>{%- endif -%}
            </div>
            <div class="neon-catalogue__filter-list">
              {%- assign desktop_filter_context = section.id | append: '-desktop' -%}
              {%- render 'neon-catalogue-filter-fields', results: collection, context: desktop_filter_context -%}
            </div>
            <noscript><button class="neon-filter-apply" type="submit">Appliquer les filtres</button></noscript>
          </form>
        </aside>
      {%- endif -%}

      <div class="neon-catalogue__results" id="NeonCatalogueResults-{{ section.id }}">
        {%- paginate collection.products by section.settings.products_per_page -%}
          {%- if collection.products.size > 0 -%}
            <ul class="neon-catalogue__grid" role="list">
              {%- for product in collection.products -%}
                <li>
                  {%- render 'neon-catalogue-product-card',
                    product: product,
                    section_id: section.id,
                    card_index: forloop.index,
                    show_vendor: section.settings.show_vendor,
                    show_quick_add: section.settings.show_quick_add
                  -%}
                </li>
              {%- endfor -%}
            </ul>

            {%- if paginate.pages > 1 -%}
              <nav class="neon-pagination" aria-label="Pagination">
                {%- if paginate.previous -%}
                  <a class="neon-pagination__arrow" href="{{ paginate.previous.url }}" aria-label="Page précédente">{{ 'icon-chevron-left.svg' | inline_asset_content }}</a>
                {%- else -%}
                  <span class="neon-pagination__arrow is-disabled" aria-hidden="true">{{ 'icon-chevron-left.svg' | inline_asset_content }}</span>
                {%- endif -%}

                <div class="neon-pagination__pages">
                  {%- for part in paginate.parts -%}
                    {%- if part.is_link -%}
                      <a href="{{ part.url }}">{{ part.title }}</a>
                    {%- else -%}
                      <span{% unless part.title == '&hellip;' %} class="is-current" aria-current="page"{% endunless %}>{{ part.title }}</span>
                    {%- endif -%}
                  {%- endfor -%}
                </div>

                {%- if paginate.next -%}
                  <a class="neon-pagination__arrow" href="{{ paginate.next.url }}" aria-label="Page suivante">{{ 'icon-chevron-right.svg' | inline_asset_content }}</a>
                {%- else -%}
                  <span class="neon-pagination__arrow is-disabled" aria-hidden="true">{{ 'icon-chevron-right.svg' | inline_asset_content }}</span>
                {%- endif -%}
              </nav>
            {%- endif -%}
          {%- else -%}
            <div class="neon-catalogue__empty">
              <span aria-hidden="true">00</span>
              <h2>Aucun spécimen trouvé</h2>
              <p>Modifiez vos filtres pour élargir la sélection.</p>
              <a href="{{ collection.url }}">Réinitialiser les filtres</a>
            </div>
          {%- endif -%}
        {%- endpaginate -%}
      </div>
    </div>
  </div>

  {%- if section.settings.enable_filtering and collection.filters.size > 0 -%}
    <dialog class="neon-filter-drawer" id="NeonFilterDrawer-{{ section.id }}" data-neon-filter-dialog aria-labelledby="NeonFilterTitle-{{ section.id }}">
      <form action="{{ collection.url }}" method="get" data-neon-filter-form>
        <input type="hidden" name="sort_by" value="{{ sort_by }}">
        <div class="neon-filter-drawer__header">
          <div>
            <p class="neon-catalogue__kicker">AFFINER LA RECHERCHE</p>
            <h2 id="NeonFilterTitle-{{ section.id }}">Filtres</h2>
          </div>
          <button type="button" data-neon-filter-close aria-label="Fermer les filtres">{{ 'icon-close.svg' | inline_asset_content }}</button>
        </div>
        <div class="neon-filter-drawer__body">
          {%- assign mobile_filter_context = section.id | append: '-mobile' -%}
          {%- render 'neon-catalogue-filter-fields', results: collection, context: mobile_filter_context -%}
        </div>
        <div class="neon-filter-drawer__footer">
          <a href="{{ collection.url }}">Tout effacer</a>
          <button class="neon-filter-apply" type="submit">
            Voir {{ collection.products_count }} produit{% if collection.products_count != 1 %}s{% endif %}
          </button>
        </div>
      </form>
    </dialog>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Catalogue Neon Specimen",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Collection"
    },
    {
      "type": "text",
      "id": "category_kicker",
      "label": "Surtitre des catégories",
      "default": "CURATED COLLECTION"
    },
    {
      "type": "header",
      "content": "Page Tous les produits"
    },
    {
      "type": "text",
      "id": "all_products_kicker",
      "label": "Surtitre",
      "default": "NEON SPECIMEN · CATALOGUE"
    },
    {
      "type": "text",
      "id": "all_products_title",
      "label": "Titre",
      "default": "Tous les produits"
    },
    {
      "type": "richtext",
      "id": "all_products_description",
      "label": "Description",
      "default": "<p>Cartes, displays, accessoires et pièces certifiées réunis dans un seul catalogue.</p>"
    },
    {
      "type": "header",
      "content": "Catalogue"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "label": "Activer les filtres Shopify",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Afficher le fabricant",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_quick_add",
      "label": "Afficher l’ajout rapide",
      "default": true
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Produits par page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Colonnes sur ordinateur",
      "options": [
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "3"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Colonnes sur mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    }
  ],
  "presets": [
    {
      "name": "Catalogue Neon Specimen"
    }
  ]
}
{% endschema %}
