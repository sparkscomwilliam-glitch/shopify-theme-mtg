      "label": "Texte du bouton",
      "default": "#593092"
    },
    {
      "type": "color",
      "id": "cta_bg_hover",
      "label": "Fond du bouton (hover)",
      "default": "#F2EAFE"
    },

    {
      "type": "header",
      "content": "Carte « Oui » (produit)"
    },
    {
      "type": "color",
      "id": "card_yes_bg",
      "label": "Fond de la carte",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
