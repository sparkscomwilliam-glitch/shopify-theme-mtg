    },
    {
      "type": "color",
      "id": "badge_bg",
      "label": "Fond du badge",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "badge_text",
      "label": "Texte du badge",
      "default": "#593092"
    },

    {
      "type": "header",
      "content": "Titre & description"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
