{% comment %} ag-adv-benefits.liquid — propriété de James Sparks {% endcomment %}
{% render 'ag-adv-schema-head' %}

{%- capture ag_vars -%}
  {%- if section.settings.ag_bg != blank -%}--ag-section-bg:{{ section.settings.ag_bg }};{%- endif -%}
  {%- if section.settings.ag_radius and section.settings.ag_radius > 0 -%}--ag-section-radius:{{ section.settings.ag_radius }}px;{%- endif -%}
  {%- if section.settings.ag_accent != blank -%}--ag-section-accent:{{ section.settings.ag_accent }};{%- endif -%}
  {%- if section.settings.ag_accent_soft != blank -%}--ag-section-accent-soft:{{ section.settings.ag_accent_soft }};{%- endif -%}
{%- endcapture -%}
{%- capture ag_root_style -%}{% if section.settings.ag_bg != blank %}background:{{ section.settings.ag_bg }};{% endif %}{{ ag_vars }}{%- endcapture -%}


<div class="ag-adv spacing-style" style="{% render 'spacing-style', settings: section.settings %}{{ ag_root_style }}">
  <div class="ag-adv__wrap">
    <section class="ag-adv-benefits">
      <div class="ag-adv-benefits__h">
        {%- if section.settings.title != blank -%}
          <h2>{{ section.settings.title }}</h2>
        {%- endif -%}
        {%- if section.settings.subtitle != blank -%}
          <p style="color:var(--ag-adv-ink2);font-size:16px;max-width:46ch;margin:8px auto 0;">{{ section.settings.subtitle }}</p>
        {%- endif -%}
      </div>

      <div class="ag-adv-benefits__grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'benefit' -%}
            <div class="ag-adv-benefit" {{ block.shopify_attributes }}>
              <div class="ag-adv-benefit__icon">
                {%- if block.settings.icon_svg != blank -%}
                  {{ block.settings.icon_svg }}
                {%- elsif block.settings.icon != blank -%}
                  <img src="{{ block.settings.icon | image_url: width: 64 }}" alt="" loading="lazy">
                {%- else -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20,6 9,17 4,12"/></svg>
                {%- endif -%}
              </div>
              <div>
                {%- if block.settings.title != blank -%}
                  <div class="ag-adv-benefit__title">{{ block.settings.title }}</div>
                {%- endif -%}
                {%- if block.settings.description != blank -%}
                  <div class="ag-adv-benefit__desc">{{ block.settings.description }}</div>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </section>
  </div>
</div>

{% schema %}
{
  "name": "AG Adv — Bénéfices",
  "enabled_on": {
    "templates": [
      "page"
    ]
  },
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Titre de la section",
      "default": "Why people love NovaSleep Pro"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Sous-titre",
      "default": "The four reasons reviewers keep mentioning."
    },
    {
      "type": "header",
      "content": "Apparence personnalisée"
    },
    {
      "type": "color_background",
      "id": "ag_bg",
      "label": "Fond de la section",
      "info": "Override le fond. Supporte solide ou dégradé."
    },
    {
      "type": "range",
      "id": "ag_radius",
      "label": "Radius des éléments (px)",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0,
      "info": "0 = utilise la valeur par défaut du design"
    },
    {
      "type": "color",
      "id": "ag_accent",
      "label": "Couleur d'accent",
      "info": "Mots highlighted, eyebrow, badges, icônes, étoiles, etc."
    },
    {
      "type": "color",
      "id": "ag_accent_soft",
      "label": "Couleur d'accent — pastilles soft",
      "info": "Fond des pills, icônes douces, badges légers"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Padding haut",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Padding bas",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 8
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Bénéfice",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icône (image)"
        },
        {
          "type": "html",
          "id": "icon_svg",
          "label": "Icône (SVG inline — prioritaire)",
          "info": "Colle ton code SVG. Prioritaire sur l'image."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titre du bénéfice",
          "default": "Endormissement rapide"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description",
          "default": "<p>Une libération progressive aide à calmer le mental et trouver le sommeil sans somnolence.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "AG Adv — Bénéfices",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "title": "Endormissement rapide",
            "description": "<p>Calme le mental sans somnolence forcée.</p>"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "title": "Sommeil profond",
            "description": "<p>Des phases REM plus longues, moins de réveils.</p>"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "title": "Sans accoutumance",
            "description": "<p>Non addictif, aucun effet rebond le matin.</p>"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "title": "Cliniquement testé",
            "description": "<p>Formule certifiée par labo tiers, ingrédients clean.</p>"
          }
        }
      ]
    }
  ],
  "tag": "section",
  "class": "ag-adv-section"
}
{% endschema %}
