{%- comment -%}
  AG Testimonial Reels — Video testimonial slider (Reels / TikTok style)
  Mobile-first · CSS scroll-snap · Vanilla JS · No external dependencies
{%- endcomment -%}

{%- style -%}


  /*
   ===================================================
   Section wrapper
   ===================================================
*/
  .ag-reels-section-{{ section.id }} {
    padding: 50px 0;
    max-width: 100%;
    overflow: hidden;
  }

  .ag-reels-heading-{{ section.id }} {
    text-align: center;
    font-size: var(--ag-fs-h2);
    font-weight: 700;
    margin: 0 0 8px;
    color: {{ section.settings.heading_color }};
  }

  .ag-reels-subheading-{{ section.id }} {
    text-align: center;
    font-size: var(--ag-fs-body);
    color: {{ section.settings.subheading_color }};
    margin: 0 0 28px;
  }


  /*
   ===================================================
   Slider track (native CSS scroll-snap)
   ===================================================
*/
  .ag-reels-slider-{{ section.id }} {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    gap: 15px;
    padding-inline: 7.5vw;
    scroll-padding-inline: 7.5vw;
    scrollbar-width: none;
    /* Firefox */
    -ms-overflow-style: none;
    /* IE / Edge */
    -webkit-overflow-scrolling: touch;
  }
  .ag-reels-slider-{{ section.id }}::-webkit-scrollbar {
    display: none;
    /* Chrome / Safari */
  }


  /*
   ===================================================
   Card
   ===================================================
*/
  .ag-reel-card-{{ section.id }} {
    flex: 0 0 85vw;
    scroll-snap-align: center;
    background: {{ section.settings.card_background }};
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
    display: flex;
    flex-direction: column;
  }


  /*
   ===================================================
   Video container
   ===================================================
*/
  .ag-reel-video-wrap-{{ section.id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .ag-reel-video-wrap-{{ section.id }}
  video {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    background: #000;
  }

  /* Bottom gradient overlay for legibility */
  .ag-reel-video-wrap-{{ section.id }}::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 45%;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.65), transparent);
    pointer-events: none;
    z-index: 1;
  }

  /* ---- Overlay buttons ---- */
  .ag-reel-btn {
    position: absolute;
    z-index: 2;
    background: rgba(0, 0, 0, 0.45);
    border: none;
    color: #fff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease;
    -webkit-tap-highlight-color: transparent;
  }
  .ag-reel-btn:hover {
    background: rgba(0, 0, 0, 0.65);
  }
  .ag-reel-btn svg {
    width: 20px;
    height: 20px;
    fill: #fff;
    pointer-events: none;
  }

  /* Play / Pause — top-left */
  .ag-reel-play-{{ section.id }} {
    top: 12px;
    left: 12px;
    width: 42px;
    height: 42px;
    border-radius: 10px;
  }

  /* Mute / Unmute — bottom-right */
  .ag-reel-mute-{{ section.id }} {
    bottom: 12px;
    right: 12px;
    width: 38px;
    height: 38px;
    border-radius: 50%;
  }

  /* Star rating — bottom-left */
  .ag-reel-rating-{{ section.id }} {
    position: absolute;
    z-index: 2;
    bottom: 14px;
    left: 14px;
    display: flex;
    align-items: center;
    gap: 6px;
    color: #fff;
    font-size: var(--ag-fs-eyebrow);
    font-weight: 600;
  }
  .ag-reel-rating-{{ section.id }}
  .ag-reel-stars {
    display: flex;
    gap: 2px;
  }
  .ag-reel-rating-{{ section.id }}
  .ag-reel-stars svg {
    width: 16px;
    height: 16px;
    fill: {{ section.settings.stars_color }};
  }


  /*
   ===================================================
   Text zone
   ===================================================
*/
  .ag-reel-text-{{ section.id }} {
    padding: 20px 22px 24px;
    text-align: center;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .ag-reel-quote-{{ section.id }} {
    font-size: var(--ag-fs-small);
    line-height: 1.65;
    color: {{ section.settings.quote_color }};
    margin: 0 0 10px;
  }
  .ag-reel-quote-{{ section.id }}
  p {
    margin: 0;
  }

  .ag-reel-author-{{ section.id }} {
    font-size: var(--ag-fs-small);
    color: {{ section.settings.author_color }};
    font-style: italic;
    margin: 0;
  }


  /*
   ===================================================
   Pagination dots
   ===================================================
*/
  .ag-reels-dots-{{ section.id }} {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 24px;
  }

  .ag-reels-dot-{{ section.id }} {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: none;
    padding: 0;
    background: {{ section.settings.dot_color }};
    opacity: 0.35;
    cursor: pointer;
    transition: opacity 0.25s
    , transform 0.25s;
  }
  .ag-reels-dot-{{ section.id }}
  .ag-dot-active {
    opacity: 1;
    transform: scale(1.3);
  }


  /*
   ===================================================
   Desktop — 3 columns
   ===================================================
*/
  @media (min-width: 768px) {
    .ag-reels-section-{{ section.id }} {
      padding: 70px 20px;
    }
    .ag-reels-slider-{{ section.id }} {
      max-width: 1260px;
      margin: 0 auto;
      padding-inline: 20px;
      scroll-padding-inline: 20px;
      gap: 20px;
    }
    .ag-reel-card-{{ section.id }} {
      flex: 0 0 calc(33.333% - 14px);
    }
  }

{%- endstyle -%}

{%- comment -%} ============ HTML / Liquid ============ {%- endcomment -%}

<ag-testimonial-reels id="ag-reels-{{ section.id }}" class="ag-reels-section-{{ section.id }}">

  {%- if section.settings.heading != blank -%}
    <h2 class="ag-reels-heading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}

  {%- if section.settings.subheading != blank -%}
    <p class="ag-reels-subheading-{{ section.id }}">{{ section.settings.subheading | escape }}</p>
  {%- endif -%}

  <div class="ag-reels-slider-{{ section.id }}" data-reels-track>
    {%- for block in section.blocks -%}
      <div
        class="ag-reel-card-{{ section.id }}"
        {{ block.shopify_attributes }}
        data-reel-card>

        {%- comment -%} ---- Video zone ---- {%- endcomment -%}
        <div class="ag-reel-video-wrap-{{ section.id }}">

          {%- if block.settings.video != blank -%}
            {{
              block.settings.video | video_tag: playsinline: true, loop: true, muted: true, controls: false, preload: 'metadata', class: 'ag-reel-video'
            }}
          {%- endif -%}

          {%- comment -%} Play / Pause button {%- endcomment -%}
          <button
            class="ag-reel-btn ag-reel-play-{{ section.id }}"
            data-reel-play
            aria-label="Play / Pause">
            {%- comment -%} Pause icon (shown when video is playing) {%- endcomment -%}
            <svg
              data-icon="pause"
              viewBox="0 0 24 24"
              style="display:none">
              <rect
                x="6"
                y="4"
                width="4"
                height="16"
                rx="1" />
              <rect
                x="14"
                y="4"
                width="4"
                height="16"
                rx="1" />
            </svg>
            {%- comment -%} Play icon (shown when video is paused) {%- endcomment -%}
            <svg data-icon="play" viewBox="0 0 24 24">
              <path d="M8 5v14l11-7z" />
            </svg>
          </button>

          {%- comment -%} Star rating overlay — bottom-left {%- endcomment -%}
          {%- assign rating_int = block.settings.rating | floor -%}
          {%- assign rating_frac = block.settings.rating | minus: rating_int -%}
          {%- assign rating_next = rating_int | plus: 1 -%}
          <div class="ag-reel-rating-{{ section.id }}">
            <span class="ag-reel-stars">
              {%- for i in (1..5) -%}
                {%- if i <= rating_int -%}
                  {%- comment -%} Full star {%- endcomment -%}
                  <svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" /></svg>
                {%- elsif rating_frac >= 0.5 and i == rating_next -%}
                  {%- comment -%} Half star {%- endcomment -%}
                  <svg viewBox="0 0 24 24">
                    <defs>
                      <linearGradient id="halfStar-{{ section.id }}-{{ block.id }}-{{ i }}"><stop offset="50%" stop-color="{{ section.settings.stars_color }}" /><stop offset="50%" stop-color="#555" /></linearGradient>
                    </defs>
                    <path fill="url(#halfStar-{{ section.id }}-{{ block.id }}-{{ i }})" d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                  </svg>
                {%- else -%}
                  {%- comment -%} Empty star {%- endcomment -%}
                  <svg viewBox="0 0 24 24"><path fill="#555" d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" /></svg>
                {%- endif -%}
              {%- endfor -%}
            </span>
            <span>{{ block.settings.rating }} / 5</span>
          </div>

          {%- comment -%} Mute / Unmute button — bottom-right {%- endcomment -%}
          <button
            class="ag-reel-btn ag-reel-mute-{{ section.id }}"
            data-reel-mute
            aria-label="Mute / Unmute">
            {%- comment -%} Muted icon (speaker-off) {%- endcomment -%}
            <svg data-icon="muted" viewBox="0 0 24 24">
              <path d="M16.5 12A4.5 4.5 0 0 0 14 8.18v1.7l2.44 2.44c.04-.1.06-.21.06-.32zM19 12c0 .94-.2 1.82-.54 2.64l1.51 1.51A8.94 8.94 0 0 0 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06a9 9 0 0 0 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4l-2.09 2.09L12 8.18V4z" />
            </svg>
            {%- comment -%} Unmuted icon (speaker-on) {%- endcomment -%}
            <svg
              data-icon="unmuted"
              viewBox="0 0 24 24"
              style="display:none">
              <path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3A4.5 4.5 0 0 0 14 8.18v7.64c1.5-.68 2.5-2.17 2.5-3.82zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z" />
            </svg>
          </button>

        </div>
        {%- comment -%} /video-wrap {%- endcomment -%}

        {%- comment -%} ---- Text zone ---- {%- endcomment -%}
        <div class="ag-reel-text-{{ section.id }}">
          {%- if block.settings.quote != blank -%}
            <div class="ag-reel-quote-{{ section.id }}">{{ block.settings.quote }}</div>
          {%- endif -%}

          {%- if block.settings.author != blank -%}
            <p class="ag-reel-author-{{ section.id }}">{{ block.settings.author | escape }}</p>
          {%- endif -%}
        </div>

      </div>
    {%- endfor -%}
  </div>

  {%- if section.blocks.size > 1 -%}
    <div class="ag-reels-dots-{{ section.id }}" data-reels-dots>
      {%- for block in section.blocks -%}
        <button
          class="ag-reels-dot-{{ section.id }}{% if forloop.first %} ag-dot-active{% endif %}"
          data-dot-index="{{ forloop.index0 }}"
          aria-label="Go to slide {{ forloop.index }}"></button>
      {%- endfor -%}
    </div>
  {%- endif -%}

</ag-testimonial-reels>

{%- comment -%} ============ JavaScript ============ {%- endcomment -%}

<script>
  if (!customElements.get('ag-testimonial-reels')) {
    class AgTestimonialReels extends HTMLElement {
      constructor() {
        super();

        this.track = this.querySelector('[data-reels-track]');
        this.cards = [...this.querySelectorAll('[data-reel-card]')];
        this.dots  = [...this.querySelectorAll('[data-dot-index]')];

        if (!this.track || !this.cards.length) return;

        /* ---------- Scroll-based pagination ---------- */
        this._onScroll = this._onScroll.bind(this);
        this.track.addEventListener('scroll', this._onScroll, { passive: true });

        /* ---------- Dot click ---------- */
        this.dots.forEach(dot => {
          dot.addEventListener('click', () => {
            const idx = parseInt(dot.dataset.dotIndex, 10);
            this._scrollToCard(idx);
          });
        });

        /* ---------- Per-card controls ---------- */
        this.cards.forEach(card => {
          const video    = card.querySelector('video');
          const playBtn  = card.querySelector('[data-reel-play]');
          const muteBtn  = card.querySelector('[data-reel-mute]');

          if (!video) return;

          /* Play / Pause */
          if (playBtn) {
            playBtn.addEventListener('click', () => {
              if (video.paused) {
                video.play();
              } else {
                video.pause();
              }
              this._syncPlayIcon(playBtn, video);
            });
          }

          /* Mute / Unmute */
          if (muteBtn) {
            muteBtn.addEventListener('click', () => {
              video.muted = !video.muted;
              this._syncMuteIcon(muteBtn, video);
            });
          }

          /* Keep icon state in sync when video ends/plays externally */
          video.addEventListener('play',  () => this._syncPlayIcon(playBtn, video));
          video.addEventListener('pause', () => this._syncPlayIcon(playBtn, video));
        });

        /* ---------- IntersectionObserver — autoplay ---------- */
        this._observer = new IntersectionObserver(entries => {
          entries.forEach(entry => {
            const card  = entry.target;
            const video = card.querySelector('video');
            const playBtn = card.querySelector('[data-reel-play]');
            if (!video) return;

            if (entry.isIntersecting && entry.intersectionRatio >= 0.7) {
              video.play().catch(() => {});
              this._syncPlayIcon(playBtn, video);
            } else {
              video.pause();
              this._syncPlayIcon(playBtn, video);
            }
          });
        }, { threshold: [0, 0.7] });

        this.cards.forEach(c => this._observer.observe(c));

        /* Initial dot state */
        requestAnimationFrame(() => this._onScroll());
      }

      /* --------- Helpers --------- */

      _scrollToCard(index) {
        const card = this.cards[index];
        if (!card) return;
        const trackRect = this.track.getBoundingClientRect();
        const cardRect  = card.getBoundingClientRect();
        const offset    = cardRect.left - trackRect.left + this.track.scrollLeft
                        - (trackRect.width / 2 - cardRect.width / 2);
        this.track.scrollTo({ left: offset, behavior: 'smooth' });
      }

      _onScroll() {
        if (!this.cards.length) return;
        const center = this.track.scrollLeft + this.track.clientWidth / 2;
        let closest = 0;
        let minDist = Infinity;
        this.cards.forEach((card, i) => {
          const cardCenter = card.offsetLeft + card.offsetWidth / 2;
          const dist = Math.abs(center - cardCenter);
          if (dist < minDist) { minDist = dist; closest = i; }
        });
        this.dots.forEach((dot, i) => {
          dot.classList.toggle('ag-dot-active', i === closest);
        });
      }

      _syncPlayIcon(btn, video) {
        if (!btn) return;
        const pauseIcon = btn.querySelector('[data-icon="pause"]');
        const playIcon  = btn.querySelector('[data-icon="play"]');
        if (pauseIcon) pauseIcon.style.display = video.paused ? 'none' : 'block';
        if (playIcon)  playIcon.style.display  = video.paused ? 'block' : 'none';
      }

      _syncMuteIcon(btn, video) {
        if (!btn) return;
        const mutedIcon   = btn.querySelector('[data-icon="muted"]');
        const unmutedIcon = btn.querySelector('[data-icon="unmuted"]');
        if (mutedIcon)   mutedIcon.style.display   = video.muted ? 'block' : 'none';
        if (unmutedIcon) unmutedIcon.style.display  = video.muted ? 'none' : 'block';
      }

      disconnectedCallback() {
        if (this.track)     this.track.removeEventListener('scroll', this._onScroll);
        if (this._observer) this._observer.disconnect();
      }
    }

    customElements.define('ag-testimonial-reels', AgTestimonialReels);
  }
</script>

