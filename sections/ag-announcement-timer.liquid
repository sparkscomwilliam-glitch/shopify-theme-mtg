      "unit": "px"
    },
    {
      "type": "range",
      "id": "font_size_value",
      "label": "Taille chiffres timer (px)",
      "min": 14,
      "max": 40,
      "step": 1,
      "default": 22,
      "unit": "px"
    },
    {
