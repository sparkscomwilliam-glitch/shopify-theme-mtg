{{ 'neon-editorial.css' | asset_url | stylesheet_tag }}
<script src="{{ 'neon-editorial.js' | asset_url }}" type="module" fetchpriority="low"></script>

{% liquid
  assign raw_article_content = article.content
  assign clean_article_content = raw_article_content
  assign embedded_lead = blank

  if raw_article_content contains '<style'
    assign clean_article_content = raw_article_content | split: '</style>' | last
  endif

  if clean_article_content contains '<p class="lead">'
    assign embedded_lead = clean_article_content | split: '<p class="lead">' | last | split: '</p>' | first
  endif

  if clean_article_content contains 'class="hero"'
    assign clean_article_content = clean_article_content | split: '</header>' | last
  endif

  assign clean_article_content = clean_article_content | replace: '<body>', '' | replace: '</body>', '' | replace: '<main class="wrap">', '' | replace: '</main>', ''

  assign article_words = clean_article_content | strip_html | split: ' ' | size
  assign reading_minutes = article_words | divided_by: 210 | plus: 1
%}

<article class="neon-article" data-neon-article>
  <div class="neon-article__progress" aria-hidden="true"></div>

  <header class="neon-article__hero">
    <div class="neon-editorial__shell">
      <a class="neon-editorial__back" href="{{ blog.url }}">← Retour au journal</a>
      <div class="neon-article__hero-grid">
        <div>
          <p class="neon-editorial__eyebrow">
            {% if article.tags.size > 0 %}{{ article.tags.first | escape }}{% else %}Journal TCG{% endif %}
          </p>
          <h1 class="neon-article__title">{{ article.title | escape }}</h1>
          {% if article.excerpt != blank %}
            <div class="neon-article__lead">{{ article.excerpt }}</div>
          {% elsif embedded_lead != blank %}
            <div class="neon-article__lead">{{ embedded_lead }}</div>
          {% endif %}
          <div class="neon-article__meta">
            <span>{{ article.published_at | date: '%d.%m.%Y' }}</span>
            {% if section.settings.show_author %}<span>{{ article.author | escape }}</span>{% endif %}
            <span>{{ reading_minutes }} min de lecture</span>
          </div>
        </div>

        {% if article.image and section.settings.show_featured_image %}
          <figure class="neon-article__visual">
            {{ article.image
              | image_url: width: 1600
              | image_tag:
                widths: '320, 480, 720, 960, 1200, 1600',
                sizes: '(max-width: 900px) calc(100vw - 48px), 32vw',
                loading: 'eager',
                fetchpriority: 'high',
                alt: article.image.alt
            }}
          </figure>
        {% endif %}
      </div>
    </div>
  </header>

  <div class="neon-editorial__shell neon-article__layout">
    <div class="neon-article__body rte" data-neon-article-body>
      {{ clean_article_content }}
    </div>

    {% if section.blocks.size > 0 %}
      <div class="neon-article__blocks">
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'callout' %}
              <aside class="neon-article-block" {{ block.shopify_attributes }}>
                {% if block.settings.label != blank %}<p class="neon-article-block__label">{{ block.settings.label | escape }}</p>{% endif %}
                {% if block.settings.heading != blank %}<h2>{{ block.settings.heading | escape }}</h2>{% endif %}
                {% if block.settings.text != blank %}<div class="neon-article-block__text">{{ block.settings.text }}</div>{% endif %}
              </aside>
            {% when 'image' %}
              {% if block.settings.image != blank %}
                <figure class="neon-article-block neon-article-block--image" {{ block.shopify_attributes }}>
                  {{ block.settings.image
                    | image_url: width: 1800
                    | image_tag: widths: '480, 720, 960, 1200, 1600, 1800', sizes: '(max-width: 800px) calc(100vw - 20px), 752px', loading: 'lazy'
                  }}
                  {% if block.settings.caption != blank %}<figcaption>{{ block.settings.caption | escape }}</figcaption>{% endif %}
                </figure>
              {% endif %}
            {% when 'cta' %}
              <aside class="neon-article-block neon-article-block--cta" {{ block.shopify_attributes }}>
                {% if block.settings.label != blank %}<p class="neon-article-block__label">{{ block.settings.label | escape }}</p>{% endif %}
                {% if block.settings.heading != blank %}<h2>{{ block.settings.heading | escape }}</h2>{% endif %}
                {% if block.settings.text != blank %}<div class="neon-article-block__text">{{ block.settings.text }}</div>{% endif %}
                {% if block.settings.button_label != blank and block.settings.button_url != blank %}
                  <a class="neon-article-block__button" href="{{ block.settings.button_url }}">{{ block.settings.button_label | escape }}</a>
                {% endif %}
              </aside>
          {% endcase %}
        {% endfor %}
      </div>
    {% endif %}
  </div>

  {% if section.settings.show_related %}
    <section class="neon-article__related">
      <div class="neon-editorial__shell">
        <div class="neon-article__related-head">
          <div>
            <p class="neon-editorial__eyebrow">Continuer la lecture</p>
            <h2>Autres notes du journal</h2>
          </div>
          <a class="neon-editorial__back" href="{{ blog.url }}">Voir tous les articles →</a>
        </div>
        <div class="neon-article__related-grid">
          {% assign related_count = 0 %}
          {% for related_article in blog.articles limit: 6 %}
            {% if related_article.id != article.id and related_count < 3 %}
              <a class="neon-related-card" href="{{ related_article.url }}">
                <span>{{ related_article.published_at | date: '%d.%m.%Y' }}</span>
                <h3>{{ related_article.title | escape }}</h3>
              </a>
              {% assign related_count = related_count | plus: 1 %}
            {% endif %}
          {% endfor %}
          {% if related_count == 0 %}
            <a class="neon-related-card" href="{{ blog.url }}">
              <span>Journal TCG</span>
              <h3>Retrouvez bientôt de nouvelles analyses de collection.</h3>
            </a>
          {% endif %}
        </div>
      </div>
    </section>
  {% endif %}

  {% if blog.comments_enabled? %}
    <section class="neon-article__related">
      <div class="neon-editorial__shell">
        {% render 'blog-comment-form', article: article, section_id: section.id %}
      </div>
    </section>
  {% endif %}
</article>

<script type="application/ld+json">
  {{ article | structured_data }}
</script>

{% schema %}
{
  "name": "Article Neon",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_featured_image",
      "label": "Afficher l’image principale",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Afficher l’auteur",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_related",
      "label": "Afficher les articles associés",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "callout",
      "name": "Encadré éditorial",
      "settings": [
        { "type": "text", "id": "label", "label": "Libellé", "default": "À retenir" },
        { "type": "text", "id": "heading", "label": "Titre", "default": "Le point essentiel" },
        { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Ajoutez ici une information importante liée à l’article.</p>" }
      ]
    },
    {
      "type": "image",
      "name": "Image éditoriale",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "caption", "label": "Légende" }
      ]
    },
    {
      "type": "cta",
      "name": "Appel à l’action",
      "settings": [
        { "type": "text", "id": "label", "label": "Libellé", "default": "Sélection TCG" },
        { "type": "text", "id": "heading", "label": "Titre", "default": "Découvrir les nouveautés" },
        { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Reliez l’article à une collection ou à un produit pertinent.</p>" },
        { "type": "text", "id": "button_label", "label": "Texte du bouton", "default": "Voir la collection" },
        { "type": "url", "id": "button_url", "label": "Lien du bouton" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Article Neon"
    }
  ]
}
{% endschema %}
