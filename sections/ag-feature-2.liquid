    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Bénéfice",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Bénéfice"
        },
        {
          "type": "html",
          "id": "icon_svg",
          "label": "SVG de l'icône",
