{% comment %} ag-adv-2-comparison.liquid — propriété de James Sparks {% endcomment %}
{% render 'ag-adv-2-schema-head' %}

{%- liquid
  assign s = section.settings
-%}

{%- capture root_style -%}
  {% if s.bg_color != blank %}background:{{ s.bg_color }};{% endif %}
  {% if s.accent_color != blank %}--ag2-coral:{{ s.accent_color }};{% endif %}
  {% if s.accent_deep != blank %}--ag2-coral-deep:{{ s.accent_deep }};{% endif %}
  {% if s.accent_wash != blank %}--ag2-coral-wash:{{ s.accent_wash }};{% endif %}
  {% if s.accent_tint != blank %}--ag2-coral-tint:{{ s.accent_tint }};{% endif %}
  {% if s.yes_color != blank %}--ag2-green:{{ s.yes_color }};{% endif %}
  {% if s.no_color != blank %}--ag2-red:{{ s.no_color }};{% endif %}
  {% if s.text_color != blank %}--ag2-ink:{{ s.text_color }};{% endif %}
  {% if s.muted_color != blank %}--ag2-gray:{{ s.muted_color }};{% endif %}
  {% if s.line_color != blank %}--ag2-line:{{ s.line_color }};{% endif %}
{%- endcapture -%}

{%- assign yes_mark = '<span class="ag-adv-2-cmp__yes">&#10003;</span>' -%}
{%- assign no_mark  = '<span class="ag-adv-2-cmp__no">&#10007;</span>' -%}

<div class="ag-adv-2 spacing-style" style="{% render 'spacing-style', settings: section.settings %}{{ root_style | strip_newlines }}">
  <div class="ag-adv-2__col-wide">
    {%- if s.kicker != blank or s.heading != blank -%}
      <div class="ag-adv-2__shead" style="margin-top:0;">
        {%- if s.kicker != blank -%}<span class="ag-adv-2__kicker">{{ s.kicker }}</span>{%- endif -%}
        {%- if s.heading != blank -%}<h2>{{ s.heading }}</h2>{%- endif -%}
      </div>
    {%- endif -%}
    <div class="ag-adv-2-cmp__wrap">
      <table class="ag-adv-2-cmp__table">
        <thead>
          <tr>
            <th>{{ s.col0_label | default: 'Critère' }}</th>
            <th class="ag-adv-2-cmp__prod">{{ s.col1_label | default: 'Lumira' }}</th>
            <th>{{ s.col2_label | default: 'Sérum luxe A' }}</th>
            <th>{{ s.col3_label | default: 'Crème pharma B' }}</th>
            <th>{{ s.col4_label | default: 'Marque virale C' }}</th>
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            {%- if block.type == 'row' -%}
              <tr {{ block.shopify_attributes }}>
                <td>{{ block.settings.criterion }}</td>
                {%- for i in (1..4) -%}
                  {%- assign val_id = 'col' | append: i | append: '_val' -%}
                  {%- assign text_id = 'col' | append: i | append: '_text' -%}
                  {%- assign val = block.settings[val_id] -%}
                  {%- assign text = block.settings[text_id] -%}
                  {%- assign cls = '' -%}
                  {%- if i == 1 -%}{%- assign cls = ' class="ag-adv-2-cmp__prod"' -%}{%- endif -%}
                  <td{{ cls }}>
                    {%- case val -%}
                      {%- when 'yes' -%}{{ yes_mark }}
                      {%- when 'no' -%}{{ no_mark }}
                      {%- when 'text' -%}{{ text }}
                    {%- endcase -%}
                  </td>
                {%- endfor -%}
              </tr>
            {%- endif -%}
          {%- endfor -%}
        </tbody>
      </table>
    </div>
  </div>
</div>

