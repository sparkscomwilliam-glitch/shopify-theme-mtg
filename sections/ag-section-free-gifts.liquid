{%- style -%}
  {{ section.settings.heading_font | font_face: font_display: 'swap' }}
  {{ section.settings.body_font | font_face: font_display: 'swap' }}

  .ag-fg-{{ section.id }} {
    --heading-font: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
    --body-font: {{ section.settings.body_font.family }}, {{ section.settings.body_font.fallback_families }};
    --primary-color: {{ section.settings.primary_color | default: '#256239' }};
    --badge-bg: {{ section.settings.badge_bg | default: '#ffd1d1' }};
    --bg-color: {{ section.settings.bg_color | default: '#ffffff' }};
    
    background-color: var(--bg-color);
    padding: clamp(100px, 15vh, 130px) 20px 60px 20px;
    display: flex;
    justify-content: center;
    overflow: hidden;
  }

  .ag-fg-{{ section.id }} * {
    box-sizing: border-box;
  }

  .ag-fg__container {
    width: 100%;
    max-width: 1200px;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  /* Mobile Header */
  .ag-fg__mobile-header {
    display: block;
    text-align: center;
  }

  .ag-fg__mobile-heading {
    font-family: var(--heading-font);
    font-size: var(--ag-fs-h2);
    line-height: 1.2;
    margin: 0;
    text-transform: capitalize;
  }

  /* Slider */
  .ag-fg__main-grid {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .ag-fg__slider-wrapper {
    width: 100%;
    position: relative;
    border-radius: 24px;
    overflow: hidden;
    background: #f4f4f4; /* Fallback for transparency/images */
    aspect-ratio: 1 / 1;
    display: flex;
    flex-direction: column;
  }

  .ag-fg__slider {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none; /* Hide scrollbar Firefox */
    width: 100%;
    height: 100%;
  }
  
  .ag-fg__slider::-webkit-scrollbar {
    display: none; /* Hide scrollbar Chrome/Safari */
  }

  .ag-fg__slide {
    flex: 0 0 100%;
    min-width: 100%;
    scroll-snap-align: center;
    position: relative;
    aspect-ratio: 1 / 1;
  }

  .ag-fg__slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: 24px;
  }

  .ag-fg__dots {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 8px;
    z-index: 10;
  }

  .ag-fg__dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.5);
    background-color: #ddd; /* If images are transparent, use dark/light contrast */
    transition: background-color 0.3s ease;
  }
  .ag-fg__dot.is-active {
    background-color: #000;
  }

  /* Content */
  .ag-fg__content {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .ag-fg__trust {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .ag-fg__stars {
    display: flex;
    gap: 2px;
    color: #000; /* Star color */
  }
  .ag-fg__stars svg { width: 14px; height: 14px; fill: currentColor; }
  
  .ag-fg__trust-text {
    font-family: var(--body-font);
    font-weight: 500;
    font-size: var(--ag-fs-small);
    color: #000;
    margin: 0;
  }

  .ag-fg__logo {
    max-width: 165px;
    height: auto;
  }
  .ag-fg__logo svg, .ag-fg__logo img {
    width: 100%;
    height: auto;
    display: block;
  }

  .ag-fg__title {
    font-family: var(--heading-font);
    font-size: var(--ag-fs-h2);
    line-height: 1.1;
    margin: 0;
    margin-bottom: 5px;
    font-weight: bold;
  }

  .ag-fg__subtitle {
    font-family: var(--body-font);
    font-weight: bold;
    color: var(--primary-color);
    font-size: var(--ag-fs-body);
    margin: 0;
    margin-bottom: 10px;
  }

  .ag-fg__gifts {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .ag-fg__gifts-header {
    display: flex;
    justify-content: space-between;
    font-family: var(--body-font);
    font-weight: 600;
    font-size: var(--ag-fs-small);
    color: #606060;
    margin-bottom: 10px;
  }

  .ag-fg__gift-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 0;
    border-bottom: 1px dashed #d1d5db;
  }

  .ag-fg__gift-info {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .ag-fg__gift-img-wrap {
    width: 35px;
    height: 35px;
    border-radius: 50%;
    border: 1px solid #3a7c50;
    overflow: hidden;
    position: relative;
    flex-shrink: 0;
  }
  .ag-fg__gift-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ag-fg__gift-img-wrap .overlay-icon {
    position: absolute;
    top: -4px;
    left: -4px;
    width: 16px;
    height: 16px;
  }

  .ag-fg__badge {
    background-color: var(--badge-bg);
    color: #000;
    font-family: var(--body-font);
    font-weight: 500;
    font-size: var(--ag-fs-small);
    padding: 2px 10px;
    border-radius: 3px;
    min-width: 53px;
    text-align: center;
  }

  .ag-fg__gift-name {
    font-family: var(--body-font);
    font-size: var(--ag-fs-small);
    color: #000;
    font-weight: 500;
    margin: 0;
  }

  .ag-fg__gift-price {
    font-family: var(--body-font);
    font-weight: 600;
    color: var(--primary-color);
    font-size: var(--ag-fs-small);
    text-decoration: line-through;
    margin: 0;
  }

  /* Total Block */
  .ag-fg__total-block {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 15px;
    margin-bottom: 15px;
    flex-wrap: wrap;
    gap: 10px;
  }

  .ag-fg__refill {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: var(--body-font);
    font-size: var(--ag-fs-eyebrow);
    color: #000;
    font-weight: 500;
  }
  .ag-fg__refill svg {
    width: 16px;
    height: 16px;
    fill: #256239;
  }

  .ag-fg__buy-today {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .ag-fg__today-badge {
    background-color: var(--badge-bg);
    color: #000;
    font-family: var(--body-font);
    font-weight: 500;
    font-size: var(--ag-fs-small);
    padding: 6px 17px;
    border-radius: 3px;
    text-align: center;
  }

  .ag-fg__total-price {
    font-family: var(--body-font);
    font-weight: bold;
    font-size: var(--ag-fs-small);
    color: var(--primary-color);
    text-decoration: line-through;
    opacity: 0.8;
  }

  /* CTA */
  .ag-fg__cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }

  .ag-fg__btn {
    width: 100%;
    background: {{ section.settings.cta_gradient }};
    border-radius: var(--ag-btn-radius-pill);
    height: var(--ag-btn-h);
    padding: 0 var(--ag-btn-px);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-family: var(--body-font);
    font-weight: bold;
    font-size: var(--ag-fs-cta);
    text-decoration: none;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  .ag-fg__btn:hover {
    transform: translateY(-2px);
    opacity: 0.95;
  }

  .ag-fg__guarantees {
    display: flex;
    gap: 16px;
    align-items: center;
    justify-content: center;
  }
  .ag-fg__guarantee-item {
    display: flex;
    align-items: center;
    gap: 4px;
    font-family: var(--body-font);
    font-weight: 500;
    color: #26633a;
    font-size: var(--ag-fs-eyebrow);
  }
  .ag-fg__guarantee-item svg { width: 14px; height: 14px; fill: currentColor; }

  /* Testimonial Box */
  .ag-fg__testimonial {
    background: #f7f7f7;
    border: 1px dashed #000;
    border-radius: 7px;
    padding: 12px 20px 23px 20px;
    box-shadow: 0px 4px 7.3px 0px rgba(0,0,0,0.25);
    display: flex;
    flex-direction: column;
    gap: 15px;
    margin-top: 15px;
  }

  .ag-fg__test-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  
  .ag-fg__test-user {
    display: flex;
    align-items: center;
    gap: 5px;
    font-family: var(--body-font);
    font-weight: 500;
    font-size: var(--ag-fs-small);
    color: var(--primary-color);
  }
  .ag-fg__test-stars { display: flex; color: #ff5f5f; } /* Light pink red for stars */
  .ag-fg__test-stars svg { width: 12px; height: 12px; fill: currentColor; }

  .ag-fg__test-verified {
    display: flex;
    align-items: center;
    gap: 5px;
    font-family: var(--body-font);
    font-weight: 500;
    font-size: var(--ag-fs-small);
    color: var(--primary-color);
  }
  .ag-fg__test-verified svg { width: 16px; height: 16px; fill: currentColor; }

  .ag-fg__test-body p {
    font-family: var(--body-font);
    font-size: var(--ag-fs-small);
    color: #000;
    margin: 0;
  }
  .ag-fg__test-body strong {
    font-weight: bold;
    display: block;
    margin-bottom: 2px;
  }

  /* Desktop layout overrides */
  @media (min-width: 900px) {
    .ag-fg-{{ section.id }} {
      padding: 100px 40px;
    }
    
    .ag-fg__main-grid {
      flex-direction: row;
      align-items: flex-start;
      gap: 50px;
    }
    
    .ag-fg__slider-wrapper {
      width: 50%;
      height: auto;
      position: sticky;
      top: 40px;
    }

    .ag-fg__content {
      width: 50%;
    }

    .ag-fg__mobile-header {
      display: none; 
    }
  }

{%- endstyle -%}

{%- liquid
  assign sum_gifts = 0
  for block in section.blocks
    if block.type == 'free_gift' and block.settings.product != blank
      assign sum_gifts = sum_gifts | plus: block.settings.product.price
    endif
  endfor
  assign m_price_cents = section.settings.main_price | times: 100
  assign total_strikethrough = sum_gifts | plus: m_price_cents
-%}

<div class="ag-fg-{{ section.id }}">
  <div class="ag-fg__container">
    
    {%- if section.settings.mobile_heading != blank -%}
      <div class="ag-fg__mobile-header">
        <h2 class="ag-fg__mobile-heading">{{ section.settings.mobile_heading }}</h2>
      </div>
    {%- endif -%}

    <div class="ag-fg__main-grid">
      
      <!-- Slider -->
      <div class="ag-fg__slider-wrapper">
        <div class="ag-fg__slider" id="ag-slider-{{ section.id }}">
          {%- assign image_count = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'slider_image' -%}
              {%- assign image_count = image_count | plus: 1 -%}
              <div class="ag-fg__slide" {{ block.shopify_attributes }}>
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy' }}
                {%- else -%}
                  <div style="width:100%;height:100%;background:#e5e7eb;display:flex;align-items:center;justify-content:center;color:#9ca3af;">Image placeholder</div>
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
        
        {%- if image_count > 1 -%}
          <div class="ag-fg__dots" id="ag-dots-{{ section.id }}">
            {%- for i in (1..image_count) -%}
              <div class="ag-fg__dot {% if forloop.first %}is-active{% endif %}" data-index="{{ forloop.index0 }}"></div>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <!-- Content -->
      <div class="ag-fg__content">
        
        {%- if section.settings.trust_text != blank -%}
          <div class="ag-fg__trust">
            <div class="ag-fg__stars">
              {%- for i in (1..5) -%}
                <svg viewBox="0 0 24 24"><path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"></path></svg>
              {%- endfor -%}
            </div>
            <p class="ag-fg__trust-text">{{ section.settings.trust_text }}</p>
          </div>
        {%- endif -%}

        {%- if section.settings.logo_svg != blank -%}
          <div class="ag-fg__logo">
            {{ section.settings.logo_svg }}
          </div>
        {%- endif -%}

        <div>
          {%- if section.settings.main_title != blank -%}
            <h2 class="ag-fg__title">
              {{ section.settings.main_title }}
            </h2>
          {%- endif -%}
          {%- if section.settings.main_subtitle != blank -%}
            <p class="ag-fg__subtitle">{{ section.settings.main_subtitle }}</p>
          {%- endif -%}
        </div>

        <!-- Gifts List -->
        <div class="ag-fg__gifts">
          <div class="ag-fg__gifts-header">
            <span>FREE GIFTS</span>
            <span>Value</span>
          </div>

          {%- for block in section.blocks -%}
            {%- if block.type == 'free_gift' -%}
              <div class="ag-fg__gift-row" {{ block.shopify_attributes }}>
                <div class="ag-fg__gift-info">
                  <div class="ag-fg__gift-img-wrap">
                    {%- if block.settings.product != blank and block.settings.product.featured_image != blank -%}
                      {{ block.settings.product.featured_image | image_url: width: 100 | image_tag: loading: 'lazy' }}
                    {%- else -%}
                      <div style="width:100%;height:100%;background:#d1d5db;"></div>
                    {%- endif -%}
                    <!-- Little gift box icon over image -->
                    <svg class="overlay-icon" viewBox="0 0 24 24" fill="none" stroke="#256239" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="fill:#256239;stroke:#fff;"><polyline points="20 12 20 22 4 22 4 12"></polyline><rect x="2" y="7" width="20" height="5"></rect><line x1="12" y1="22" x2="12" y2="7"></line><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"></path><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"></path></svg>
                  </div>
                  <div class="ag-fg__badge">Free</div>
                  <p class="ag-fg__gift-name">
                    {%- if block.settings.custom_title != blank -%}
                      {{ block.settings.custom_title }}
                    {%- elsif block.settings.product != blank -%}
                      {{ block.settings.product.title }}
                    {%- else -%}
                      Gift Item
                    {%- endif -%}
                  </p>
                </div>
                <p class="ag-fg__gift-price">
                  {%- if block.settings.product != blank -%}
                    {{ block.settings.product.price | money }}
                  {%- else -%}
                    $0.00
                  {%- endif -%}
                </p>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>

        <!-- Total Block -->
        <div class="ag-fg__total-block">
          <div class="ag-fg__refill">
            <svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
            REFILL SHIPS EVERY 30 DAYS
          </div>
          <div class="ag-fg__buy-today">
            <div class="ag-fg__today-badge">TRY IT TODAY FOR {{ section.settings.main_price | times: 100 | money_without_trailing_zeros }}</div>
            <p class="ag-fg__total-price">{{ total_strikethrough | money }}</p>
          </div>
        </div>

        <!-- CTA Action -->
        <div class="ag-fg__cta">
          <a href="{{ section.settings.cta_link | default: '#' }}" class="ag-fg__btn">{{ section.settings.cta_text }}</a>
          <div class="ag-fg__guarantees">
            <div class="ag-fg__guarantee-item">
              <svg viewBox="0 0 24 24"><path d="M19 8h-2V5c0-1.1-.9-2-2-2H3C1.9 2 1 2.9 1 4v10c0 1.1.9 2 2 2h2c0 1.66 1.34 3 3 3s3-1.34 3-3h6c0 1.66 1.34 3 3 3s3-1.34 3-3h2v-5l-4-3zm-11 5H3V5h12v8H8zm8.5-1l-2.5-2H17v2h1.5zM8 17c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1zm12 0c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1z"/></svg>
              FAST DELIVERY
            </div>
            <div class="ag-fg__guarantee-item">
              <svg viewBox="0 0 24 24"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z"/></svg>
              RISK FREE 30 DAYS
            </div>
          </div>
        </div>

        <!-- Testimonial -->
        <div class="ag-fg__testimonial">
          <div class="ag-fg__test-top">
            <div class="ag-fg__test-user">
              <div class="ag-fg__test-stars">
                {%- for i in (1..5) -%}
                  <svg viewBox="0 0 24 24"><path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"></path></svg>
                {%- endfor -%}
              </div>
              {{ section.settings.test_name }}
            </div>
            <div class="ag-fg__test-verified">
              <svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
              {{ section.settings.test_title }}
            </div>
          </div>
          <div class="ag-fg__test-body">
            <p>
              <strong>{{ section.settings.test_heading }}</strong>
              {{ section.settings.test_desc }}
            </p>
          </div>
        </div>

      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const slider = document.getElementById('ag-slider-{{ section.id }}');
    const dotsContainer = document.getElementById('ag-dots-{{ section.id }}');
    if (!slider || !dotsContainer) return;

    const dots = dotsContainer.querySelectorAll('.ag-fg__dot');
    
    // Update active dot on scroll
    slider.addEventListener('scroll', function() {
      const scrollLeft = slider.scrollLeft;
      const width = slider.clientWidth;
      const activeIndex = Math.round(scrollLeft / width);
      
      dots.forEach((dot, index) => {
        if (index === activeIndex) {
          dot.classList.add('is-active');
        } else {
          dot.classList.remove('is-active');
        }
      });
    });

    // Handle dot clicks
    dots.forEach((dot, index) => {
      dot.addEventListener('click', () => {
        const width = slider.clientWidth;
        slider.scrollTo({
          left: width * index,
          behavior: 'smooth'
        });
      });
    });

    // Autoplay Logic
    {% if section.settings.slider_autoplay %}
      const autoplaySpeed = {{ section.settings.slider_speed | default: 5 }} * 1000;
      let autoplayInterval;

      function startAutoplay() {
        if (dots.length <= 1) return;
        autoplayInterval = setInterval(() => {
          const scrollLeft = slider.scrollLeft;
          const width = slider.clientWidth;
          let nextIndex = Math.round(scrollLeft / width) + 1;
          
          if (nextIndex >= dots.length) {
            nextIndex = 0;
          }
          
          slider.scrollTo({
            left: width * nextIndex,
            behavior: 'smooth'
          });
        }, autoplaySpeed);
      }

      function stopAutoplay() {
        clearInterval(autoplayInterval);
      }

      startAutoplay();

      // Pause on hover/touch
      slider.addEventListener('mouseenter', stopAutoplay);
      slider.addEventListener('mouseleave', startAutoplay);
      slider.addEventListener('touchstart', stopAutoplay, { passive: true });
      slider.addEventListener('touchend', startAutoplay);
    {% endif %}
  });
</script>

{% schema %}
{
  "name": "AG Free Gifts",
  "tag": "section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "primary_color",
      "label": "Primary Focus Color",
      "default": "#256239",
      "info": "Used for dark green texts"
    },
    {
      "type": "color",
      "id": "badge_bg",
      "label": "Badge Background Color",
      "default": "#ffd1d1"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading Font",
      "default": "sans-serif"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Body Font",
      "default": "sans-serif"
    },
    {
      "type": "header",
      "content": "Slider Settings"
    },
    {
      "type": "checkbox",
      "id": "slider_autoplay",
      "label": "Enable Auto-play",
      "default": true
    },
    {
      "type": "range",
      "id": "slider_speed",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "sec",
      "label": "Auto-play Speed",
      "default": 4
    },
    {
      "type": "header",
      "content": "Labels & Headings"
    },
    {
      "type": "text",
      "id": "mobile_heading",
      "label": "Mobile Top Heading",
      "default": "Try The Crazy Match Pack And Get Free Gifts"
    },
    {
      "type": "text",
      "id": "trust_text",
      "label": "Trust Text",
      "default": "Excellent | Trusted by 100’000+ adopters"
    },
    {
      "type": "html",
      "id": "logo_svg",
      "label": "Brand Logo SVG",
      "info": "Paste raw SVG code here"
    },
    {
