{% comment %} ag-adv-testimonials.liquid — propriété de James Sparks {% endcomment %}
{% render 'ag-adv-schema-head' %}

{%- capture ag_vars -%}
  {%- if section.settings.ag_bg != blank -%}--ag-section-bg:{{ section.settings.ag_bg }};{%- endif -%}
  {%- if section.settings.ag_radius and section.settings.ag_radius > 0 -%}--ag-section-radius:{{ section.settings.ag_radius }}px;{%- endif -%}
  {%- if section.settings.ag_accent != blank -%}--ag-section-accent:{{ section.settings.ag_accent }};{%- endif -%}
  {%- if section.settings.ag_accent_soft != blank -%}--ag-section-accent-soft:{{ section.settings.ag_accent_soft }};{%- endif -%}
{%- endcapture -%}
{%- capture ag_root_style -%}{% if section.settings.ag_bg != blank %}background:{{ section.settings.ag_bg }};{% endif %}{{ ag_vars }}{%- endcapture -%}


{%- liquid
  assign show_agg     = section.settings.show_aggregate
  assign rating       = section.settings.overall_rating
  assign reviews_n    = section.settings.reviews_count
  assign rating_floor = rating | floor
  assign rating_dec   = rating | minus: rating_floor
-%}

<div class="ag-adv spacing-style" style="{% render 'spacing-style', settings: section.settings %}{{ ag_root_style }}">
  <div class="ag-adv__wrap">
    <section class="ag-adv-testimonials">

      <div class="ag-adv-thread-h">
        {%- if section.settings.eyebrow != blank -%}
          <span class="ag-adv-thread-h__tag">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2>{{ section.settings.title }}</h2>
        {%- endif -%}
        {%- if section.settings.subtitle != blank -%}
          <p>{{ section.settings.subtitle }}</p>
        {%- endif -%}
      </div>

      <div class="ag-adv-thread">
        {%- for block in section.blocks -%}
          {%- if block.type == 'review' -%}
            {%- assign r = block.settings.rating | default: 5 -%}
            {%- assign r_floor = r | floor -%}
            <article class="ag-adv-post" {{ block.shopify_attributes }}>
              <header class="ag-adv-post__ph">
                <span class="ag-adv-post__av">
                  {%- if block.settings.photo != blank -%}
                    <img src="{{ block.settings.photo | image_url: width: 92 }}" alt="{{ block.settings.name | escape }}" loading="lazy">
                  {%- else -%}
                    {{ 'image' | placeholder_svg_tag }}
                  {%- endif -%}
                </span>
                <div>
                  <div class="ag-adv-post__nm">{{ block.settings.name }}{%- if block.settings.verified -%} <span class="ag-adv-post__vf">✓</span>{%- endif -%}</div>
                  <div class="ag-adv-post__hd">{{ block.settings.meta }}</div>
                </div>
                <div class="ag-adv-post__st ag-adv__stars">
                  {%- for i in (1..5) -%}
                    {%- if i <= r_floor -%}★{%- else -%}☆{%- endif -%}
                  {%- endfor -%}
                </div>
              </header>

              {%- if block.settings.title != blank -%}
                <p class="ag-adv-post__tx"><b>{{ block.settings.title }}</b></p>
              {%- endif -%}
              {%- if block.settings.content != blank -%}
                <div class="ag-adv-post__tx">{{ block.settings.content }}</div>
              {%- endif -%}

              {%- if block.settings.attached != blank -%}
                <div class="ag-adv-post__att">
                  <img src="{{ block.settings.attached | image_url: width: 800 }}" alt="" loading="lazy">
                </div>
              {%- endif -%}

              <footer class="ag-adv-post__ft">
                <span>♡ {{ block.settings.likes | default: '0' }}</span>
                <span>↺ {{ block.settings.shares | default: '0' }}</span>
                <span>↩ Reply</span>
              </footer>
            </article>
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- if show_agg -%}
        <div class="ag-adv-agg">
          <div class="ag-adv-agg__score">
            <div class="ag-adv-agg__b">{{ rating }}</div>
            <div class="ag-adv-agg__sts ag-adv__stars">
              {%- for i in (1..5) -%}
                {%- if i <= rating_floor -%}★{%- else -%}☆{%- endif -%}
              {%- endfor -%}
            </div>
            <small class="ag-adv-agg__sub">{{ reviews_n }} verified reviews</small>
          </div>
          <div class="ag-adv-dist">
            <div class="ag-adv-dist__r"><span>5★</span><span class="ag-adv-dist__bar"><i style="width:{{ section.settings.dist_5 }}%"></i></span><span>{{ section.settings.dist_5 }}%</span></div>
            <div class="ag-adv-dist__r"><span>4★</span><span class="ag-adv-dist__bar"><i style="width:{{ section.settings.dist_4 }}%"></i></span><span>{{ section.settings.dist_4 }}%</span></div>
            <div class="ag-adv-dist__r"><span>3★</span><span class="ag-adv-dist__bar"><i style="width:{{ section.settings.dist_3 }}%"></i></span><span>{{ section.settings.dist_3 }}%</span></div>
            <div class="ag-adv-dist__r"><span>2★</span><span class="ag-adv-dist__bar"><i style="width:{{ section.settings.dist_2 }}%"></i></span><span>{{ section.settings.dist_2 }}%</span></div>
            <div class="ag-adv-dist__r"><span>1★</span><span class="ag-adv-dist__bar"><i style="width:{{ section.settings.dist_1 }}%"></i></span><span>{{ section.settings.dist_1 }}%</span></div>
          </div>
        </div>
      {%- endif -%}

    </section>
  </div>
</div>

{% schema %}
{
