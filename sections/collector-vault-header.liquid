{% comment %}Navigation Collector Vault — desktop and mobile{% endcomment %}
{{ 'collector-vault-header.css' | asset_url | stylesheet_tag }}
<script src="{{ 'collector-vault-header.js' | asset_url }}" defer></script>

{%- liquid
  assign current_path = request.path | split: '?' | first | split: '#' | first
  assign current_path_last_character = current_path | slice: -1, 1
  if current_path != '/' and current_path_last_character == '/'
    assign current_path_length = current_path.size | minus: 1
    assign current_path = current_path | slice: 0, current_path_length
  endif
  assign active_catalog_link_found = false
  assign blog_label = section.settings.blog_label | default: 'Journal'
  assign blog_url = section.settings.blog_link | default: '/blogs/news' | split: '?' | first | split: '#' | first
  assign blog_url_last_character = blog_url | slice: -1, 1
  if blog_url != '/' and blog_url_last_character == '/'
    assign blog_url_length = blog_url.size | minus: 1
    assign blog_url = blog_url | slice: 0, blog_url_length
  endif
  assign navigation_has_active_link = false
  if current_path == blog_url or current_path contains '/blogs/'
    assign navigation_has_active_link = true
  else
    for navigation_block in section.blocks
      if navigation_block.type == 'catalog_link'
        assign navigation_block_url = navigation_block.settings.link | default: routes.all_products_collection_url | split: '?' | first | split: '#' | first
        assign navigation_block_url_last_character = navigation_block_url | slice: -1, 1
        if navigation_block_url != '/' and navigation_block_url_last_character == '/'
          assign navigation_block_url_length = navigation_block_url.size | minus: 1
          assign navigation_block_url = navigation_block_url | slice: 0, navigation_block_url_length
        endif
        if current_path == navigation_block_url
          assign navigation_has_active_link = true
          break
        endif
      endif
    endfor
  endif
-%}

<header
  class="cv-header"
  data-cv-header
  data-section-id="{{ section.id }}"
  aria-label="Navigation principale"
>
  <div class="cv-header__announcement">
    <p>{{ section.settings.announcement_left }}</p>
    <p class="cv-header__announcement-center">{{ section.settings.announcement_center }}</p>
    <p class="cv-header__announcement-right">{{ section.settings.announcement_right }}</p>
  </div>

  <div class="cv-header__main">
    <a class="cv-header__brand" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }} — accueil">
      <span class="cv-header__brand-name">{{ section.settings.brand_name }}</span>
      <span class="cv-header__brand-kicker">{{ section.settings.brand_kicker }}</span>
    </a>

    <form class="cv-header__search cv-header__search--desktop" action="{{ routes.search_url }}" method="get" role="search">
      <svg aria-hidden="true" viewBox="0 0 24 24" fill="none">
        <circle cx="10.8" cy="10.8" r="6.8" stroke="currentColor" stroke-width="1.8"/>
        <path d="m16 16 4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
      </svg>
      <label class="visually-hidden" for="CvHeaderSearch-{{ section.id }}">Rechercher dans le catalogue</label>
      <input
        id="CvHeaderSearch-{{ section.id }}"
        type="search"
        name="q"
        placeholder="{{ section.settings.search_placeholder | escape }}"
        autocomplete="off"
      >
      <input type="hidden" name="type" value="product">
    </form>

    <div class="cv-header__actions">
      <button
        class="cv-header__menu-toggle"
        type="button"
        data-cv-menu-open
        aria-controls="CvHeaderDrawer-{{ section.id }}"
        aria-expanded="false"
        aria-label="Ouvrir le menu"
      >
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </button>

      {% if shop.customer_accounts_enabled %}
        <a class="cv-header__action cv-header__action--account" href="{{ routes.account_url }}">{{ section.settings.account_label }}</a>
      {% endif %}

      {% if section.settings.wishlist_label != blank and section.settings.wishlist_link != blank %}
        <a class="cv-header__action cv-header__action--wishlist" href="{{ section.settings.wishlist_link }}">
          {{ section.settings.wishlist_label }}
        </a>
      {% endif %}

      <button
        type="button"
        class="cv-header__theme-toggle tcg-theme-toggle"
        data-tcg-theme-toggle
        aria-label="Changer le thème de couleur"
        aria-pressed="false"
      >
        <span class="tcg-theme-toggle__moon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none"><path d="M20.2 15.3A8.7 8.7 0 0 1 8.7 3.8 8.8 8.8 0 1 0 20.2 15.3Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
        <span class="tcg-theme-toggle__sun" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="3.6" stroke="currentColor" stroke-width="1.8"/><path d="M12 2v2.1M12 19.9V22M4.9 4.9l1.5 1.5M17.6 17.6l1.5 1.5M2 12h2.1M19.9 12H22M4.9 19.1l1.5-1.5M17.6 6.4l1.5-1.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
        </span>
      </button>

      <a class="cv-header__cart cv-header__cart--desktop" href="{{ routes.cart_url }}" aria-label="Panier, {{ cart.item_count }} article{% if cart.item_count != 1 %}s{% endif %}">
        <span>Panier</span>
        <span aria-hidden="true">·</span>
        <strong data-cv-cart-count>{{ cart.item_count }}</strong>
      </a>

      <button
        class="cv-header__cart-button"
        type="button"
        data-neon-cart-open
        aria-controls="NeonCartDrawer"
        aria-label="Ouvrir le panier, {{ cart.item_count }} article{% if cart.item_count != 1 %}s{% endif %}"
      >
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none">
          <path d="M3.5 4.5h2.1l1.6 9.1a2 2 0 0 0 2 1.7h7.6a2 2 0 0 0 1.9-1.5l1.5-6.2H6.1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          <circle cx="9.2" cy="19" r="1.3" fill="currentColor"/>
          <circle cx="17.2" cy="19" r="1.3" fill="currentColor"/>
        </svg>
        <span
          class="cv-header__cart-badge"
          data-cv-cart-badge
          {% if cart.item_count == 0 %}hidden{% endif %}
        >{{ cart.item_count }}</span>
      </button>
    </div>
  </div>

  <div
    id="CvHeaderDrawer-{{ section.id }}"
    class="cv-header__drawer"
    data-cv-menu-drawer
    aria-hidden="true"
    inert
  >
    <button class="cv-header__drawer-backdrop" type="button" data-cv-menu-close aria-label="Fermer le menu"></button>
    <aside class="cv-header__drawer-panel" aria-label="Menu mobile">
      <div class="cv-header__drawer-head">
        <a class="cv-header__brand" href="{{ routes.root_url }}">
          <span class="cv-header__brand-name">{{ section.settings.brand_name }}</span>
          <span class="cv-header__brand-kicker">{{ section.settings.brand_kicker }}</span>
        </a>
        <button class="cv-header__drawer-close" type="button" data-cv-menu-close aria-label="Fermer le menu">
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none"><path d="M5 5l14 14M19 5 5 19" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
        </button>
      </div>

      <nav class="cv-header__drawer-nav" aria-label="Catalogue mobile">
        {% for block in section.blocks %}
          {% if block.type == 'catalog_link' and block.settings.label != blank %}
            {%- liquid
              assign drawer_link_url = block.settings.link | default: routes.all_products_collection_url | split: '?' | first | split: '#' | first
              assign drawer_link_url_last_character = drawer_link_url | slice: -1, 1
              if drawer_link_url != '/' and drawer_link_url_last_character == '/'
                assign drawer_link_url_length = drawer_link_url.size | minus: 1
                assign drawer_link_url = drawer_link_url | slice: 0, drawer_link_url_length
              endif
              assign drawer_link_is_active = false
              if active_catalog_link_found == false and current_path == drawer_link_url
                assign drawer_link_is_active = true
                assign active_catalog_link_found = true
              endif
            -%}
            <a
              class="cv-header__drawer-link{% if drawer_link_is_active %} is-active{% endif %}{% if navigation_has_active_link == false and block.settings.highlight %} cv-header__drawer-link--featured{% endif %}"
              href="{{ drawer_link_url }}"
              {% if drawer_link_is_active %}aria-current="page"{% endif %}
            >
              <span>{{ block.settings.label }}</span>
              <span aria-hidden="true">↗</span>
            </a>
          {% endif %}
        {% endfor %}
        {%- assign drawer_blog_is_active = false -%}
        {%- if current_path == blog_url or current_path contains '/blogs/' -%}
          {%- assign drawer_blog_is_active = true -%}
        {%- endif -%}
        <a
          class="cv-header__drawer-link{% if drawer_blog_is_active %} is-active{% endif %}"
          href="{{ blog_url }}"
          {% if drawer_blog_is_active %}aria-current="page"{% endif %}
        >
          <span>{{ blog_label }}</span>
          <span aria-hidden="true">↗</span>
        </a>
      </nav>

      <div class="cv-header__drawer-meta">
        {% if shop.customer_accounts_enabled %}
          <a href="{{ routes.account_url }}">{{ section.settings.account_label }}</a>
        {% endif %}
        {% if section.settings.wishlist_label != blank and section.settings.wishlist_link != blank %}
          <a href="{{ section.settings.wishlist_link }}">{{ section.settings.wishlist_label }}</a>
        {% endif %}
      </div>
    </aside>
  </div>

  <nav class="cv-header__catalog" data-cv-catalog-nav aria-label="Catalogue" aria-hidden="false">
    <div class="cv-header__catalog-track">
      {%- assign active_catalog_link_found = false -%}
      {% for block in section.blocks %}
        {% if block.type == 'catalog_link' and block.settings.label != blank %}
          {%- liquid
            assign catalog_link_url = block.settings.link | default: routes.all_products_collection_url | split: '?' | first | split: '#' | first
            assign catalog_link_url_last_character = catalog_link_url | slice: -1, 1
            if catalog_link_url != '/' and catalog_link_url_last_character == '/'
              assign catalog_link_url_length = catalog_link_url.size | minus: 1
              assign catalog_link_url = catalog_link_url | slice: 0, catalog_link_url_length
            endif
            assign catalog_link_is_active = false
            if active_catalog_link_found == false and current_path == catalog_link_url
              assign catalog_link_is_active = true
              assign active_catalog_link_found = true
            endif
          -%}
          <a
            class="cv-header__catalog-link{% if catalog_link_is_active %} is-active{% endif %}{% if navigation_has_active_link == false and block.settings.highlight %} cv-header__catalog-link--featured{% endif %}"
            href="{{ catalog_link_url }}"
            {% if catalog_link_is_active %}aria-current="page"{% endif %}
            {{ block.shopify_attributes }}
          >
            <span>{{ block.settings.label }}</span>
            {% if block.settings.chevron %}<span class="cv-header__chevron" aria-hidden="true">⌄</span>{% endif %}
          </a>
        {% endif %}
      {% endfor %}

      {%- assign catalog_blog_is_active = false -%}
      {%- if current_path == blog_url or current_path contains '/blogs/' -%}
        {%- assign catalog_blog_is_active = true -%}
      {%- endif -%}
      <a
        class="cv-header__catalog-link{% if catalog_blog_is_active %} is-active{% endif %}"
        href="{{ blog_url }}"
        {% if catalog_blog_is_active %}aria-current="page"{% endif %}
      >
        <span>{{ blog_label }}</span>
      </a>

    </div>
  </nav>
</header>

{% schema %}
{
  "name": "Collector Vault header",
  "tag": "section",
  "class": "cv-header-section",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "text",
      "id": "announcement_left",
      "label": "Annonce gauche / mobile",
      "default": "LIVRAISON SUISSE 24–48H"
    },
    {
      "type": "text",
      "id": "announcement_center",
      "label": "Annonce centrale",
      "default": "PIÈCES CERTIFIÉES · PROVENANCE DOCUMENTÉE"
    },
    {
      "type": "text",
      "id": "announcement_right",
      "label": "Annonce droite",
      "default": "RETOURS SIMPLES SOUS 14 JOURS"
    },
    {
      "type": "text",
      "id": "brand_name",
      "label": "Nom de marque",
      "default": "NEON//SPECIMEN"
    },
    {
      "type": "text",
      "id": "brand_kicker",
      "label": "Signature",
      "default": "TCG MARKETPLACE"
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Texte de recherche",
      "default": "Rechercher cartes, displays, accessoires…"
    },
    {
      "type": "text",
      "id": "account_label",
      "label": "Libellé du compte",
      "default": "Compte"
    },
    {
      "type": "text",
      "id": "wishlist_label",
      "label": "Libellé des favoris",
      "default": "Favoris"
    },
    {
      "type": "url",
      "id": "wishlist_link",
      "label": "Lien des favoris"
    },
    {
      "type": "text",
      "id": "blog_label",
      "label": "Libellé du blog",
      "default": "Journal"
    },
    {
      "type": "url",
      "id": "blog_link",
      "label": "Lien du blog",
      "info": "Par défaut : /blogs/news"
    }
  ],
  "blocks": [
    {
      "type": "catalog_link",
      "name": "Lien catalogue",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Libellé",
          "default": "Collection"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Lien"
        },
        {
          "type": "checkbox",
          "id": "highlight",
          "label": "Mettre en évidence",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "chevron",
          "label": "Afficher le chevron",
          "default": false
        }
      ]
    }
  ]
}
{% endschema %}
