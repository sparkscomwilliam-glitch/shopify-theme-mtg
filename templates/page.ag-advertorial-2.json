    "ag2_reasons": {
      "type": "ag-adv-2-reasons",
      "blocks": {
        "r1": { "type": "reason", "settings": { "number": "01", "title": "Il répare la barrière, il ne la masque pas", "image_placeholder": "Illustration — gros plan texture de peau / actif", "body": "<p>La plupart des crèmes posent un film hydratant qui s'évapore en quelques heures. Lumira apporte les céramides identiques à ceux de la peau, qui s'intègrent réellement à la barrière cutanée.</p><p>Résultat : dès la deuxième semaine, cette sensation de tiraillement vers 16 h avait complètement disparu.</p>", "stat_big": "+38 %", "stat_label": "hydratation mesurée à J14" } },
        "r2": { "type": "reason", "settings": { "number": "02", "title": "Une concentration que peu de marques osent", "image_placeholder": "Illustration — pipette / concentration d'actifs", "body": "<p>Le complexe de 5 peptides est dosé à un niveau clinique. C'est coûteux à produire, et c'est précisément pour ça que les grandes marques le diluent.</p><p>Ici, pas de marketing à financer : l'argent va dans le flacon, pas dans la publicité.</p>", "stat_big": "5", "stat_label": "peptides actifs par dose" } },
        "r3": { "type": "reason", "settings": { "number": "03", "title": "Les ridules se repulpent de l'intérieur", "image_placeholder": "Illustration — femme appliquant le sérum, le matin", "body": "<p>En relançant la production de collagène, la peau se repulpe naturellement. Pas d'effet « tiré », pas de fini plâtreux sous le fond de teint.</p><p>Au bout d'un mois, j'ai arrêté d'utiliser mon correcteur sous les yeux. Pour la première fois depuis des années.</p>", "stat_big": "9 sur 10", "stat_label": "ont vu leurs ridules atténuées*" } },
        "r4": { "type": "reason", "settings": { "number": "04", "title": "Il remplace 4 produits par un seul", "image_placeholder": "Illustration — calendrier / routine simplifiée", "body": "<p>J'ai rangé mon sérum, mon contour des yeux, mon « booster » et ma crème de nuit. Une seule étape, matin et soir.</p><p>Ma routine est passée de 11 minutes à 2. Et ma peau ne s'est jamais aussi bien portée.</p>", "stat_big": "2 min", "stat_label": "de routine, matin & soir" } },
        "r5": { "type": "reason", "settings": { "number": "05", "title": "Il m'a fait économiser des centaines d'euros", "image_placeholder": "Illustration — porte-monnaie / comparatif de prix", "body": "<p>Quand j'ai additionné ce que je dépensais chaque mois en produits qui ne marchaient pas, le calcul m'a fait mal. Lumira coûte une fraction de ce total.</p><p>Le vrai luxe, finalement, ce n'était pas le prix. C'était d'arrêter de chercher.</p>", "stat_big": "−70 %", "stat_label": "vs mon ancienne routine" } }
      },
