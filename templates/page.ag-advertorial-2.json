    "ag2_faq": {
      "type": "ag-adv-2-faq",
      "blocks": {
        "q1": { "type": "faq_item", "settings": { "open": true, "question": "Au bout de combien de temps voit-on des résultats ?", "answer": "<p>La plupart des utilisatrices remarquent une peau plus souple et moins de tiraillement dès la première semaine. Les ridules et la fermeté évoluent surtout entre la 4ᵉ et la 8ᵉ semaine, le temps que la barrière cutanée se reconstruise.</p>" } },
        "q2": { "type": "faq_item", "settings": { "question": "Est-ce adapté aux peaux sensibles ?", "answer": "<p>Oui. La formule est sans parfum, sans alcool et sans huiles essentielles, et elle est testée sous contrôle dermatologique. Si vous avez une peau très réactive, faites un test dans le pli du coude pendant 24 h.</p>" } },
        "q3": { "type": "faq_item", "settings": { "question": "Comment l'intégrer à ma routine ?", "answer": "<p>Appliquez 3 à 4 gouttes sur peau propre, matin et soir, avant votre crème solaire le jour. Lumira remplace généralement sérum, contour des yeux et crème de nuit.</p>" } },
        "q4": { "type": "faq_item", "settings": { "question": "Puis-je l'utiliser avec du rétinol ou de la vitamine C ?", "answer": "<p>Tout à fait. Lumira renforce la barrière cutanée, ce qui aide même la peau à mieux tolérer les actifs puissants.</p>" } },
        "q5": { "type": "faq_item", "settings": { "question": "Que se passe-t-il si ça ne fonctionne pas pour moi ?", "answer": "<p>Vous êtes couverte par notre garantie 60 jours. Si vous n'êtes pas convaincue, contactez notre service client pour un remboursement intégral.</p>" } },
